@page "/schedules/{id}/availability"
@using EscalaFacil.Components.Models
@using EscalaFacil.Components.Services
@inject IDataStore Data
@inject NavigationManager Nav

<main class="page-root">
    <h1 class="page-title">DISPONIBILIDADE</h1>

    @if (loading)
    {
        <p class="muted center">Carregando…</p>
    }
    else if (schedule is null || team is null)
    {
        <p class="muted center">Escala não encontrada.</p>
    }
    else
    {
        <section class="form-wrap">
            <div class="section">
                <div class="meta">
                    <div><strong>Equipe:</strong> @team.Name</div>
                    <div><strong>Escala:</strong> @schedule.Name</div>
                    <div><strong>Turnos:</strong> @schedule.Shifts.Count</div>
                </div>
            </div>

            <div class="section">
                <h2 class="section-title">Marque quem pode em cada turno</h2>

                <div class="grid-scroll">
                    <table class="grid-table">
                        <thead>
                            <tr>
                                <th class="sticky-col">Membro</th>
                                @foreach (var sh in orderedShifts)
                                {
                                    <th title="@Tooltip(sh)">
                                        <div class="th-wrap">
                                            <div>@sh.Start.ToString("dd/MM")</div>
                                            <div>@sh.Start.ToString("HH:mm")–@sh.End.ToString("HH:mm")</div>
                                            <div class="role">@RoleName(sh.RoleId)</div>
                                        </div>
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in team.Members.Where(mm => mm.IsActive))
                            {
                                <tr>
                                    <td class="sticky-col">@m.Name</td>
                                    @foreach (var sh in orderedShifts)
                                    {
                                        var on = IsOn(m.Id, sh.Id);
                                        <td class="cell">
                                            <input type="checkbox" checked="@on" @onchange="(e)=>Toggle(m.Id, sh.Id, ((ChangeEventArgs)e).Value as bool?)" />
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="actions">
                <button class="primary-btn" @onclick="SaveAndContinue">Gerar escala</button>
                <button class="ghost-btn" @onclick="BackToShifts">Voltar</button>
            </div>
        </section>
    }
</main>

@code {
    [Parameter] public string? Id { get; set; }

    private bool loading = true;
    private ScheduleModel? schedule;
    private TeamModel? team;
    private List<ShiftModel> orderedShifts = new();
    private HashSet<string> avSet = new(); // "memberId|shiftId"

    protected override async Task OnParametersSetAsync()
    {
        loading = true;

        if (!string.IsNullOrEmpty(Id))
        {
            // varre todos times para achar a escala (chaves desconhecidas do teamId)
            foreach (var teamKey in Data.EnumerateKeys("teams/").Where(k => k.Count(c => c == '/') == 1))
            {
                var t = await Data.LoadAsync<TeamModel>(teamKey);
                if (t is null) continue;

                var schedKey = DataKeys.Schedule(t.Id, Id);
                if (await Data.ExistsAsync(schedKey))
                {
                    schedule = await Data.LoadAsync<ScheduleModel>(schedKey);
                    team = t;
                    break;
                }
            }
        }

        if (schedule is not null && team is not null)
        {
            orderedShifts = schedule.Shifts.OrderBy(s => s.Start).ToList();
            avSet = schedule.Availability is { Count: > 0 }
                ? schedule.Availability.Select(a => Key(a.MemberId, a.ShiftId)).ToHashSet()
                : new HashSet<string>();
        }

        loading = false;
    }

    private string RoleName(string roleId)
        => string.IsNullOrWhiteSpace(roleId)
            ? "—"
            : (team?.Roles.FirstOrDefault(r => r.Id == roleId)?.Name ?? "—");

    private static string Key(string memberId, string shiftId) => $"{memberId}|{shiftId}";
    private bool IsOn(string memberId, string shiftId) => avSet.Contains(Key(memberId, shiftId));

    private void Toggle(string memberId, string shiftId, bool? value)
    {
        var k = Key(memberId, shiftId);
        var on = value == true;
        if (on) avSet.Add(k);
        else avSet.Remove(k);
    }

    private string Tooltip(ShiftModel sh)
        => $"{sh.Start:dd/MM/yyyy HH:mm}–{sh.End:HH:mm} • {RoleName(sh.RoleId)}";

    private async Task SaveAndContinue()
    {
        if (schedule is null || team is null) return;

        schedule.Availability = avSet
            .Select(s => s.Split('|'))
            .Select(parts => new AvailabilityEntry { MemberId = parts[0], ShiftId = parts[1] })
            .ToList();

        await Data.SaveAsync(DataKeys.Schedule(team.Id, schedule.Id), schedule);
        Nav.NavigateTo($"/schedules/{schedule.Id}/result");
    }

    private void BackToShifts()
    {
        Nav.NavigateTo($"/schedules/new?teamId={team?.Id}");
    }
}

@page "/history"
@using EscalaFacil.Components.Models
@using EscalaFacil.Components.Services
@inject IDataStore Data
@inject NavigationManager Nav
@inject IJSRuntime JS

<main class="page-root">
    <h1 class="page-title">HISTÓRICO</h1>

    @if (loading)
    {
        <p class="muted center">Carregando…</p>
    }
    else if (groups.Count == 0)
    {
        <div class="empty">
            <p>Nenhuma escala encontrada.</p>
            <button class="ghost-btn" @onclick="GoNew">Criar nova escala</button>
        </div>
    }
    else
    {
        @foreach (var g in groups)
        {
            <section class="section">
                <h2 class="section-title">@g.Team.Name</h2>

                <ul class="card-list">
                    @foreach (var item in g.Items)
                    {
                        var range = DateRange(item.Schedule);
                        <li class="card">
                            <div class="card-head">
                                <div class="card-title-wrap">
                                    <h3 class="card-title">@item.Schedule.Name</h3>
                                    <div class="card-sub">@range</div>
                                </div>
                                <div class="card-meta">
                                    <span><strong>@item.Filled</strong>/<span>@item.Total</span> preenchidos</span>
                                    <span>·</span>
                                    <span>@item.CreatedAtLocal</span>
                                </div>
                            </div>

                            <div class="card-actions">
                                <button class="card-btn" @onclick="() => View(item.Schedule.Id)">Ver</button>
                                <button class="card-btn" @onclick="() => Edit(item.Schedule.Id)">Editar</button>
                                <button class="card-btn" @onclick="() => Duplicate(item)">Duplicar</button>
                                <button class="card-btn warn" @onclick="() => Delete(item)">Excluir</button>
                            </div>
                        </li>
                    }
                </ul>
            </section>
        }
    }
</main>

@code {
    private bool loading = true;

    private readonly List<GroupVm> groups = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAll();
    }

    private async Task LoadAll()
    {
        loading = true;
        groups.Clear();

        // Carrega equipes top-level
        var teamKeys = Data.EnumerateKeys("teams/").Where(k => k.Count(c => c == '/') == 1).ToList();

        foreach (var tkey in teamKeys)
        {
            var team = await Data.LoadAsync<TeamModel>(tkey);
            if (team is null) continue;

            var items = new List<ItemVm>();

            // Carrega escalas da equipe
            var schedPrefix = $"teams/{team.Id}/schedules/";
            foreach (var skey in Data.EnumerateKeys(schedPrefix).ToList())
            {
                var sched = await Data.LoadAsync<ScheduleModel>(skey);
                if (sched is null) continue;

                var filled = sched.Assignments?.Count ?? 0;
                var total = sched.Shifts?.Count ?? 0;

                items.Add(new ItemVm
                {
                    Team = team,
                    Schedule = sched,
                    Filled = filled,
                    Total = total,
                    CreatedAtLocal = ToLocalDisplay(sched.CreatedAt)
                });
            }

            if (items.Count == 0) continue;

            // Ordena escalas por data de criação (desc) e, em seguida, por início do primeiro turno
            items = items
                .OrderByDescending(i => i.Schedule.CreatedAt)
                .ThenBy(i => i.Schedule.Shifts.Min(s => s.Start))
                .ToList();

            groups.Add(new GroupVm { Team = team, Items = items });
        }

        // Ordena grupos por nome de equipe
        groups.Sort((a, b) => string.Compare(a.Team.Name, b.Team.Name, StringComparison.OrdinalIgnoreCase));

        loading = false;
    }

    private static string DateRange(ScheduleModel s)
    {
        if (s.Shifts.Count == 0) return "Sem turnos";
        var min = s.Shifts.Min(x => x.Start);
        var max = s.Shifts.Max(x => x.End);
        if (min.Date == max.Date)
            return $"{min:dd/MM/yyyy} · {min:HH\\:mm}–{max:HH\\:mm}";
        return $"{min:dd/MM} → {max:dd/MM}";
    }

    private static string ToLocalDisplay(DateTime utc)
    {
        try
        {
            // CreatedAt foi salvo como UTC; exibe dd/MM/aaaa HH:mm
            var local = DateTime.SpecifyKind(utc, DateTimeKind.Utc).ToLocalTime();
            return local.ToString("dd/MM/yyyy HH:mm");
        }
        catch
        {
            return utc.ToString("dd/MM/yyyy HH:mm");
        }
    }

    private void GoNew() => Nav.NavigateTo("/schedules/new");

    private void View(string scheduleId) => Nav.NavigateTo($"/schedules/{scheduleId}");
    private void Edit(string scheduleId) => Nav.NavigateTo($"/schedules/{scheduleId}/result");

    private async Task Duplicate(ItemVm item)
    {
        // Cria nova Schedule com mesmos turnos e disponibilidade; sem assignments
        var copy = new ScheduleModel
        {
            Id = Guid.NewGuid().ToString("N"),
            TeamId = item.Team.Id,
            Name = item.Schedule.Name + " (cópia)",
            Shifts = item.Schedule.Shifts
                .OrderBy(s => s.Start)
                .Select(s => new ShiftModel { Start = s.Start, End = s.End, RoleId = s.RoleId, Notes = s.Notes })
                .ToList(),
            Availability = item.Schedule.Availability
                .Select(a => new AvailabilityEntry { MemberId = a.MemberId, ShiftId = a.ShiftId })
                .ToList(),
            Assignments = new List<Assignment>() // sempre vazio na cópia
        };

        await Data.SaveAsync(DataKeys.Schedule(copy.TeamId, copy.Id), copy);
        // Vai direto para disponibilidade, caso queira ajustar
        Nav.NavigateTo($"/schedules/{copy.Id}/availability");
    }

    private async Task Delete(ItemVm item)
    {
        var ok = await JS.InvokeAsync<bool>("confirm",
            $"Excluir a escala \"{item.Schedule.Name}\" da equipe \"{item.Team.Name}\"?\nEssa ação não pode ser desfeita.");
        if (!ok) return;

        await Data.DeleteAsync(DataKeys.Schedule(item.Team.Id, item.Schedule.Id));
        await LoadAll();
        StateHasChanged();
    }

    private sealed class GroupVm
    {
        public TeamModel Team { get; set; } = default!;
        public List<ItemVm> Items { get; set; } = new();
    }

    private sealed class ItemVm
    {
        public TeamModel Team { get; set; } = default!;
        public ScheduleModel Schedule { get; set; } = default!;
        public int Filled { get; set; }
        public int Total { get; set; }
        public string CreatedAtLocal { get; set; } = "";
    }
}

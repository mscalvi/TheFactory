    private static List<KeyValuePair<string, int>> BuildProfList(CharacterModel m)
    {
        var list = new List<KeyValuePair<string, int>>(ProficienciasData.Ordem.Length);
        foreach (var nome in ProficienciasData.Ordem.OrderBy(n => n, StringComparer.CurrentCultureIgnoreCase))
        {
            if (ProfGet.TryGetValue(nome, out var getter))
                list.Add(new KeyValuePair<string, int>(nome, getter(m)));
        }

        return list;
    }

    private bool IsStepValid(int step)
    {
        switch (step)
        {
            case 0: return true; // explicações
            case 1: return !string.IsNullOrWhiteSpace(SelectedOrigem) && !string.IsNullOrWhiteSpace(SelectedTrilha);
            case 2: return Selecionadas.Count == 3;
            case 3: return !string.IsNullOrWhiteSpace(SelectedFardo);
            case 4: return PontosSobrando == 0;
            case 5: return true; // descrição é opcional (Ignorar vira ponto cego)
            case 6:
                var ignorados = AtributosData.AtributosOrdem.Count(a => GetEscolha(a) == VIgnorar);
                var requeridos = 2 + ignorados;
                var radiosIgnorados = PontoCegoEscolhaPorAtributo.Values.Where(v => !string.IsNullOrWhiteSpace(v));
                var totalSelecionado = new HashSet<string>(PontoCegoSelecionados.Concat(radiosIgnorados), StringComparer.Ordinal).Count;
                return totalSelecionado >= requeridos;
            case 7: return !string.IsNullOrWhiteSpace(Nome);
            default: return false;
        }
    }

    private string GetStepCss(int step) => IsStepValid(step) ? "valid" : "invalid";

    private bool AllValid() => Enumerable.Range(0, 7).All(IsStepValid); // 0..6 precisam estar ok antes de criar

    // -------- Ajudantes --------
    private int GetAttr(string label)
        => AtributosData.Atributos.TryGetValue(label, out var v) ? v : 0;

    private string GetDescricaoEscolhida(string atributo)
    {
        var escolha = GetEscolha(atributo); 
        var valor = GetAttr(atributo);
        int alvo = escolha switch
        {
            VMenos1 => valor - 1,
            VAtual => valor,
            VMais1 => valor + 1,
            VIgnorar => 0 // sem descrição quando escolhe Ignorar
        };
        return alvo >= 1 && alvo <= 6 ? DescricaoData.Get(atributo, alvo) : string.Empty;
    }

    private IEnumerable<string> GetAllPontosCegosOrdenados()
    {
        var set = new HashSet<string>(StringComparer.Ordinal);
        foreach (var s in PontoCegoSelecionados) if (!string.IsNullOrWhiteSpace(s)) set.Add(s);
        foreach (var s in PontoCegoEscolhaPorAtributo.Values) if (!string.IsNullOrWhiteSpace(s)) set.Add(s);
        return set.OrderBy(x => x, StringComparer.CurrentCultureIgnoreCase);
    }


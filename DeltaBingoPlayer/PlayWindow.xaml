<Window x:Class="DeltaBingoPlayer.PlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DeltaBingoPlayer"
        mc:Ignorable="d"
        Title="DeltaBingo - Controle de Jogo" Height="Auto" Width="Auto"
        WindowState="Maximized">
    <Grid>
        <Grid.RowDefinitions>

            <!-- Cabeçalho -->
            <RowDefinition Height="100"/>

            <!-- Colunas -->
            <RowDefinition Height="300"/>

            <!-- Informações -->
            <RowDefinition Height="70"/>

        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>

                <!-- Cabeçalho -->
                <ColumnDefinition Width="1*" />

                <!-- Botões -->
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>

                    <!-- Nome da Empresa e Software -->
                    <RowDefinition Height="35"/>

                    <!-- Botões de Alternância -->
                    <RowDefinition Height="20"/>

                    <!-- Caixa de Texto -->
                    <RowDefinition Height="*"/>
                    
                </Grid.RowDefinitions>
                <TextBlock x:Name="TitleText" Text="DeltaBingo - BingoPlayer" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold" TextAlignment="Center" Height="25" Width="416"/>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="84"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>

                            <!-- Botão de Home -->
                            <ColumnDefinition/>

                            <!-- Botão de Log -->
                            <ColumnDefinition/>

                            <!-- Botão de Help -->
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        
                        <Button x:Name="HomeBtn" Content="H" Grid.Column="0" Margin="2,2,2,2" FontSize="8"/>
                        <Button x:Name="LogBtn" Content="L" Grid.Column="1" Margin="2,2,2,2" FontSize="8"/>
                        <Button x:Name="HelpBtn" Content="?" Grid.Column="2" Margin="2,2,2,2" FontSize="8"/>
                    </Grid>
                </Grid>
            </Grid>
            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Button x:Name="ProjectBtn" Grid.Column="0" Grid.Row="0" Content="Ligar Projetor" Margin="10,10,10,10"/>
                <Button x:Name="RestartBtn" Grid.Column="1" Grid.Row="0" Content="Reiniciar" Margin="10,10,10,10"/>
                <Button x:Name="UndoBtn" Grid.Column="2" Grid.Row="0" Content="Desfazer" Margin="10,10,10,10"/>
                <Button x:Name="PauseBtn" Grid.Column="0" Grid.Row="1" Content="Pausar" Margin="10,10,10,10"/>
                <Button x:Name="BingoBtn" Grid.Column="1" Grid.Row="1" Content="Chamar Bingo!" Margin="10,10,10,10"/>
            </Grid>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>

                <!-- Coluna B -->
                <ColumnDefinition Width="200" />

                <!-- Coluna I -->
                <ColumnDefinition Width="200" />

                <!-- Coluna N -->
                <ColumnDefinition Width="200" />

                <!-- Coluna G -->
                <ColumnDefinition Width="200" />

                <!-- Coluna O -->
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>

                <!-- Telão -->
                <ColumnDefinition Width="500" />

                <!-- Resultados -->
                <ColumnDefinition Width="500"/>
            </Grid.ColumnDefinitions>
        </Grid>
    </Grid>
</Window>

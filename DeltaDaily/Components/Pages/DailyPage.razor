@page "/"

@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms
@using DeltaDaily.Components.Models

@code {
    private readonly CultureInfo ptBR = new("pt-BR");
    private DayModel Day = new();

    private string DiaDaSemana =>
        ptBR.TextInfo.ToTitleCase(Day.Data.ToString("dddd", ptBR));
    private string DataCurta => Day.Data.ToString("dd/MM/yy", ptBR);

    private List<WorkModel> Entradas { get; } = new();

    private void AdicionarEntrada()
        => Entradas.Add(new WorkModel());

    private void RemoverEntrada(WorkModel item)
        => Entradas.Remove(item);
}

<section>
    <!-- BLOCO 0 - Automático -->
    <header aria-labelledby="blk0-title">
        <h2 id="blk0-title">Hoje</h2>
        <div>
            <div><span>Dia de hoje: </span><strong>@DiaDaSemana</strong></div>
            <div><span>Data de hoje: </span><strong>@DataCurta</strong></div>
        </div>
    </header>

    <!-- BLOCO 1 - Básicos -->
    <section>
        <h2>Informações tradicionais</h2>

        <div>
            <label>
                <span>1º Despertar</span><br />
                <input type="time" @bind="Day.PrimeiroDespertar" />
            </label>
        </div>

        <div>
            <label>
                <span>Sair da Cama</span><br />
                <input type="time" @bind="Day.SairDaCama" />
            </label>
        </div>

        <div>
            <label>
                <input type="checkbox" @bind="Day.TomouRemedio" />
                <span>Remédio</span>
            </label>

            @if (Day.TomouRemedio)
            {
                <div>
                    <label>
                        <span>Dose</span><br />
                        <input type="text" @bind="Day.DoseRemedio" />
                    </label>
                </div>

                <div>
                    <label>
                        <span>Horário</span><br />
                        <input type="time" @bind="Day.HorarioRemedio" />
                    </label>
                </div>
            }
        </div>

        <div>
            <label>
                <span>Logout</span><br />
                <input type="time" @bind="Day.LogoutHora" />
            </label>
        </div>

        <div>
            <label>
                <span>Deitar</span><br />
                <input type="time" @bind="Day.DeitarHora" />
            </label>
        </div>
    </section>

    <!-- BLOCO 2 - Produtividade -->
    <section>
        <h2>Produtividade</h2>

        <button type="button" @onclick="AdicionarEntrada">Adicionar entrada</button>

        @if (Entradas.Count == 0)
        {
            <p>Nenhuma entrada.</p>
        }
        else
        {
            @foreach (var item in Entradas.ToList())
            {
            <fieldset>
                <legend>Entrada</legend>

                <div>
                <label>
                <span>Plano</span><br />
                <InputSelect @bind-Value="item.Plano">
                  @* vazio por enquanto, opções virão depois *@
                </InputSelect>
              </label>
            </div>

            <div>
              <label>
                <span>Duração</span><br />
                    <input type="time" @bind="item.Duracao"/>
              </label>
            </div>

            <div>
              <label>
                <span>Tipo</span><br />
                <InputSelect @bind-Value="item.Tipo">
                  @* vazio por enquanto *@
                </InputSelect>
              </label>
            </div>

            <div>
              <label>
                <span>Foco</span><br />
                <InputSelect @bind-Value="item.Foco">
                  @* vazio por enquanto *@
                </InputSelect>
              </label>
            </div>

            <div>
              <label>
                <span>Técnica</span><br />
                <InputSelect @bind-Value="item.Tecnica">
                  @* vazio por enquanto *@
                </InputSelect>
              </label>
            </div>

            <div>
              <button type="button" @onclick="@(() => RemoverEntrada(item))">Remover</button>
            </div>
          </fieldset>
        }
      }
    </section>

    <!-- BLOCO 3: Informações de saúde -->
    <section>
      <h2>Saúde</h2>

      <!-- Qualidade do Sono -->
      <div>
        <label>
          <span>Qualidade do Sono</span><br />
          <InputSelect @bind-Value="QualidadeSonoSel">
            <option value="">(selecione)</option>
            @foreach (var q in Enum.GetValues<QualidadeSono>())
            {
              <option value="@q">@q</option>
            }
          </InputSelect>
        </label>
      </div>

      <!-- Sonhos -->
      <div>
        <label>
          <span>Sonhos</span><br />
          <InputSelect @bind-Value="SonhoSel">
            <option value="">(selecione)</option>
            @foreach (var s in Enum.GetValues<SonhoTipo>())
            {
              <option value="@s">@s</option>
            }
          </InputSelect>
        </label>
      </div>

      <!-- (se tiver sonhos) Anotações de Sonhos -->
      @if (SonhoSel.HasValue && SonhoSel.Value != SonhoTipo.Nenhum)
      {
        <div>
          <label>
            <span>Anotações de Sonhos</span><br />
            <InputTextArea @bind-Value="SonhoNotas" rows="3" placeholder="Opcional" />
          </label>
        </div>
      }

      <!-- Humor Médio -->
      <div>
        <label>
          <span>Humor Médio</span><br />
          <InputSelect @bind-Value="HumorMedio">
            <option value="">(selecione)</option>
            @foreach (var h in Enum.GetValues<HumorNivel>())
            {
              <option value="@h">@h</option>
            }
          </InputSelect>
        </label>
      </div>

      <!-- Variação de Humor -->
      <div>
        <label>
          <InputCheckbox @bind-Value="VariacaoHumor" />
          <span>Variação de Humor</span>
        </label>
      </div>

      @if (VariacaoHumor)
      {
        <div>
          <label>
            <span>Anotações de Humor</span><br />
            <InputTextArea @bind-Value="VariacaoHumorNotas" rows="3" placeholder="Opcional" />
          </label>
        </div>
      }

      <hr />

      <!-- Exercício Físico -->
      <h3>Exercício Físico</h3>
      <button type="button" @onclick="AdicionarExercicio">Adicionar exercício</button>

      @if (Exercicios.Count == 0)
      {
        <p>Nenhum exercício.</p>
      }
      else
      {
        @foreach (var ex in Exercicios.ToList())
        {
          <fieldset>
            <legend>Exercício</legend>

            <div>
              <label>
                <span>Hora</span><br />
                <InputTime @bind-Value="ex.Hora" />
              </label>
            </div>

            <div>
              <label>
                <span>Duração</span><br />
                <InputTime @bind-Value="ex.Duracao" />
              </label>
            </div>

            <div>
              <label>
                <span>Modalidade</span><br />
                <InputSelect @bind-Value="ex.Modalidade">
                  <option value="">(selecione)</option>
                  @foreach (var m in Enum.GetValues<ModalidadeExercicio>())
                  {
                    <option value="@m">@m</option>
                  }
                </InputSelect>
              </label>
            </div>

            <div>
              <label>
                <span>Cansaço</span><br />
                <InputSelect @bind-Value="ex.Cansaco">
                  <option value="">(selecione)</option>
                  @foreach (var n in Enum.GetValues<Nivel>())
                  {
                    <option value="@n">@n</option>
                  }
                </InputSelect>
              </label>
            </div>

            <div>
              <label>
                <span>Ânimo</span><br />
                <InputSelect @bind-Value="ex.Animo">
                  <option value="">(selecione)</option>
                  @foreach (var n in Enum.GetValues<Nivel>())
                  {
                    <option value="@n">@n</option>
                  }
                </InputSelect>
              </label>
            </div>

            <div>
              <button type="button" @onclick="@(() => RemoverExercicio(ex))">Remover</button>
            </div>
          </fieldset>
        }
      }

      <hr />

      <!-- Alimentação -->
      <h3>Alimentação</h3>
      <button type="button" @onclick="AdicionarRefeicao">Adicionar refeição</button>

      @if (Refeicoes.Count == 0)
      {
        <p>Nenhuma refeição.</p>
      }
      else
      {
        @foreach (var rf in Refeicoes.ToList())
        {
          <fieldset>
            <legend>Refeição</legend>

            <div>
              <label>
                <span>Tipo</span><br />
                <InputSelect @bind-Value="rf.Tipo">
                  <option value="">(selecione)</option>
                  @foreach (var t in Enum.GetValues<TipoRefeicao>())
                  {
                    <option value="@t">@t</option>
                  }
                </InputSelect>
              </label>
            </div>

            <div>
              <label>
                <span>Alimentos</span><br />
                <InputTextArea @bind-Value="rf.Alimentos" rows="2" />
              </label>
            </div>

            <div>
              <label>
                <span>Horário</span><br />
                <InputTime @bind-Value="rf.Horario" />
              </label>
            </div>

            <div>
              <label>
                <span>Calorias</span><br />
                <InputText @bind-Value="rf.Calorias" placeholder="Ex.: 350" />
              </label>
            </div>

            <div>
              <button type="button" @onclick="@(() => RemoverRefeicao(rf))">Remover</button>
            </div>
          </fieldset>
        }
      }
    </section>

</section>

@page "/allday"
@using System.Globalization
@using DeltaDaily.Components.Services
@inject IJSRuntime JS
@inject IDayStoreService Store
@inject NavigationManager Nav

<button type="button" @onclick="IrParaHoje">Hoje</button>

<h2>Calendário</h2>

<label>
    <span>Ano</span><br />
    <select @bind="Ano" @bind:after="OnAnoChanged">
        @foreach (var y in Anos)
        {
            <option value="@y">@y</option>
        }
    </select>
</label>

<label style="margin-left:12px">
    <span>Mês</span><br />
    <select @bind="Mes" @bind:after="OnMesChanged">
        @for (int m = 1; m <= 12; m++)
        {
            <option value="@m">@ptBR.DateTimeFormat.GetMonthName(m)</option>
        }
    </select>
</label>

<hr />

<table>
    <thead>
        <tr>
            @foreach (var w in CabecalhosSemana)
            {
                <th>@w</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var semana in GradeMes)
        {
            <tr>
                @foreach (var dia in semana)
                {
                    <td style="text-align:center; width:28px; height:28px;">
                        @if (dia.HasValue)
                        {
                            var key = dia.Value.ToString("yyyy-MM-dd");
                            var style = Fechados.Contains(key) ? "background-color:#16a34a;color:white;"
                            : Existentes.Contains(key) ? "background-color:#dc2626;color:white;"
                            : null;

                            <button type="button" style="@style" @onclick="@(() => AbrirDia(dia.Value))">
                                @dia.Value.Day
                            </button>
                        }
                    </td>
                }
            </tr>
        }
    </tbody>
</table>

<button type="button" @onclick="DeletarTudo">Deletar Tudo</button>

@code {
    // ------------ Estado ------------
    private readonly CultureInfo ptBR = new("pt-BR");
    private int Ano = DateTime.Today.Year;
    private int Mes = DateTime.Today.Month;

    // Dias fechados do mês atual (chaves "yyyy-MM-dd")
    private HashSet<string> Fechados = new();
    private HashSet<string> Existentes = new();

    private IEnumerable<int> Anos => Enumerable.Range(DateTime.Today.Year - 5, 11);
    private static readonly string[] CabecalhosSemana = new[] { "D", "S", "T", "Q", "Q", "S", "S" };

    // Grade se recalcula com Ano/Mes atuais
    private List<List<DateTime?>> GradeMes => MontarGrade(Ano, Mes);

    // ------------ Ciclo de vida ------------
    protected override async Task OnInitializedAsync()
        => await CarregarStatusMes();

    // ------------ Eventos UI ------------
    private void OnAnoChanged() => _ = CarregarStatusMes();

    private void OnMesChanged() => _ = CarregarStatusMes();

    private void IrParaHoje()
        => Nav.NavigateTo($"/?date={DateTime.Today:yyyy-MM-dd}");

    private void AbrirDia(DateTime data)
        => Nav.NavigateTo($"/?date={data:yyyy-MM-dd}");

    // ------------ Acesso a dados ------------
    private async Task CarregarStatusMes()
    {
        Fechados.Clear();
        Existentes.Clear();

        var itens = await Store.ListByMonthAsync(Ano, Mes); // (date, closed)
        foreach (var (date, closed) in itens)
        {
            var key = date.ToString("yyyy-MM-dd");
            Existentes.Add(key);
            if (closed) Fechados.Add(key);
        }
        StateHasChanged();
    }

    // ------------ Utilidades ------------
    private static List<List<DateTime?>> MontarGrade(int ano, int mes)
    {
        var resultado = new List<List<DateTime?>>(capacity: 6);
        var primeiro = new DateTime(ano, mes, 1);
        var diasNoMes = DateTime.DaysInMonth(ano, mes);
        int start = (int)primeiro.DayOfWeek;

        int diaAtual = 1;
        for (int linha = 0; linha < 6; linha++)
        {
            var semana = new List<DateTime?>(capacity: 7);
            for (int col = 0; col < 7; col++)
            {
                int idx = linha * 7 + col;
                if (idx < start || diaAtual > diasNoMes) semana.Add(null);
                else semana.Add(new DateTime(ano, mes, diaAtual++));
            }
            resultado.Add(semana);
        }
        return resultado;
    }

    // ------------ Manutenção (opcional) ------------
    private async Task DeletarTudo()
    {
        await JS.InvokeVoidAsync("indexedDB.deleteDatabase", "deltaDaily");
        await JS.InvokeVoidAsync("location.reload");
    }
}

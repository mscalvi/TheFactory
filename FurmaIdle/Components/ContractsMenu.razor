@inherits UiHelper

@using FurmaIdle.Models
@using FurmaIdle.Helpers
@using FurmaIdle.Services

@inject IContractsService Contracts
@inject ILocateService Locate
@inject IPurchaseService Purchase
@inject ICostService Cost
@inject ITooltipService Tooltips
@inject IUiLogService Log

@implements IDisposable

<section class="game-area">
    @if (!Game.IsReady || string.IsNullOrWhiteSpace(_stage?.Id) || _stage is null || !IsExpeditionActive(_stage))
    {
        <div class="level-noChosen">
            <img src="@($"images/contracts-noExpedition.svg")" alt="Expedição Inativa" class="no-contract" />
        </div>
    }
    else
    {
        var contractsInfo = Contracts.GetStageInfo(Game.CurrentGame, _stage.Id);

        <div class="contracts-layout" style="--levels:@_stage.MaxContractLevel">
            <div class="contracts-capbar">
                <div class="selectbuy">
                    <button class="contract-button select-toggle"
                            @onclick="ToggleBuyMode">
                        @BuyModeLabel
                    </button>
                </div>
                <div class="cap">
                    <strong>Contratos:</strong>
                    <span>@contractsInfo.ContractsUsed / @contractsInfo.ContractsCap</span>
                </div>
            </div>

            <div class="contracts-grid" style="--levels:@_stage.MaxContractLevel">
                @for (int lvl = 1; lvl <= _stage.MaxContractLevel; lvl++)
                {
                    var level = lvl;

                    <div class="contracts-level"
                         @onmouseenter="() => OnEnterLevel(level)"
                         @onmouseleave="() => OnLeaveLevel(level)">
                        @if (level > contractsInfo.ContractsLevel)
                        {
                            <div class="level-noChosen">
                                <img src="@($"images/contracts-blockedLevel.svg")" alt="Nível Bloqueado" class="no-contract" />
                            </div>
                        }
                        else
                        {
                            @if (ShowOverlay(level))
                            {
                                <div class="level-noChosen">
                                    <img src="@($"images/contractlvl-{level}.svg")" alt="Passe o Mouse para escolher o Contrato" class="no-contract" />
                                </div>
                            }
                            else
                            {

                                @if (HasChosen(level))
                                {
                                    var chosenCon = ChosenContract(level);
                                    var qty = _stage.ActiveContracts?.TryGetValue(chosenCon.Id, out var q) == true ? q : 0;

                                    var hasCapacity = HasCapacity(_stage);
                                    var canBuy = CanPurchase(chosenCon, _stage!);
                                    var disabled = !CanBuyCurrentMode(chosenCon, _stage!);

                                    var rp = Contracts.GetContractInfo(chosenCon, _stage);
                                    var coin = Locate.LocateCoin(Game.CurrentGame, rp.CoinId);
                                    var (costTotal, costCoinName) = CostOf(chosenCon.Id);

                                    <div class="contract-card">
                                        <div class="contract-card-top">
                                            <button class="icon-button @(disabled ? "is-locked" : null)"
                                                    disabled="@disabled"
                                                    @onclick="() => BuyContract(chosenCon.Id)"
                                                    @onmouseenter="() => Tooltips.Show(Tooltips.GetHover(HoverType.Contract, chosenCon.Id, _stage.Id))"
                                                    @onmouseleave="Tooltips.Clear"
                                                    @onfocus="() => Tooltips.Show(Tooltips.GetHover(HoverType.Contract, chosenCon.Id, _stage.Id))"
                                                    @onblur="Tooltips.Clear">
                                                @if (!string.IsNullOrWhiteSpace(chosenCon.Icon))
                                                {
                                                    <img src="@chosenCon.Icon"
                                                         alt="@chosenCon.Id"
                                                         class="icon-img" />
                                                }
                                                else
                                                {
                                                    @chosenCon.Id
                                                }
                                            </button>

                                            <div class="contract-info">
                                                <div class="cc-name">x<strong>@qty</strong> contratos para @chosenCon.Name</div>
                                                <div class="cc-cycle">@NumbersHelper.Padronize(rp.CoinsPerCycle * qty) @coin.Name</div>
                                            </div>
                                        </div>

                                        <div class="contract-card-bottom">
                                            @{
                                                var prog = Math.Clamp(Contracts.GetContractProgress(Game.CurrentGame, _stage.Id, chosenCon.Id), 0.0, 1.0);

                                                const int steps = 100;
                                                int filled = Math.Clamp((int)Math.Ceiling(prog * steps), 0, steps);
                                            }
                                            <div class="contract-progress-bar">
                                                @for (int i = 0; i < 100; i++)
                                                {
                                                    var isFilled = i < filled;
                                                    <div class="chunk @(isFilled ? "is-filled" : null)"></div>
                                                }
                                            </div>
                                        </div>
                                    </div>

                                }
                                else
                                {
                                    var ids = Contracts.AvaliableContracts(Game.CurrentGame, _stage.Id);
                                    var list = ids
                                    .Select(id => Locate.LocateContract(Game.CurrentGame, id))
                                    .Where(c => c is not null && c.Level == level)
                                    .ToList();

                                    @if (list.Count == 0)
                                    {
                                        <div class="level-noChosen">
                                            <img src="@($"images/contracts-noContracts.svg")" alt="Nenhum Contrato do Nível foi Desbloqueado" class="no-contract" />
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="icon-grid">
                                            @foreach (var c in list)
                                            {
                                                var hasCapacity = HasCapacity(_stage);
                                                var canBuy = CanPurchase(c, _stage);
                                                var disabled = !hasCapacity || !canBuy;

                                                <button class="icon-button @(disabled ? "is-locked" : null)"
                                                        disabled="@disabled"
                                                        @onclick="() => BuyContract(c.Id)"
                                                        @onmouseenter="() => Tooltips.Show(Tooltips.GetHover(HoverType.Contract, c.Id, _stage.Id))"
                                                        @onmouseleave="Tooltips.Clear"
                                                        @onfocus="() => Tooltips.Show(Tooltips.GetHover(HoverType.Contract, c.Id, _stage.Id))"
                                                        @onblur="Tooltips.Clear">
                                                        @if (!string.IsNullOrWhiteSpace(c.Icon))
                                                        {
                                                            <img src="@c.Icon"
                                                                 alt="@c.Id"
                                                                 class="icon-img" />
                                                        }
                                                        else
                                                        {
                                                            @c.Id
                                                        }
                                                </button>
                                            }
                                        </div>
                                    }
                                }
                            }
                        }
                    </div>
                }
            </div>
        </div>
    }

</section>

@code {
    private StageModel? _stage;

    private string? _lastStageId;
    private bool _lastActive;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        RefreshStage(maybeCollapse: true);
    }

    protected override void OnGameChanged()
    {
        RefreshStage(maybeCollapse: false);
    }

    private void RefreshStage(bool maybeCollapse)
    {
        var game = Game.CurrentGame;

        if (!Game.IsReady || string.IsNullOrWhiteSpace(game.SelectedStageId))
        {
            _stage = null;
            _lastStageId = null;
            _lastActive = false;
            return;
        }

        game.Stages.TryGetValue(game.SelectedStageId, out var st);
        _stage = st;

        var activeNow = IsExpeditionActive(st);
        var stageChanged = !string.Equals(_lastStageId, game.SelectedStageId, StringComparison.Ordinal);
        var activeDropped = _lastActive && !activeNow;

        _lastStageId = game.SelectedStageId;
        _lastActive = activeNow;
    }

    private static bool IsExpeditionActive(StageModel? st)
        => st?.Expedition?.ExpeditionState == UnlockHelper.ExpeditionState.Active;

    private enum BuyMode
    {
        X1,
        X10,
        Max
    }

    private BuyMode _buyMode = BuyMode.X1;

    private string BuyModeLabel => _buyMode switch
    {
        BuyMode.X1 => "Comprar x1",
        BuyMode.X10 => "Comprar x10",
        BuyMode.Max => "Comprar MAX",
        _ => "Comprar x1"
    };

    private void ToggleBuyMode()
    {
        _buyMode = _buyMode switch
        {
            BuyMode.X1 => BuyMode.X10,
            BuyMode.X10 => BuyMode.Max,
            BuyMode.Max => BuyMode.X1,
            _ => BuyMode.X1
        };
    }

    private int GetBuyQuantity()
        => _buyMode switch
        {
            BuyMode.X1 => 1,
            BuyMode.X10 => 10,
            BuyMode.Max => -1,
            _ => 1
        };
    private async Task BuyContract(string contractId)
    {
        if (_stage is null) return;

        var game = Game.CurrentGame;
        var contract = Locate.LocateContract(game, contractId);

        // Se nem 1 dá pra comprar, sai
        if (!CanPurchase(contract, _stage)) return;

        var contractsInfo = Contracts.GetStageInfo(game, _stage.Id);
        var capLeft = contractsInfo.ContractsCap - contractsInfo.ContractsUsed;
        if (capLeft <= 0) return;

        // Quantidade atual desse contrato no estágio
        var currentQty = 0;
        _stage.ActiveContracts?.TryGetValue(contractId, out currentQty);
        var isFirst = currentQty <= 0;

        var modeQty = GetBuyQuantity();
        int qtyToBuy;

        if (isFirst)
        {
            // Primeira compra SEMPRE x1, independente do modo
            qtyToBuy = Math.Min(1, capLeft);
        }
        else
        {
            if (modeQty > 0)
            {
                // x1 ou x10
                qtyToBuy = Math.Min(modeQty, capLeft);
            }
            else
            {
                // MAX: quanto dinheiro dá + limite de slots
                var (maxAffordable, _, _) =
                    Cost.ComputeMaxAffordable(ItemHelper.ItemType.Contract, contractId, _stage.Id);

                qtyToBuy = Math.Min(maxAffordable, capLeft);
            }
        }

        if (qtyToBuy <= 0) return;

        await Purchase.Purchase(ItemHelper.ItemType.Contract, contractId, _stage.Id, qtyToBuy);

        // Atualiza tooltip depois de comprar
        var hover = Tooltips.GetHover(HoverType.Contract, contractId, _stage.Id);
        Tooltips.Show(hover);

        StateHasChanged();
    }


    private bool CanPurchase(ContractModel contract, StageModel stage)
        => Cost.CanAfford(ItemHelper.ItemType.Contract, contract.Id, stage.Id);

    private bool HasCapacity(StageModel stage)
    {
        var contractsInfo = Contracts.GetStageInfo(Game.CurrentGame, _stage.Id);
        bool capacity = contractsInfo.ContractsUsed < contractsInfo.ContractsCap;

        return capacity;
    }

    private bool CanBuyCurrentMode(ContractModel contract, StageModel stage)
    {
        var game = Game.CurrentGame;
        var info = Contracts.GetStageInfo(game, stage.Id);
        var capLeft = info.ContractsCap - info.ContractsUsed;
        if (capLeft <= 0) return false;

        // Quantidade atual
        var currentQty = 0;
        stage.ActiveContracts?.TryGetValue(contract.Id, out currentQty);
        var isFirst = currentQty <= 0;

        if (isFirst)
        {
            // Primeira compra: só precisa saber se dá pra pagar 1
            return capLeft > 0 &&
                   Cost.CanAfford(ItemHelper.ItemType.Contract, contract.Id, stage.Id);
        }

        var modeQty = GetBuyQuantity();

        if (modeQty > 0)
        {
            var qty = Math.Min(modeQty, capLeft);
            return qty > 0 &&
                   Cost.CanAfford(ItemHelper.ItemType.Contract, contract.Id, stage.Id, qty);
        }
        else
        {
            var (maxAffordable, _, _) =
                Cost.ComputeMaxAffordable(ItemHelper.ItemType.Contract, contract.Id, stage.Id);

            var qty = Math.Min(maxAffordable, capLeft);
            return qty > 0;
        }
    }


    private ContractModel? ChosenContract(int level)
    {
        var id = Contracts.GetChosenContractIdForLevel(Game.CurrentGame, _stage.Id, level);
        if (string.IsNullOrWhiteSpace(id)) return null;
        return Locate.LocateContract(Game.CurrentGame, id);
    }

    (long val, string coinName) CostOf(string contractId)
    {
        var (v, costId) = Cost.ComputeCost(ItemHelper.ItemType.Contract, contractId, _stage.Id);
        return (v, IdToName(costId));
    }

    private string IdToName(string? id)
    {
        if (string.IsNullOrWhiteSpace(id)) return "";
        var g = Game.CurrentGame;
        return id[0] switch
        {
            'm' => Locate.LocateCoin(g, id).Name,       // moedas
            'r' => Locate.LocateResource(g, id).Name,   // recursos
            'k' => Locate.LocateKnowledge(g, id).Name,  // conhecimento
            _ => id
        };
    }

    private HashSet<int> _hoverLevels = new();

    private bool HasChosen(int level)
        => ChosenContract(level) is not null;

    private bool ShowOverlay(int level)
        => !HasChosen(level) && !_hoverLevels.Contains(level);

    private void OnEnterLevel(int level) => _hoverLevels.Add(level);
    private void OnLeaveLevel(int level) => _hoverLevels.Remove(level);

}

@using FurmaIdle.Models
@using FurmaIdle.Helpers
@using FurmaIdle.Services

@inject ICurrentGameService Game
@inject IContractsService Contracts
@inject ILocateService Locate

@if (!Game.IsReady || string.IsNullOrWhiteSpace(StageId) || _stage is null)
{
    <div class="contracts-placeholder">Carregando contratos…</div>
}
else
{
    <div class="contracts-grid">
        @for (int lvl = 1; lvl <= _stage.MaxContractLevel; lvl++)
        {
            var level = lvl;  // <- captura estável para esta iteração

            <div class="contracts-level">
                @if (level > _stage.ActualContractLevel)
                {
                    <div class="level-locked">Nível de Contrato Bloqueado</div>
                }
                else
                {
                    var isChosen = _stage.ActiveContractsLevels?.ContainsKey(level) == true;
                    var expanded = _expandedLevel == level;

                    if (isChosen)
                    {
                        <div class="level-chosen">Contrato deste nível já foi escolhido.</div>
                    }
                    else
                    {
                        if (!expanded)
                        {
                            <button type="button" class="level-button" @onclick="() => ToggleLevel(level)">
                                Contrato Nível @level
                            </button>
                        }
                        else
                        {
                            <div class="level-header">
                                <strong>Contratos de nível @level</strong>
                                <button type="button" class="back-button icon-button" @onclick="CloseLevel">Voltar</button>
                            </div>

                            var ids = Contracts.AvaliableContracts(Game.CurrentGame!, StageId);
                            var list = ids
                            .Select(id => Locate.LocateContract(Game.CurrentGame!, id))
                            .Where(c => c is not null && c.Level == level)   // <- use level aqui também
                            .ToList();

                            @if (list.Count == 0)
                            {
                                <div class="no-contracts">Nenhum contrato disponível neste nível.</div>
                            }
                            else
                            {
                                <div class="contracts-list">
                                    @foreach (var c in list)
                                    {
                                        <button type="button" class="contract-button icon-button" @onclick="() => BuyContract(c!.Id)">
                                            @c!.Name
                                        </button>
                                    }
                                </div>
                            }
                        }
                    }
                }
            </div>
        }

    </div>
}


@code {
    [Parameter] public string StageId { get; set; } = default!;

    private StageModel? _stage;
    private int? _expandedLevel;

    protected override void OnParametersSet()
    {
        if (!Game.IsReady || string.IsNullOrWhiteSpace(StageId))
        {
            _stage = null;
            _expandedLevel = null;
            return;
        }

        var g = Game.CurrentGame;
        if (g is null || g.Stages is null || !g.Stages.TryGetValue(StageId, out _stage))
        {
            _stage = null;
            _expandedLevel = null;
        }
    }

    private void ToggleLevel(int lvl)
    {
        Console.WriteLine($"[Contracts] Contratos de Nível {lvl}");
        _expandedLevel = (_expandedLevel == lvl) ? null : lvl;
    }

    private void CloseLevel() => _expandedLevel = null;

    private void BuyContract(string contractId)
    {
        Console.WriteLine($"[Contracts] Comprando Contrato {contractId}");
        if (!Game.IsReady || _stage is null) return;

        Contracts.BuyContract(Game.CurrentGame, _stage.Id, contractId);

        _expandedLevel = null;
        StateHasChanged();
    }

    private bool CanPurchase(ContractModel contract, StageModel stage)
    {
        return false;
    }

    private bool IsLevelChosen(int lvl)
        => _stage?.ActiveContractsLevels?.ContainsKey(lvl) == true;
}

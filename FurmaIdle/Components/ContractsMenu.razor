@inherits UiHelper

@using FurmaIdle.Models
@using FurmaIdle.Helpers
@using FurmaIdle.Services

@inject IContractsService Contracts
@inject ILocateService Locate
@inject IPurchaseService Purchase
@inject ICostService Cost
@inject ITooltipService Tooltips
@inject IUiLogService Log

@implements IDisposable

<section class="contracts-root">
    @if (!Game.IsReady || string.IsNullOrWhiteSpace(_stage?.Id) || _stage is null || !IsExpeditionActive(_stage))
    {
        <div class="contracts-empty">
            <img src="image/contracts-noStage" alt="Sem Expedição Ativa" />
        </div>
    }
    else
    {
        var contractsInfo = Contracts.GetStageInfo(Game.CurrentGame, _stage.Id);

        <div class="contracts-layout" style="--levels:@_stage.MaxContractLevel">
            <div class="contracts-capbar">
                <strong>Contratos:</strong>
                <span>@contractsInfo.ContractsUsed / @contractsInfo.ContractsCap</span>
            </div>

            <div class="contracts-grid" style="--levels:@_stage.MaxContractLevel">
                @for (int lvl = 1; lvl <= _stage.MaxContractLevel; lvl++)
                {
                    var level = lvl;

                    <div class="contracts-level">
                        @if (level > contractsInfo.ContractsLevel)
                        {
                            // <div class="level-locked">Nível de Contrato Bloqueado</div>
                            <div class="level-locked">
                                <img src="image/contracts-blockedLevel" alt="Nível de Contrato Bloqueado" />
                            </div>
                        }
                        else
                        {
                            var lvlChosen = _stage.lockedContractLevel.Contains(level) == true;
                            var expanded = _expandedLevel == level;

                            if (lvlChosen)
                            {
                                var chosenCon = ChosenContract(level);
                                @if (chosenCon is null)
                                {
                                    // <div class="level-chosen">Contrato deste nível não foi escolhido.</div>
                                    <div class="level-chosen">
                                        <img src="image/contracts-chosenBug" alt="Contrato do Nível não Escolhido" />
                                    </div>
                                }
                                else
                                {
                                    var chosen = chosenCon;
                                    var qty = _stage.ActiveContracts?.TryGetValue(chosen.Id, out var q) == true ? q : 0;
                                    var hasCapacity = HasCapacity(_stage);
                                    var canBuy = CanPurchase(chosen, _stage!);
                                    var disabled = !hasCapacity || !canBuy;

                                    var rp = Contracts.GetContractInfo(chosen, _stage);
                                    var coin = Locate.LocateCoin(Game.CurrentGame, rp.CoinId);
                                    var (costTotal, costCoinName) = CostOf(chosen.Id);

                                    <div class="contracts-picked">
                                        <div class="cp-top">
                                            <button type="button"
                                                    class="contract-button @(disabled ? "is-locked" : null)"
                                                    disabled="@disabled"
                                                    @onclick="() => BuyContract(chosen.Id)"
                                                    @onmouseenter="() => Tooltips.Show(Tooltips.GetHover(HoverType.Contract, chosen.Id, _stage.Id))"
                                                    @onmouseleave="Tooltips.Clear"
                                                    @onfocus="() => Tooltips.Show(Tooltips.GetHover(HoverType.Contract, chosen.Id, _stage.Id))"
                                                    @onblur="Tooltips.Clear">
                                                @chosen.Id
                                            </button>

                                            <div class="contract-card">
                                                <div class="cc-name">x<strong>@qty</strong> contratos para @chosen.Name</div>
                                                <div class="cc-cycle">@rp.TotalPerCycle.ToString("N2") @coin?.Name a cada @rp.SecondsPerCycle.ToString("N2")s</div>
                                                <div class="cc-cycle">@rp.TotalPerSecond.ToString("N2") @coin.Name/s - Próximo: @costTotal @costCoinName</div>
                                            </div>
                                        </div>

                                        @{
                                            var prog = Math.Clamp(Contracts.GetContractProgress(Game.CurrentGame, _stage.Id, chosen.Id), 0.0, 1.0);
                                            var pct = Math.Clamp(prog * 100, 0, 100);

                                            const int steps = 25;
                                            // pinta ao ENTRAR no step; 0% -> 0, 0.1 step -> 1, 100% -> 25
                                            int filled = Math.Clamp((int)Math.Ceiling(prog * steps), 0, steps);
                                        }
                                        <div class="cp-bottom">
                                            <div class="cp-bar cp-bar-chunked" role="progressbar"
                                                 aria-valuemin="0" aria-valuemax="100" aria-valuenow="@pct.ToString("N0")">
                                                @for (int i = 0; i < 25; i++)
                                                {
                                                    var isFilled = i < filled;
                                                    <div class="chunk @(isFilled ? "is-filled" : null)"></div>
                                                }
                                            </div>
                                        </div>


                                    </div>

                                }
                            }
                            else
                            {
                                if (!expanded)
                                {
                                    <button type="button" class="level-button" @onclick="() => ToggleLevel(level)">
                                        Contrato Nível @level
                                    </button>
                                }
                                else
                                {
                                    <div class="level-header">
                                        <strong>Contratos de nível @level</strong>
                                        <button type="button" class="back-button icon-button" @onclick="CloseLevel">Voltar</button>
                                    </div>

                                    var ids = Contracts.AvaliableContracts(Game.CurrentGame, _stage.Id);
                                    var list = ids
                                        .Select(id => Locate.LocateContract(Game.CurrentGame, id))
                                        .Where(c => c is not null && c.Level == level)
                                        .ToList();

                                    @if (list.Count == 0)
                                    {
                                        // <div class="no-contracts">Nenhum contrato disponível neste nível.</div>
                                        <div class="no-contracts">
                                            <img src="image/contracts-noContracts" alt="Nenhum Contrato Desbloqueado" />
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="contracts-list">
                                            @foreach (var c in list)
                                            {
                                                var hasCapacity = HasCapacity(_stage);
                                                var canBuy = CanPurchase(c, _stage);
                                                var disabled = !hasCapacity || !canBuy;

                                                <button type="button"
                                                        class="contract-button @(disabled ? "is-locked" : null)"
                                                        disabled="@disabled"
                                                        @onclick="() => BuyContract(c.Id)"
                                                        @onmouseenter="() => Tooltips.Show(Tooltips.GetHover(HoverType.Contract, c.Id, _stage.Id))"
                                                        @onmouseleave="Tooltips.Clear"
                                                        @onfocus="() => Tooltips.Show(Tooltips.GetHover(HoverType.Contract, c.Id, _stage.Id))"
                                                        @onblur="Tooltips.Clear">
                                                    @c.Id
                                                </button>
                                            }
                                        </div>
                                    }
                                }
                            }
                        }
                    </div>
                }
            </div>
        </div>
    }

</section>

@code {
    private StageModel? _stage;
    private int? _expandedLevel;

    private string? _lastStageId;
    private bool _lastActive;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        RefreshStage(maybeCollapse: true);
    }

    protected override void OnGameChanged()
    {
        RefreshStage(maybeCollapse: false);
    }

    private void RefreshStage(bool maybeCollapse)
    {
        var game = Game.CurrentGame;

        if (!Game.IsReady || string.IsNullOrWhiteSpace(game.SelectedStageId))
        {
            _stage = null;
            _expandedLevel = null;
            _lastStageId = null;
            _lastActive = false;
            return;
        }

        game.Stages.TryGetValue(game.SelectedStageId, out var st);
        _stage = st;

        var activeNow = IsExpeditionActive(st);
        var stageChanged = !string.Equals(_lastStageId, game.SelectedStageId, StringComparison.Ordinal);
        var activeDropped = _lastActive && !activeNow;

        if (maybeCollapse && (stageChanged || activeDropped))
            _expandedLevel = null;

        _lastStageId = game.SelectedStageId;
        _lastActive = activeNow;
    }

    private static bool IsExpeditionActive(StageModel? st)
        => st?.Expedition?.ExpeditionState == UnlockHelper.ExpeditionState.Active;

    private void ToggleLevel(int lvl)
    {
        _expandedLevel = (_expandedLevel == lvl) ? null : lvl;
        StateHasChanged();
    }

    private void CloseLevel() => _expandedLevel = null;

    private async Task BuyContract(string contractId)
    {
        var contract = Locate.LocateContract(Game.CurrentGame, contractId);
        if (!CanPurchase(contract, _stage)) return;

        if (!HasCapacity(_stage)) return;

        await Purchase.Purchase(ItemHelper.ItemType.Contract, contractId, _stage.Id);

        _expandedLevel = null;
        StateHasChanged();
    }

    private bool CanPurchase(ContractModel contract, StageModel stage)
        => Cost.CanAfford(ItemHelper.ItemType.Contract, contract.Id, stage.Id);

    private bool HasCapacity(StageModel stage)
    {
        var contractsInfo = Contracts.GetStageInfo(Game.CurrentGame, _stage.Id);
        bool capacity = contractsInfo.ContractsUsed < contractsInfo.ContractsCap;

        return capacity;
    }

    private ContractModel? ChosenContract(int level)
    {
        var id = Contracts.GetChosenContractIdForLevel(Game.CurrentGame, _stage.Id, level);
        if (string.IsNullOrWhiteSpace(id)) return null;
        return Locate.LocateContract(Game.CurrentGame, id);
    }

    (long val, string coinName) CostOf(string contractId)
    {
        var (v, costId) = Cost.ComputeCost(ItemHelper.ItemType.Contract, contractId, _stage.Id);
        return (v, IdToName(costId));
    }

    private string IdToName(string? id)
    {
        if (string.IsNullOrWhiteSpace(id)) return "";
        var g = Game.CurrentGame;
        return id[0] switch
        {
            'm' => Locate.LocateCoin(g, id).Name,       // moedas
            'r' => Locate.LocateResource(g, id).Name,   // recursos
            'k' => Locate.LocateKnowledge(g, id).Name,  // conhecimento
            _ => id
        };
    }
}

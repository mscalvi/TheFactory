@using System.Linq
@using FurmaIdle.Data
@using FurmaIdle.Models
@using FurmaIdle.Helpers
@using FurmaIdle.Services

@inject ICurrentGameService Game
@inject IUiService UI
@inject IUnlockService Unlock
@inject ITooltipService Tooltips

<section class="shop-menu panel">
    @if (Game.CurrentGame?.Stages is not { Count: > 0 })
    {
        <p>Carregando…</p>
    }
    else
    {
        var type = MapNavToType(SelectedId);

        if (type is null)
        {
            <p>Selecione uma opção no menu.</p>
        }
        else
        {
            var unlocked = GetByState(type.Value, UnlockHelper.State.Unlocked).ToList();
            var avaliable = GetByState(type.Value, UnlockHelper.State.Available).ToList();

            <div class="shop-block">
                <h4>@type.Value</h4>

                <h5>Avaliable</h5>
                @if (!avaliable.Any())
                {
                    <p>Nenhum item disponível</p>
                }
                else
                {
                    <div class="shop-list">
                        @foreach (var it in avaliable)
                        {
                            @RenderItemButton(it, type.Value, isUnlocked: false)
                        }
                    </div>
                }

                <h5>Unlocked</h5>
                @if (!unlocked.Any())
                {
                    <p>Nenhum item desbloqueado</p>
                }
                else
                {
                    <div class="shop-list">
                        @foreach (var it in unlocked)
                        {
                            @RenderItemButton(it, type.Value, isUnlocked: true)
                        }
                    </div>
                }
            </div>
        }
    }
</section>

@code {
    [Parameter] public string? SelectedId { get; set; }

    // ===== DTO comum pra UI =====
    private readonly record struct ViewItem(string Id, string? Name, UnlockHelper.State State);

    // ===== Mapeia o item do menu lateral =====
    private static ItemHelper.ItemType? MapNavToType(string? navId) => navId switch
    {
        "i1" => ItemHelper.ItemType.Stage,
        "i2" => ItemHelper.ItemType.Expansion,   // (sem uso aqui)
        "i3" => ItemHelper.ItemType.Expedition, // (sem uso aqui)
        "i4" => ItemHelper.ItemType.Character,
        "i5" => ItemHelper.ItemType.Tech,
        "i6" => ItemHelper.ItemType.Local,
        "i7" => ItemHelper.ItemType.Upgrade,
        "i8" => ItemHelper.ItemType.Character,
        _ => null
    };

    // Para tooltip: como estamos mostrando UPGRADES em todas as seções,
    // o hover é de Upgrade em todas (exceto se você quiser tooltip do alvo).
    private static HoverType? MapHover(ItemHelper.ItemType t) => HoverType.Upgrade;

    // ===== Helpers de filtro por "tipo" de upgrade =====
    // Ajuste estes métodos para casar com o seu modelo (nome da enum/propriedade)
    private static bool IsUnlockStage(UpgradeModel u) => u.EffectType == EffectHelper.EffectType.StageUnlock;
    private static bool IsUnlockCharacter(UpgradeModel u) => u.EffectType == EffectHelper.EffectType.CharacterUnlock;
    private static bool IsUnlockLocal(UpgradeModel u) => u.EffectType == EffectHelper.EffectType.LocalUnlock;

    private static bool IsUnlockAny(UpgradeModel u) =>
        IsUnlockStage(u) || IsUnlockCharacter(u) || IsUnlockLocal(u);

    // ===== Ordem de exibição (opcional para upgrades) =====
    private static IReadOnlyList<string> GetOrder(ItemHelper.ItemType type) => type switch
    {
        // Como agora todas as seções mostram upgrades, você pode usar uma ordem global de upgrades
        // Se tiver uma ordem específica, mantenha aqui:
        ItemHelper.ItemType.Upgrade => UpgradeData.ShowOrder,
        ItemHelper.ItemType.Stage => UpgradeData.ShowOrder,
        ItemHelper.ItemType.Character => UpgradeData.ShowOrder,
        ItemHelper.ItemType.Tech => UpgradeData.ShowOrder,
        ItemHelper.ItemType.Local => UpgradeData.ShowOrder,
        _ => Array.Empty<string>()
    };

    // ===== Projeção: SEMPRE parte dos Upgrades e filtra por "tipo" =====
    private static IEnumerable<ViewItem> Project(GameModel g, ItemHelper.ItemType type)
    {
        IEnumerable<UpgradeModel> src = g.Upgrades?.Values ?? Enumerable.Empty<UpgradeModel>();

        src = type switch
        {
            ItemHelper.ItemType.Stage => src.Where(IsUnlockStage),
            ItemHelper.ItemType.Character => src.Where(IsUnlockCharacter),
            ItemHelper.ItemType.Local => src.Where(IsUnlockLocal),

            ItemHelper.ItemType.Upgrade => src.Where(u => !IsUnlockAny(u)),

            _ => Enumerable.Empty<UpgradeModel>()
        };

        return src.Select(u => new ViewItem(u.Id, u.Name, u.State));
    }

    // ===== Filtro por estado + ordenação =====
    private IEnumerable<ViewItem> GetByState(ItemHelper.ItemType type, UnlockHelper.State desired)
    {
        var g = Game.CurrentGame;
        if (g is null) return Enumerable.Empty<ViewItem>();

        var order = GetOrder(type);
        int OrderIndex(string id)
        {
            if (order is null) return int.MaxValue;

            if (order is List<string> list)
            {
                var idx = list.IndexOf(id);
                return idx >= 0 ? idx : int.MaxValue;
            }

            for (int i = 0; i < order.Count; i++)
                if (string.Equals(order[i], id, StringComparison.Ordinal))
                    return i;

            return int.MaxValue;
        }

        return Project(g, type)
            .Where(it => it.State == desired)
            .OrderBy(it => OrderIndex(it.Id));
    }

    // ===== Botão de item =====
    private RenderFragment RenderItemButton(ViewItem it, ItemHelper.ItemType type, bool isUnlocked) => builder =>
    {
        var seq = 0;
        builder.OpenElement(seq++, "button");
        builder.AddAttribute(seq++, "class", $"shop-item {(isUnlocked ? "is-unlocked" : "is-avaliable")}");

        // Hover/focus -> tooltip (sempre Upgrade aqui)
        builder.AddAttribute(seq++, "onmouseenter", EventCallback.Factory.Create(this, () => ShowTip(HoverType.Upgrade, it.Id)));
        builder.AddAttribute(seq++, "onmouseleave", EventCallback.Factory.Create(this, ClearTip));
        builder.AddAttribute(seq++, "onfocus", EventCallback.Factory.Create(this, () => ShowTip(HoverType.Upgrade, it.Id)));
        builder.AddAttribute(seq++, "onblur", EventCallback.Factory.Create(this, ClearTip));

        // Clique: nas listas acima, o item é um UPGRADE (mesmo em Stages/Characters/Tech/Local),
        // então para "Available" chamamos UnlockUpgrade. Para "Unlocked" não faz nada.
        if (!isUnlocked)
            builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => Unlock.UnlockUpgrade(it.Id)));
        else
            builder.AddAttribute(seq++, "aria-disabled", "true");

        builder.AddContent(seq++, it.Name ?? it.Id);
        builder.CloseElement();
    };

    // ===== Tooltip =====
    private void ShowTip(HoverType hoverType, string id)
    {
        var tip = Tooltips.GetHover(hoverType, id, Game.CurrentGame?.SelectedStageId);
        Tooltips.Show(tip);
    }

    private void ClearTip() => Tooltips.Clear();
}

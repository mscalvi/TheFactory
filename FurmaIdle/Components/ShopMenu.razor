@* ShopMenu.razor *@

@inherits UiHelper

@using FurmaIdle.Models

<div class="game-area">
@if (!Game.IsReady || _stage is null || string.IsNullOrWhiteSpace(_stage.Id))
{
    <div class="contracts-placeholder">Stage não Selecionado</div>
}
else
{
    @switch (SelectedMenuId)
    {
        case "i1":
            @* (1) Expansion — Current Expansion Stats / inBase Characters / inStageCharacters *@
            <ShopMenuExpansion />
            break;

        case "i2":
            @* (2) Stage — Avaliable Stages / SelectedStage* / Unlocked Locals* / Avaliable Locals* *@
            <ShopMenuStage />
            break;

        case "i3":
            @* (3) Expedition — Expedition Toggle* / Current Expedition Stats* / End Expedition Gains* *@
            <ShopMenuExpedition />
            break;

        case "i5":
            @* (5) Upgrades — Avaliable Expedition Upgrades* / Avaliable Expansion Upgrades / Unlocked Upgrades *@
            <ShopMenuUpgrades />
            break;

        case "i50":
            @* (50) Tech — Knowledge / Avaliable Techs / Unlocked Techs *@
            <ShopMenuTech />
            break;

        case "i97":
            @* () Achievements — Game Statistics / Unlocked / Locked *@
            <ShopMenuGame />
            break;

        case "i98":
            @* () Outside — Real Money Shop? *@
            <div>Outside panel (placeholder)</div>
            break;

        case "i99":
            @* () Settings *@
            <ShopMenuSettings />
            break;

        case "i100":
            @* () Instructions *@
            <ShopMenuTips />
            break;

        default:
            <div>Selecione um painel do menu.</div>
            break;
    }
}
</div>


@code {
    private StageModel? _stage;
    private string? SelectedMenuId;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        UI.Changed += OnUiChanged;
        SelectedMenuId = UI.OpenMenuId;
        RefreshStage();
    }

    protected override void OnGameChanged()
    {
        RefreshStage();
    }

    private void OnUiChanged()
    {
        SelectedMenuId = UI.OpenMenuId;
        InvokeAsync(StateHasChanged);
    }

    private void RefreshStage()
    {
        if (!Game.IsReady || string.IsNullOrWhiteSpace(Game?.CurrentGame.SelectedStageId))
        {
            _stage = null;
            return;
        }

        var g = Game.CurrentGame;
        g.Stages.TryGetValue(Game?.CurrentGame.SelectedStageId, out var st);
        _stage = st;
    }
}

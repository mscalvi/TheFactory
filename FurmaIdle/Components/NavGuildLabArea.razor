@inherits UiHelper

@using System.Linq
@using FurmaIdle.Models
@using FurmaIdle.Data
@using FurmaIdle.Helpers
@using FurmaIdle.Services

@inject IPurchaseService Purchase
@inject ICostService Cost
@inject ILocateService Locate
@inject ITooltipService Tooltips
@inject IUiLogService Log
@inject INotificationService Notifications

<div class="menu-root">
    @if (!Game.IsReady || _stage is null)
    {
        <div class="contracts-placeholder">Stage não Selecionado</div>
    }
    else
    {
        var game = Game.CurrentGame;

        var expansion = Locate.LocateExpansion(game, game.CurrentExpansionId);

        var expansionStats = expansion.ExpansionStats;

        <section class="@($"menu-panel {UI.PanelClass("lab-accumuled")}")">
            <table class="info-table">
                <thead>
                    <tr><th colspan="2">Conhecimentos</th></tr>
                </thead>
                <tbody>
                    @foreach (var knowEntry in expansionStats.Knowledge)
                    {
                        var know = Locate.LocateKnowledge(game, knowEntry.Key);
                        <tr class="info-row">
                            <td class="info-name">@know.Name</td>
                            <td class="info-value">@NumbersHelper.Padronize(knowEntry.Value)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>

        <section class="@($"menu-panel menu-section {UI.PanelClass("lab-knowledge")}")">
            <h3 class="title">Estudos Disponíveis</h3>
            <div class="icon-grid">
                @foreach (var u in _labKnowledge)
                {
                    var can = Cost.CanAfford(ItemHelper.ItemType.Upgrade, u.Id, _stage.Id);
                    <button class="icon-button"
                            disabled="@(!can)"
                            @onmouseenter="() => Tooltips.Show(Tooltips.GetHover(HoverType.Upgrade, u.Id, _stage.Id))"
                            @onmouseleave="Tooltips.Clear"
                            @onclick="() => OnClickBuy(u.Id)">
                        @if (!string.IsNullOrWhiteSpace(u.Icon))
                        {
                            <img src="@u.Icon"
                                 alt="@u.Id"
                                 class="icon-img" />
                        }
                        else
                        {
                            @u.Id
                        }
                    </button>
                }
            </div>
        </section>

        <section class="@($"menu-panel menu-section {UI.PanelClass("lab-techs")}")">
            <h3 class="title">Pesquisas Disponíveis</h3>
            <div class="icon-grid">
                @foreach (var u in _labTech)
                {
                    var can = Cost.CanAfford(ItemHelper.ItemType.Upgrade, u.Id, _stage.Id);
                    <button class="icon-button"
                            disabled="@(!can)"
                            @onmouseenter="() => Tooltips.Show(Tooltips.GetHover(HoverType.Upgrade, u.Id, _stage.Id))"
                            @onmouseleave="Tooltips.Clear"
                            @onclick="() => OnClickBuy(u.Id)">
                        @if (!string.IsNullOrWhiteSpace(u.Icon))
                        {
                            <img src="@u.Icon"
                                 alt="@u.Id"
                                 class="icon-img" />
                        }
                        else
                        {
                            @u.Id
                        }
                    </button>
                }
            </div>
        </section>

        <section class="@($"menu-panel menu-section {UI.PanelClass("lab-upgrades")}")">
            <h3 class="title">Melhorias Disponíveis</h3>
            <div class="icon-grid">
                @foreach (var u in _labUpgrades)
                {
                    var can = Cost.CanAfford(ItemHelper.ItemType.Upgrade, u.Id, _stage.Id);
                    <button class="icon-button"
                            disabled="@(!can)"
                            @onmouseenter="() => Tooltips.Show(Tooltips.GetHover(HoverType.Upgrade, u.Id, _stage.Id))"
                            @onmouseleave="Tooltips.Clear"
                            @onclick="() => OnClickBuy(u.Id)">
                        @if (!string.IsNullOrWhiteSpace(u.Icon))
                        {
                            <img src="@u.Icon"
                                 alt="@u.Id"
                                 class="icon-img" />
                        }
                        else
                        {
                            @u.Id
                        }
                    </button>
                }
            </div>
        </section>
    }
</div>

@code {
    private StageModel? _stage;

    private List<UpgradeModel> _labKnowledge = new();
    private List<UpgradeModel> _labTech = new();
    private List<UpgradeModel> _labUpgrades = new();

    private bool freeProcess = true;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        RefreshStage();
        RebuildLists();
    }

    protected override void OnGameChanged()
    {
        RefreshStage();
        RebuildLists();
    }

    private void RefreshStage()
    {
        if (!Game.IsReady || string.IsNullOrWhiteSpace(Game?.CurrentGame.SelectedStageId))
        {
            _stage = null;
            return;
        }

        var g = Game.CurrentGame;
        g.Stages.TryGetValue(Game?.CurrentGame.SelectedStageId, out var st);
        _stage = st;
    }

    private void RebuildLists()
    {
        if (!Game.IsReady || _stage is null)
            return;

        Notifications.UpdateVisibleUpgrades("guild-lab");

        Notifications.TabsUpgrades.TryGetValue("labKnowledge", out _labKnowledge);
        Notifications.TabsUpgrades.TryGetValue("labTech", out _labTech);
        Notifications.TabsUpgrades.TryGetValue("labUpgrades", out _labUpgrades);
    }

    private async Task OnClickBuy(string upgradeId)
    {
        if (_stage is null)
            return;

        var stageId = _stage.Id;

        if (!Cost.CanAfford(ItemHelper.ItemType.Upgrade, upgradeId, stageId))
        {
            Log.Error($"Sem recursos para comprar upgrade {upgradeId}.");
            return;
        }

        if (!freeProcess)
            return;

        freeProcess = false;
        try
        {
            await Purchase.Purchase(ItemHelper.ItemType.Upgrade, upgradeId, stageId);

            var hover = Tooltips.GetHover(HoverType.Upgrade, upgradeId, stageId);

            Tooltips.Show(hover);
        }
        finally
        {
            freeProcess = true;
        }
    }
}

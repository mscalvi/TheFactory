@inherits UiHelper

@using System.Linq
@using FurmaIdle.Models
@using FurmaIdle.Data
@using FurmaIdle.Helpers
@using FurmaIdle.Services

@inject IPurchaseService Purchase
@inject ICostService Cost
@inject ILocateService Locate
@inject ITooltipService Tooltips
@inject IUiLogService Log
@inject INotificationService Notifications

<div class="menu-root">
    @if (!Game.IsReady || _stage is null)
    {
        <div class="contracts-placeholder">Stage não Selecionado</div>
    }
    else
    {
        <section class="@($"menu-panel menu-section {UI.PanelClass("lab-knowledge")}")">
            <h3 class="title">Estudos Disponíveis</h3>
            <div class="icon-grid">
                @foreach (var u in _knowledgeUpgrades)
                {
                    var can = Cost.CanAfford(ItemHelper.ItemType.Upgrade, u.Id, _stage.Id);
                    <button class="icon-button"
                            disabled="@(!can)"
                            @onmouseenter="() => Tooltips.Show(Tooltips.GetHover(HoverType.Upgrade, u.Id, _stage.Id))"
                            @onmouseleave="Tooltips.Clear"
                            @onclick="() => OnClickBuy(u.Id)">
                        @if (!string.IsNullOrWhiteSpace(u.Icon))
                        {
                            <img src="@u.Icon"
                                 alt="@u.Id"
                                 class="icon-img" />
                        }
                        else
                        {
                            @u.Id
                        }
                    </button>
                }
            </div>
        </section>

        <section class="@($"menu-panel menu-section {UI.PanelClass("lab-techs")}")">
            <h3 class="title">Pesquisas Disponíveis</h3>
            <div class="icon-grid">
                @foreach (var u in _techUpgrades)
                {
                    var can = Cost.CanAfford(ItemHelper.ItemType.Upgrade, u.Id, _stage.Id);
                    <button class="icon-button"
                            disabled="@(!can)"
                            @onmouseenter="() => Tooltips.Show(Tooltips.GetHover(HoverType.Upgrade, u.Id, _stage.Id))"
                            @onmouseleave="Tooltips.Clear"
                            @onclick="() => OnClickBuy(u.Id)">
                        @if (!string.IsNullOrWhiteSpace(u.Icon))
                        {
                            <img src="@u.Icon"
                                 alt="@u.Id"
                                 class="icon-img" />
                        }
                        else
                        {
                            @u.Id
                        }
                    </button>
                }
            </div>
        </section>

        <section class="@($"menu-panel menu-section {UI.PanelClass("lab-upgrades")}")">
            <h3 class="title">Melhorias Disponíveis</h3>
            <div class="icon-grid">
                @foreach (var u in _upgradeUpgrades)
                {
                    var can = Cost.CanAfford(ItemHelper.ItemType.Upgrade, u.Id, _stage.Id);
                    <button class="icon-button"
                            disabled="@(!can)"
                            @onmouseenter="() => Tooltips.Show(Tooltips.GetHover(HoverType.Upgrade, u.Id, _stage.Id))"
                            @onmouseleave="Tooltips.Clear"
                            @onclick="() => OnClickBuy(u.Id)">
                        @if (!string.IsNullOrWhiteSpace(u.Icon))
                        {
                            <img src="@u.Icon"
                                 alt="@u.Id"
                                 class="icon-img" />
                        }
                        else
                        {
                            @u.Id
                        }
                    </button>
                }
            </div>
        </section>
    }
</div>

@code {
    private StageModel? _stage;

    private List<UpgradeModel> _knowledgeUpgrades = new();
    private List<UpgradeModel> _techUpgrades = new();
    private List<UpgradeModel> _upgradeUpgrades = new();

    private bool freeProcess = true;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        RefreshStage();
        RebuildLists();
    }

    protected override void OnGameChanged()
    {
        RefreshStage();
        RebuildLists();
    }

    private void RefreshStage()
    {
        if (!Game.IsReady || string.IsNullOrWhiteSpace(Game?.CurrentGame.SelectedStageId))
        {
            _stage = null;
            _knowledgeUpgrades.Clear();
            _techUpgrades.Clear();
            _upgradeUpgrades.Clear();
            return;
        }

        var g = Game.CurrentGame;
        g.Stages.TryGetValue(Game?.CurrentGame.SelectedStageId, out var st);
        _stage = st;
    }

    private void RebuildLists()
    {
        _knowledgeUpgrades.Clear();
        _techUpgrades.Clear();
        _upgradeUpgrades.Clear();

        if (!Game.IsReady || _stage is null)
            return;

        var game = Game.CurrentGame;
        var stage = _stage;
        var all = OrderedUpgrades(game);

        _knowledgeUpgrades = all
            .Where(u =>
                u.State == UnlockHelper.State.Available &&
                u.TabId == "guild-lab-knowledge" &&
                Notifications.IsUpgradeVisible(game, stage, u) &&
                (u.StageId == stage.Id || u.StageId == "all"))
            .ToList();

        _techUpgrades = all
            .Where(u =>
                u.State == UnlockHelper.State.Available &&
                u.TabId == "guild-lab-techs" &&
                Notifications.IsUpgradeVisible(game, stage, u) &&
                (u.StageId == stage.Id || u.StageId == "all"))
            .ToList();

        _upgradeUpgrades = all
            .Where(u =>
                u.State == UnlockHelper.State.Available &&
                u.TabId == "guild-lab-upgrades" &&
                Notifications.IsUpgradeVisible(game, stage, u) &&
                (u.StageId == stage.Id || u.StageId == "all"))
            .ToList();

        var totalVisible =
            _knowledgeUpgrades.Count +
            _techUpgrades.Count +
            _upgradeUpgrades.Count;

        Notifications.UpdateVisibleUpgrades("guild-lab", totalVisible);
    }

    private (long atual, long total) Total(string kId)
    {
        long total = 0;
        long atual = 0;

        var game = Game.CurrentGame;
        var expansion = Locate.LocateExpansion(game, game.CurrentExpansionId);

        expansion.ExpansionStats.Knowledge.TryGetValue(kId, out var value);
        atual = value;

        expansion.ExpansionStats.KnowledgeGain.TryGetValue(kId, out var tot);
        total = tot;

        return (atual, total);
    }

    private static IEnumerable<UpgradeModel> OrderedUpgrades(GameModel g)
        => g.Upgrades.Values
            .OrderBy(u => u.Id);

    private async Task OnClickBuy(string upgradeId)
    {
        if (_stage is null)
            return;

        var stageId = _stage.Id;

        if (!Cost.CanAfford(ItemHelper.ItemType.Upgrade, upgradeId, stageId))
        {
            Log.Error($"Sem recursos para comprar upgrade {upgradeId}.");
            return;
        }

        if (!freeProcess)
            return;

        freeProcess = false;
        try
        {
            await Purchase.Purchase(ItemHelper.ItemType.Upgrade, upgradeId, stageId);

            var hover = Tooltips.GetHover(HoverType.Upgrade, upgradeId, stageId);

            Tooltips.Show(hover);
        }
        finally
        {
            freeProcess = true;
        }
    }
}

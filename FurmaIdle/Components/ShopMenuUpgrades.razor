@* Components/ShopMenuUpgrades.razor *@
@inherits UiHelper

@using System.Linq
@using FurmaIdle.Models
@using FurmaIdle.Data
@using FurmaIdle.Helpers
@using FurmaIdle.Services

@inject IPurchaseService Purchase
@inject IExpeditionService Expedition
@inject ICostService Cost
@inject IContractsService Contracts
@inject ILocateService Locate
@inject ITooltipService Tooltips
@inject IUiLogService Log

@if (!Game.IsReady || _stage is null)
{
    <div class="contracts-placeholder">Stage não Selecionado</div>
}
else
{
    var game = Game.CurrentGame;

    var availableExpeditionUpgrades = OrderedUpgrades(game)
        .Where(u => (StartsWithUc(u.Id) || StartsWithUi(u.Id))
                 && u.State == UnlockHelper.State.Available
                 && IsContractUpgradeVisible(game, u.Id));

    var availableExpansionUpgrades = OrderedUpgrades(game)
        .Where(u => (!StartsWithUc(u.Id) && !StartsWithUp(u.Id) && !StartsWithUi(u.Id))
                 && u.State == UnlockHelper.State.Available
                 && IsContractUpgradeVisible(game, u.Id));

    var availableCharacterUpgrades = OrderedUpgrades(game)
            .Where(u => u?.Id != null
                     && u.Id.StartsWith("up", StringComparison.OrdinalIgnoreCase)
                     && u.State == UnlockHelper.State.Available)
            .OrderBy(u => u.Id);

    // ===== Unlocked Upgrades =====
    var unlockedUpgrades = OrderedUpgrades(game)
        .Where(u => u.State == UnlockHelper.State.Unlocked);

    <!-- Available Characters -->
    <div>
        <h3>Characters for Hire</h3>
        @if (!availableCharacterUpgrades.Any())
        {
            <div>Nenhum upgrade de personagem disponível.</div>
        }
        else
        {
            <div>
                @foreach (var u in availableCharacterUpgrades)
                {
                    var id = u.Id;
                    var canBuy = Cost.CanAfford(ItemHelper.ItemType.Upgrade, id, _stage.Id);

                    <button type="button"
                            class="icon-button"
                            disabled="@( !canBuy )"
                            @onclick="() => OnClickBuyUpgrade(id)"
                            @onmouseenter="() => Tooltips.Show(Tooltips.GetHover(HoverType.Upgrade, id, _stage.Id))"
                            @onmouseleave="Tooltips.Clear"
                            @onfocus="() => Tooltips.Show(Tooltips.GetHover(HoverType.Upgrade, id, _stage.Id))"
                            @onblur="Tooltips.Clear">
                        @id
                    </button>
                }
            </div>
        }
    </div>

    <!-- (1) Available Expedition Upgrades* (uc...) -->
    <div>
        <h3>Available Expedition Upgrades</h3>
        @if (!availableExpeditionUpgrades.Any())
        {
            <div>Nenhum upgrade de expedição disponível.</div>
        }
        else
        {
            <div>
                @foreach (var u in availableExpeditionUpgrades)
                {
                    var id = u.Id;
                    var canBuy = Cost.CanAfford(ItemHelper.ItemType.Upgrade, id, _stage.Id);
                    <button type="button"
                            class="icon-button"
                            disabled="@( !canBuy )"
                            @onclick="() => OnClickBuyUpgrade(id)"
                            @onmouseenter="() => Tooltips.Show(Tooltips.GetHover(HoverType.Upgrade, id, _stage.Id))"
                            @onmouseleave="Tooltips.Clear"
                            @onfocus="() => Tooltips.Show(Tooltips.GetHover(HoverType.Upgrade, id, _stage.Id))"
                            @onblur="Tooltips.Clear">
                        @id
                    </button>
                }
            </div>
        }
    </div>

    <!-- (2) Available Expansion Upgrades (ut/ux) -->
    <div>
        <h3>Available Expansion Upgrades</h3>
        @if (!availableExpansionUpgrades.Any())
        {
            <div>Nenhum upgrade de expansão disponível.</div>
        }
        else
        {
            <div>
                @foreach (var u in availableExpansionUpgrades)
                {
                    var id = u.Id;
                    var canBuy = Cost.CanAfford(ItemHelper.ItemType.Upgrade, id, _stage.Id);
                    <button type="button"
                            class="icon-button"
                            disabled="@( !canBuy )"
                            @onclick="() => OnClickBuyUpgrade(id)"
                            @onmouseenter="() => Tooltips.Show(Tooltips.GetHover(HoverType.Upgrade, id, _stage.Id))"
                            @onmouseleave="Tooltips.Clear"
                            @onfocus="() => Tooltips.Show(Tooltips.GetHover(HoverType.Upgrade, id, _stage.Id))"
                            @onblur="Tooltips.Clear">
                        @id
                    </button>
                }
            </div>
        }
    </div>

    <!-- (3) Unlocked Upgrades (uc+ut+ux) -->
    <div>
        <h3>Unlocked Upgrades</h3>
        @if (!unlockedUpgrades.Any())
        {
            <div>Nenhum upgrade concluído.</div>
        }
        else
        {
            <div>
                @foreach (var u in unlockedUpgrades)
                {
                    var id = u.Id;
                    <button type="button"
                            class="icon-button"
                            disabled
                            @onmouseenter="() => Tooltips.Show(Tooltips.GetHover(HoverType.Upgrade, id, _stage.Id))"
                            @onmouseleave="Tooltips.Clear"
                            @onfocus="() => Tooltips.Show(Tooltips.GetHover(HoverType.Upgrade, id, _stage.Id))"
                            @onblur="Tooltips.Clear">
                        @id
                    </button>
                }
            </div>
        }
    </div>
}

@code {
    private StageModel? _stage;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        RefreshStage();
    }

    protected override void OnGameChanged()
    {
        RefreshStage();
    }

    private void RefreshStage()
    {
        if (!Game.IsReady || string.IsNullOrWhiteSpace(Game?.CurrentGame.SelectedStageId))
        {
            _stage = null;
            return;
        }

        var g = Game.CurrentGame;
        g.Stages.TryGetValue(Game?.CurrentGame.SelectedStageId, out var st);
        _stage = st;
    }

    private bool freeProcess = true;

    // ===== Helpers de ordenação/filtragem =====
    private static IEnumerable<UpgradeModel> OrderedUpgrades(GameModel g)
        => g.Upgrades.Values
            .OrderBy(u => u.Id);

    private static bool StartsWithUc(string id)
        => id?.StartsWith("uc", StringComparison.OrdinalIgnoreCase) == true;

    private static bool StartsWithUr(string id)
        => id?.StartsWith("ur", StringComparison.OrdinalIgnoreCase) == true;

    private static bool StartsWithUt(string id)
        => id?.StartsWith("ut", StringComparison.OrdinalIgnoreCase) == true;

    private static bool StartsWithUl(string id)
        => id?.StartsWith("ul", StringComparison.OrdinalIgnoreCase) == true;

    private static bool StartsWithUk(string id)
        => id?.StartsWith("uk", StringComparison.OrdinalIgnoreCase) == true;

    private static bool StartsWithUx(string id)
        => id?.StartsWith("ux", StringComparison.OrdinalIgnoreCase) == true;

    private static bool StartsWithUu(string id)
        => id?.StartsWith("uu", StringComparison.OrdinalIgnoreCase) == true;

    private static bool StartsWithUp(string id)
        => id?.StartsWith("up", StringComparison.OrdinalIgnoreCase) == true;

    private static bool StartsWithUi(string id)
        => id?.StartsWith("ui", StringComparison.OrdinalIgnoreCase) == true;

    private static bool StartsWithUe(string id)
        => id?.StartsWith("ue", StringComparison.OrdinalIgnoreCase) == true;

    // “Unlock-any” = upgrades de desbloqueio que não queremos listar em “Unlocked Upgrades”
    private static bool IsUnlockAny(UpgradeModel u)
    {
        var id = u.Id ?? string.Empty;
        return true;
    }

    // Mesma regra que você já usava
    private bool IsContractUpgradeVisible(GameModel game, string upgradeId)
    {
        // uc/uu tem visibilidade condicionada ao estado do contrato no Stage selecionado
        if (!StartsWithUc(upgradeId) && !StartsWithUu(upgradeId) && !StartsWithUt(upgradeId)) return true;

        var up = Locate.LocateUpgrade(game, upgradeId);

        if (StartsWithUc(upgradeId))
        {
            if (_stage.ActiveContracts.TryGetValue(up.TargetId, out var qty))
            {
                if (qty > 0)
                {
                    var nextBuy = Math.Max(1, (up.ActualBuy) + 1);
                    var maxBuy = up.MaxBuy <= 0 ? int.MaxValue : up.MaxBuy;

                    var step = up.EffectType switch
                    {
                        EffectHelper.EffectType.ContractCost => 25,
                        EffectHelper.EffectType.ContractGain => 5,
                        EffectHelper.EffectType.ContractTime => 5,
                        _ => 0
                    };
                    if (step <= 0) return true;

                    var needed = step * nextBuy;
                    return qty >= needed;
                }
            }
            return false;
        }
        else if (StartsWithUu(upgradeId))
        {
            // “uu”: visível se o nível atual de contrato for >= nível do upgrade
            var stageInfo = Contracts.GetStageInfo(game, _stage.Id);
            var upgrade = Locate.LocateUpgrade(game, upgradeId);
            if (upgrade.Level > stageInfo.ContractsLevel)
            {
                return false;
            } else
            {
                return true;
            }
        }
        else if (StartsWithUt(upgradeId))
        {
            var isContractTarget = up.TargetId?.StartsWith("c", StringComparison.OrdinalIgnoreCase) ?? false;
            if (!isContractTarget) return true;

            if (_stage.ActiveContracts.TryGetValue(up.TargetId, out var qty))
            {
                if (qty > 0)
                {
                    return true;
                }
            }
            return false;
        }

        return true;
    }

    // ===== Ações =====
    private async Task OnClickBuyUpgrade(string upgradeId)
    {
        var game = Game.CurrentGame;
        var upgrade = Locate.LocateUpgrade(game, upgradeId);

        if (!Cost.CanAfford(ItemHelper.ItemType.Upgrade, upgrade.Id, _stage.Id))
        {
            Log.Error($"Sem recursos para comprar upgrade {upgradeId}.");
            return;
        }

        if (StartsWithUc(upgrade.Id))
        {
            if (upgrade is null || string.IsNullOrWhiteSpace(upgrade.TargetId)) return;

            var nextBuy = Math.Max(1, upgrade.ActualBuy + 1);
            var maxBuy = upgrade.MaxBuy <= 0 ? int.MaxValue : upgrade.MaxBuy;
            if (nextBuy > maxBuy) return;

            if (!(_stage.ActiveContracts?.TryGetValue(upgrade.TargetId, out var qty) ?? false) || qty <= 0)
                return;

            var step = upgrade.EffectType switch
            {
                EffectHelper.EffectType.ContractCost => 25,
                EffectHelper.EffectType.ContractGain => 5,
                EffectHelper.EffectType.ContractTime => 5,
                _ => 0
            };

            if (step > 0)
            {
                var needed = step * nextBuy;
                if (qty < needed) return;
            }
        }

        if (freeProcess)
        {
            freeProcess = false;
            await Purchase.Purchase(ItemHelper.ItemType.Upgrade, upgradeId, _stage.Id);
            if (StartsWithUe(upgrade.Id))
            {
                await Expedition.EndExpansion(Game.CurrentGame.CurrentExpansionId);
            }
            freeProcess = true;
        }
        else
        {
            return;
        }
    }
}

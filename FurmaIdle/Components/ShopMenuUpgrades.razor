@* Components/ShopMenuUpgrades.razor *@
@inherits UiHelper

@using System.Linq
@using FurmaIdle.Models
@using FurmaIdle.Data
@using FurmaIdle.Helpers
@using FurmaIdle.Services

@inject IPurchaseService Purchase
@inject IExpeditionService Expedition
@inject ICostService Cost
@inject IContractsService Contracts
@inject ILocateService Locate
@inject ITooltipService Tooltips
@inject IUiLogService Log
@inject ISpecialtiesService Specialty;

<div class="menu-root">
@if (!Game.IsReady || _stage is null)
{
        <div class="contracts-placeholder">Stage não Selecionado</div>
    }
    else
    {
        var game = Game.CurrentGame;

        var all = OrderedUpgrades(game);
        var heroUpgrade =
        all.FirstOrDefault(u =>
        u.State == UnlockHelper.State.Available &&
        (Ue(u.Id) || Us(u.Id)));

        // ==== ÁREA 2 — Permanentes (UP, UL, UR, UK, UA, UU) ====
        var permanents =
            all.Where(u =>
            u.State == UnlockHelper.State.Available &&
            (Up(u.Id) || Ul(u.Id) || Ur(u.Id) || Uk(u.Id) || Ua(u.Id) || Uu(u.Id)) &&
            IsContractUpgradeVisible(game, u.Id))
            .ToList();

        // ==== ÁREA 3 — Avanços da Expansão (UT, UX, UM, UB) ====
        var expansionUps =
            all.Where(u =>
            u.State == UnlockHelper.State.Available &&
            (Ut(u.Id) || Ux(u.Id) || Um(u.Id) || Ub(u.Id)) &&
            IsContractUpgradeVisible(game, u.Id))
            .ToList();

        // ==== ÁREA 4 — Avanços da Expedição (UC, UI) ====
        var expeditionUps =
            all.Where(u =>
            u.State == UnlockHelper.State.Available &&
            (Uc(u.Id) || Ui(u.Id)) &&
            IsContractUpgradeVisible(game, u.Id))
            .ToList();

        var specActive = IsSpecActive();

        <section class="@($"menu-panel {UI.PanelClass("up-objetive")}")">
            @if (heroUpgrade is not null)
            {
                var can = Cost.CanAfford(ItemHelper.ItemType.Upgrade, heroUpgrade.Id, _stage.Id) && !specActive;
                <button class="objetive-button"
                        disabled="@(!can)"
                        @onclick="() => OnClickBuyUpgrade(heroUpgrade.Id)"
                        @onmouseenter="() => Tooltips.Show(Tooltips.GetHover(HoverType.Upgrade, heroUpgrade.Id, _stage.Id))"
                        @onmouseleave="Tooltips.Clear">
                    @heroUpgrade.Id
                </button>
            }
            else
            {
                <div style="text-align:center; opacity:.75;">Fim de Jogo - por enquanto</div>
            }
        </section>

        <section class="@($"menu-panel menu-section {UI.PanelClass("up-expedition")}")">
            <h3 class="title">Melhorias da Expedição</h3>
            <div class="icon-grid">
                @foreach (var u in expeditionUps)
                {
                    var can = Cost.CanAfford(ItemHelper.ItemType.Upgrade, u.Id, _stage.Id);
                    <button class="icon-button" disabled="@(!can)"
                            @onclick="() => OnClickBuyUpgrade(u.Id)"
                            @onmouseenter="() => Tooltips.Show(Tooltips.GetHover(HoverType.Upgrade, u.Id, _stage.Id))"
                            @onmouseleave="Tooltips.Clear">
                        @u.Id
                    </button>
                }
            </div>
        </section>

        <section class="@($"menu-panel menu-section {UI.PanelClass("up-expansion")}")">
            <h3 class="title">Melhorias da Expansão</h3>
            <div class="icon-grid">
                @foreach (var u in expansionUps)
                {
                    var can = Cost.CanAfford(ItemHelper.ItemType.Upgrade, u.Id, _stage.Id);
                    <button class="icon-button" disabled="@(!can)"
                            @onclick="() => OnClickBuyUpgrade(u.Id)"
                            @onmouseenter="() => Tooltips.Show(Tooltips.GetHover(HoverType.Upgrade, u.Id, _stage.Id))"
                            @onmouseleave="Tooltips.Clear">
                        @u.Id
                    </button>
                }
            </div>
        </section>
        
        <section class="@($"menu-panel menu-section {UI.PanelClass("up-permanents")}")">
            <h3 class="title">Desbloqueios Permanentes</h3>
            <div class="icon-grid">
                @foreach (var u in permanents)
                {
                    var can = Cost.CanAfford(ItemHelper.ItemType.Upgrade, u.Id, _stage.Id);
                    <button class="icon-button" disabled="@(!can)"
                            @onclick="() => OnClickBuyUpgrade(u.Id)"
                            @onmouseenter="() => Tooltips.Show(Tooltips.GetHover(HoverType.Upgrade, u.Id, _stage.Id))"
                            @onmouseleave="Tooltips.Clear">
                        @u.Id
                    </button>
                }
            </div>
        </section>
}
</div>

@code {
    private StageModel? _stage;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        RefreshStage();
    }

    protected override void OnGameChanged()
    {
        RefreshStage();
    }

    private void RefreshStage()
    {
        if (!Game.IsReady || string.IsNullOrWhiteSpace(Game?.CurrentGame.SelectedStageId))
        {
            _stage = null;
            return;
        }

        var g = Game.CurrentGame;
        g.Stages.TryGetValue(Game?.CurrentGame.SelectedStageId, out var st);
        _stage = st;
    }

    private bool freeProcess = true;

    // ===== Helpers de ordenação/filtragem =====
    private static IEnumerable<UpgradeModel> OrderedUpgrades(GameModel g)
        => g.Upgrades.Values
            .OrderBy(u => u.Id);

    static bool StartsWith(string? id, string prefix)
        => id?.StartsWith(prefix, StringComparison.OrdinalIgnoreCase) == true;

    static bool Ue(string? id) => StartsWith(id, "ue");
    static bool Us(string? id) => StartsWith(id, "us");
    static bool Up(string? id) => StartsWith(id, "up");
    static bool Ul(string? id) => StartsWith(id, "ul");
    static bool Ur(string? id) => StartsWith(id, "ur");
    static bool Uk(string? id) => StartsWith(id, "uk");
    static bool Ut(string? id) => StartsWith(id, "ut");
    static bool Ux(string? id) => StartsWith(id, "ux");
    static bool Uc(string? id) => StartsWith(id, "uc");
    static bool Ui(string? id) => StartsWith(id, "ui");
    static bool Um(string? id) => StartsWith(id, "um");
    static bool Ua(string? id) => StartsWith(id, "ua");
    static bool Ub(string? id) => StartsWith(id, "ub");
    static bool Uu(string? id) => StartsWith(id, "uu");

    private bool IsContractUpgradeVisible(GameModel game, string upgradeId)
    {
        // uc/uu tem visibilidade condicionada ao estado do contrato no Stage selecionado
        if (!StartsWith(upgradeId, "uc") && !StartsWith(upgradeId,"uu") && !StartsWith(upgradeId,"ut")) return true;

        var up = Locate.LocateUpgrade(game, upgradeId);

        if (StartsWith(upgradeId, "uc"))
        {
            if (_stage.ActiveContracts.TryGetValue(up.TargetId, out var qty))
            {
                if (qty > 0)
                {
                    var nextBuy = Math.Max(1, (up.ActualBuy) + 1);
                    var maxBuy = up.MaxBuy <= 0 ? int.MaxValue : up.MaxBuy;

                    var step = up.EffectType switch
                    {
                        EffectHelper.EffectType.ContractCost => 25,
                        EffectHelper.EffectType.ContractGain => 5,
                        EffectHelper.EffectType.ContractTime => 5,
                        _ => 0
                    };
                    if (step <= 0) return true;

                    var needed = step * nextBuy;
                    return qty >= needed;
                }
            }
            return false;
        }
        else if (StartsWith(upgradeId, "uu"))
        {
            // “uu”: visível se o nível atual de contrato for >= nível do upgrade
            var stageInfo = Contracts.GetStageInfo(game, _stage.Id);
            var upgrade = Locate.LocateUpgrade(game, upgradeId);
            if (upgrade.Level > stageInfo.ContractsLevel)
            {
                return false;
            } else
            {
                return true;
            }
        }
        else if (StartsWith(upgradeId, "ut"))
        {
            var isContractTarget = up.TargetId?.StartsWith("c", StringComparison.OrdinalIgnoreCase) ?? false;
            if (!isContractTarget) return true;

            if (_stage.ActiveContracts.TryGetValue(up.TargetId, out var qty))
            {
                if (qty > 0)
                {
                    return true;
                }
            }
            return false;
        }
        return true;
    }

    // ===== Ações =====
    private async Task OnClickBuyUpgrade(string upgradeId)
    {
        var game = Game.CurrentGame;
        var upgrade = Locate.LocateUpgrade(game, upgradeId);

        if (!Cost.CanAfford(ItemHelper.ItemType.Upgrade, upgrade.Id, _stage.Id))
        {
            Log.Error($"Sem recursos para comprar upgrade {upgradeId}.");
            return;
        }

        if (StartsWith(upgrade.Id, "uc"))
        {
            if (upgrade is null || string.IsNullOrWhiteSpace(upgrade.TargetId)) return;

            var nextBuy = Math.Max(1, upgrade.ActualBuy + 1);
            var maxBuy = upgrade.MaxBuy <= 0 ? int.MaxValue : upgrade.MaxBuy;
            if (nextBuy > maxBuy) return;

            if (!(_stage.ActiveContracts?.TryGetValue(upgrade.TargetId, out var qty) ?? false) || qty <= 0)
                return;

            var step = upgrade.EffectType switch
            {
                EffectHelper.EffectType.ContractCost => 25,
                EffectHelper.EffectType.ContractGain => 5,
                EffectHelper.EffectType.ContractTime => 5,
                _ => 0
            };

            if (step > 0)
            {
                var needed = step * nextBuy;
                if (qty < needed) return;
            }
        }

        if (freeProcess)
        {
            freeProcess = false;

            await Purchase.Purchase(ItemHelper.ItemType.Upgrade, upgradeId, _stage.Id);

            if (StartsWith(upgrade.Id, "ue"))
            {
                await Expedition.EndExpansion(Game.CurrentGame.CurrentExpansionId);
            }

            freeProcess = true;
        }
        else
        {
            return;
        }
    }

    bool IsSpecActive()
    {
        foreach (var spec in Game.CurrentGame.Specialties.Values)
        {
            var timer = Specialty.GetSpecialtyTimer(spec);
            if (timer.Actual > 0)
            {
                return true;
            }
        }

        return false;
    }
}

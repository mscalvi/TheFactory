@* Components/ShopMenuExpansion.razor *@
@inherits UiHelper

@using FurmaIdle.Helpers
@using FurmaIdle.Models
@using FurmaIdle.Services
@using FurmaIdle.Data

@inject ITooltipService Tooltips
@inject IUiLogService Log
@inject ILocateService Locate
@inject IExpeditionService Expedition

<div class="menu-root">
@if (!Game.IsReady || _stage is null)
{
    <div class="contracts-placeholder">Stage não Selecionado</div>
}
else{
    var game = Game.CurrentGame;

    ExpansionModel expansion = Locate.LocateExpansion(game, game.CurrentExpansionId);

    var expansionStats = expansion.ExpansionStats;

    var chars = game.Characters?.Values ?? Enumerable.Empty<CharacterModel>();

    TimeSpan? expDuration = null;
    if (expansion.StartedAt is DateTimeOffset startedAt)
        expDuration = DateTimeOffset.UtcNow - startedAt;

    var inBase = chars.Where(c => c.State == UnlockHelper.State.Unlocked
                               && c.CharState == UnlockHelper.CharState.InBase)
                      .OrderBy(c => c.Id)
                      .ToList();

    var inStage = chars.Where(c => c.State == UnlockHelper.State.Unlocked
                                && c.CharState == UnlockHelper.CharState.InStage)
                       .OrderBy(c => c.Id)
                       .ToList();

    var unlockedUpgrades = OrderedUpgrades(game)
            .Where(u => u?.Id != null
                    && !u.Id.StartsWith("up", StringComparison.OrdinalIgnoreCase)
                    && !u.Id.StartsWith("uh", StringComparison.OrdinalIgnoreCase)
                    && !u.Id.StartsWith("uk", StringComparison.OrdinalIgnoreCase)
                    && !u.Id.StartsWith("ul", StringComparison.OrdinalIgnoreCase)
                    && !u.Id.StartsWith("ue", StringComparison.OrdinalIgnoreCase)
                    && !u.Id.StartsWith("us", StringComparison.OrdinalIgnoreCase)
                    && !u.Id.StartsWith("ur", StringComparison.OrdinalIgnoreCase)
                    && !u.Id.StartsWith("uc", StringComparison.OrdinalIgnoreCase)
                    && !u.Id.StartsWith("uu", StringComparison.OrdinalIgnoreCase)
                    && !u.Id.StartsWith("ua", StringComparison.OrdinalIgnoreCase)
                    && u.State == UnlockHelper.State.Unlocked);


        <section class="@($"menu-panel {UI.PanelClass("expansion-status")}")">
            <h3 class="title">Expansão Atual</h3>
            <table class="info-table">
                <thead>
                    <tr><th colspan="2">@expansion.Name</th></tr>
                    <tr><th colspan="2">@((expDuration?.ToString("hh\\:mm\\:ss")) ?? "--:--:--")</th></tr>
                </thead>
                <tbody>
                    @foreach (var coin in expansionStats.CoinsGain)
                    {
                        <tr class="info-row">
                            <td class="info-name">@coin.Key</td>
                            <td class="info-value">@coin.Value.ToString("N0")</td>
                        </tr>
                    }
                    @foreach (var resource in expansionStats.ResourcesGain)
                    {
                        <tr class="info-row">
                            <td class="info-name">@resource.Key</td>
                            <td class="info-value">@resource.Value.ToString("N0")</td>
                        </tr>
                    }
                    @foreach (var know in expansionStats.KnowledgeGain)
                    {
                        <tr class="info-row">
                            <td class="info-name">@know.Key</td>
                            <td class="info-value">@know.Value.ToString("N0")</td>
                        </tr>
                    }
                    @foreach (var click in expansionStats.ClicksMade)
                    {
                        <tr class="info-row">
                            <td class="info-name">@click.Key</td>
                            <td class="info-value">@click.Value.ToString("N0")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>

        <section class="@($"menu-panel menu-section {UI.PanelClass("expansion-basechars")}")">
            <h3 class="title">Personagens na Base</h3>
            @if (inBase.Count == 0)
            {
                <div>Ninguém na base.</div>
            }
            else
            {
                <div class="icon-grid">
                    @foreach (var ch in inBase)
                    {
                        var id = ch.Id;
                        <button type="button"
                                class="icon-button"
                                disabled
                                @onmouseenter="() => Tooltips.Show(Tooltips.GetHover(HoverType.Character, id, game.SelectedStageId))"
                                @onmouseleave="Tooltips.Clear"
                                @onfocus="() => Tooltips.Show(Tooltips.GetHover(HoverType.Character, id, game.SelectedStageId))"
                                @onblur="Tooltips.Clear">
                            @if (!string.IsNullOrWhiteSpace(ch.Icon))
                            {
                                <img src="@ch.Icon"
                                     alt="@ch.Id"
                                     class="icon-img" />
                            }
                            else
                            {
                                @ch.Id
                            }
                        </button>
                    }
                </div>
            }
        </section>

        <section class="@($"menu-panel menu-section {UI.PanelClass("expansion-stagechars")}")">
            <h3 class="title">Personagens em Expedição</h3>
            @if (inStage.Count == 0)
            {
                <div>Ninguém em Expedição.</div>
            }
            else
            {
                <div class="icon-grid">
                    @foreach (var ch in inStage)
                    {
                        var id = ch.Id;
                        <button type="button"
                                class="icon-button"
                                disabled
                                @onmouseenter="() => Tooltips.Show(Tooltips.GetHover(HoverType.Character, id, game.SelectedStageId))"
                                @onmouseleave="Tooltips.Clear"
                                @onfocus="() => Tooltips.Show(Tooltips.GetHover(HoverType.Character, id, game.SelectedStageId))"
                                @onblur="Tooltips.Clear">
                            @if (!string.IsNullOrWhiteSpace(ch.Icon))
                            {
                                <img src="@ch.Icon"
                                     alt="@ch.Id"
                                     class="icon-img" />
                            }
                            else
                            {
                                @ch.Id
                            }
                        </button>
                    }
                </div>
            }
        </section>

        <section class="@($"menu-panel menu-section {UI.PanelClass("expansion-upgrades")}")">
            <h3 class="title">Upgrades da Expansão</h3>
            @if (!unlockedUpgrades.Any())
            {
                <div>Nenhum upgrade concluído.</div>
            }
            else
            {
                <div class="icon-grid">
                    @foreach (var u in unlockedUpgrades)
                    {
                        var id = u.Id;
                        <button type="button"
                                class="icon-button"
                                disabled
                                @onmouseenter="() => Tooltips.Show(Tooltips.GetHover(HoverType.Upgrade, id, _stage.Id))"
                                @onmouseleave="Tooltips.Clear"
                                @onfocus="() => Tooltips.Show(Tooltips.GetHover(HoverType.Upgrade, id, _stage.Id))"
                                @onblur="Tooltips.Clear">
                            @if (!string.IsNullOrWhiteSpace(u.Icon))
                            {
                                <img src="@u.Icon"
                                     alt="@u.Id"
                                     class="icon-img" />
                            }
                            else
                            {
                                @u.Id
                            }
                        </button>
                    }
                </div>
            }
        </section>
}

</div>

@code {
    private StageModel? _stage;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        RefreshStage();
    }

    protected override void OnGameChanged()
    {
        RefreshStage();
    }

    private void RefreshStage()
    {
        if (!Game.IsReady || string.IsNullOrWhiteSpace(Game?.CurrentGame.SelectedStageId))
        {
            _stage = null;
            return;
        }

        var g = Game.CurrentGame;
        g.Stages.TryGetValue(Game?.CurrentGame.SelectedStageId, out var st);
        _stage = st;
    }

    private static IEnumerable<UpgradeModel> OrderedUpgrades(GameModel g)
        => g.Upgrades.Values
            .OrderBy(u => u.Id);
}
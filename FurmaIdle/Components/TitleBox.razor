@using FurmaIdle.Models
@using FurmaIdle.Services

@inject ICurrentGameService Game

@if (LoadGameReady())
{
    <p>Carregando…</p>
}
else
{
    <div class="title-box">
        <h1>FurmaIdle - Exploradores de Furma</h1>
        <p>Versão: @Game.CurrentGame?.SchemaVersion</p>
    </div>
}

@code {

    private bool LoadGameReady()
    {
        GameModel CurrentGame = Game.CurrentGame;
        if (CurrentGame.On)
        {
            Game.GameChanged += OnGameChanged;
            return true;
        }
        else
        {
            return false;
        }
    }

    void OnGameChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Game.GameChanged -= OnGameChanged;
}

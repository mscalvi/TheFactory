@inherits UiHelper

@using System.Linq
@using FurmaIdle.Models
@using FurmaIdle.Data
@using FurmaIdle.Helpers
@using FurmaIdle.Services

@inject IPurchaseService Purchase
@inject ILocateService Locate
@inject ICostService Cost
@inject ITooltipService Tooltips
@inject IUiLogService Log
@inject INotificationService Notifications
@inject IExpeditionService Expedition

<div class="menu-root">
@if (!Game.IsReady || string.IsNullOrWhiteSpace(_stage.Id) || _stage is null)
{
    <div class="contracts-placeholder">Stage não Selecionado</div>
}
else
{
    var game = Game.CurrentGame;


        <section class="@($"menu-panel {UI.PanelClass("stage-select")}")">
            <h3 class="title">Unlocked Stages</h3>
            @if (!_worldStages.Any())
            {
                <div>Nenhuma Stage desbloqueada.</div>
            }
            else
            {
                <div>
                    @foreach (var stage in _worldStages)
                    {
                        var isSelected = string.Equals(_stage.Id, stage.Id, StringComparison.OrdinalIgnoreCase);

                        <button type="button"
                                class="character-button"
                                disabled="@(isSelected)"
                                aria-pressed="@(isSelected)"
                                @onclick="() => SelectStage(stage.Id)"
                                @onmouseenter="() => Tooltips.Show(Tooltips.GetHover(HoverType.Stage, stage.Id, _stage.Id))"
                                @onmouseleave="Tooltips.Clear"
                                @onfocus="() => Tooltips.Show(Tooltips.GetHover(HoverType.Stage, stage.Id, _stage.Id))"
                                @onblur="Tooltips.Clear"
                                tabindex="0">
                            @if (!string.IsNullOrWhiteSpace(stage.Icon))
                            {
                                <img src="@stage.Icon"
                                     alt="@stage.Id"
                                     class="icon-img" />
                            }
                            else
                            {
                                @stage.Id
                            }
                        </button>
                    }
                </div>
            }
        </section>
}

</div>

@code {
    private StageModel? _stage;

    private List<UpgradeModel> _worldStages = new();

    private bool freeProcess = true;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        RefreshStage();
        RebuildLists();
    }

    protected override void OnGameChanged()
    {
        RefreshStage();
        RebuildLists();
    }

    private void RefreshStage()
    {
        if (!Game.IsReady || string.IsNullOrWhiteSpace(Game?.CurrentGame.SelectedStageId))
        {
            _stage = null;
            return;
        }

        var g = Game.CurrentGame;
        g.Stages.TryGetValue(Game?.CurrentGame.SelectedStageId, out var st);
        _stage = st;
    }

    private void RebuildLists()
    {
        if (!Game.IsReady || _stage is null)
            return;

        Notifications.UpdateVisibleUpgrades("world-map");

        Notifications.TabsUpgrades.TryGetValue("worldStage", out _worldStages);
    }

    // ===== Ações =====
    private async Task SelectStage(string stageId)
    {
        await UI.LoadStage(stageId);
    }

    private async Task OnClickBuy(string upgradeId)
    {
        if (_stage is null)
            return;

        var stageId = _stage.Id;

        var game = Game.CurrentGame;
        var upgrade = Locate.LocateUpgrade(game, upgradeId);

        if (!Cost.CanAfford(ItemHelper.ItemType.Upgrade, upgrade.Id, stageId))
        {
            return;
        }

        if (!freeProcess)
            return;

        freeProcess = false;

        try
        {
            await Purchase.Purchase(ItemHelper.ItemType.Upgrade, upgradeId, stageId);


            if (_stage is not null)
            {
                var hover = Tooltips.GetHover(HoverType.Upgrade, upgradeId, stageId);
                Tooltips.Show(hover);
            }
        }
        finally
        {
            freeProcess = true;
        }
    }
}

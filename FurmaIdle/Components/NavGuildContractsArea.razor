@inherits UiHelper

@using System.Linq
@using FurmaIdle.Models
@using FurmaIdle.Data
@using FurmaIdle.Helpers
@using FurmaIdle.Services

@inject IPurchaseService Purchase
@inject IExpeditionService Expedition
@inject ICostService Cost
@inject IContractsService Contracts
@inject ILocateService Locate
@inject ITooltipService Tooltips
@inject INotificationService Notifications

<div class="menu-root">
    @if (!Game.IsReady || _stage is null)
    {
        <div class="contracts-placeholder">Stage não Selecionado</div>
    }
    else
    {
        var game = Game.CurrentGame;
        var expedition = _stage.Expedition;
        var expeditionStats = _stage.ExpeditionStats;

        var expansionId = game.CurrentExpansionId;

        var showBuyAll = expansionId != "x000"
        && expansionId != "x010"
        && expansionId != "x011";

        <section class="@($"menu-panel menu-section {UI.PanelClass("guild-contracts-fast")}")">
            @if (_stage.Id == "s00")
            {
                <h3 class="title">Melhorias Rápidas</h3>
            }
            else
            {
                <h3 class="title">Melhorias da Expedição</h3>
            }

            @if (showBuyAll && (_contractsExpedition.Any() || _contractsExpansion.Any()))
            {
                <button class="buy-all-button @(_autoBuyEnabled ? "is-on" : null)"
                        @onclick="OnClickBuyAll">
                    @(_autoBuyEnabled ? "Auto: ON" : "Auto: OFF")
                </button>
            }

            <div class="icon-grid">
                @foreach (var u in _contractsExpedition)
                {
                    var can = Cost.CanAfford(ItemHelper.ItemType.Upgrade, u.Id, _stage.Id);
                    <button class="icon-button" disabled="@(!can || _autoBuyEnabled)"
                            @onclick="() => OnClickBuy(u.Id)"
                            @onmouseenter="() => Tooltips.Show(Tooltips.GetHover(HoverType.Upgrade, u.Id, _stage.Id))"
                            @onmouseleave="Tooltips.Clear">
                        @if (!string.IsNullOrWhiteSpace(u.Icon))
                        {
                            <img src="@u.Icon"
                                 alt="@u.Id"
                                 class="icon-img" />
                        }
                        else
                        {
                            @u.Id
                        }
                    </button>
                }
            </div>
        </section>

        <section class="@($"menu-panel menu-section {UI.PanelClass("guild-contracts-long")}")">
            @if (_stage.Id == "s00")
            {
                <h3 class="title">Melhorias Longas</h3>
            }
            else
            {
                <h3 class="title">Melhorias da Expansão</h3>
            }
            <div class="icon-grid">
                @foreach (var u in _contractsExpansion)
                {
                    var can = Cost.CanAfford(ItemHelper.ItemType.Upgrade, u.Id, _stage.Id);
                    <button class="icon-button" disabled="@(!can || _autoBuyEnabled)"
                            @onclick="() => OnClickBuy(u.Id)"
                            @onmouseenter="() => Tooltips.Show(Tooltips.GetHover(HoverType.Upgrade, u.Id, _stage.Id))"
                            @onmouseleave="Tooltips.Clear">
                        @if (!string.IsNullOrWhiteSpace(u.Icon))
                        {
                            <img src="@u.Icon"
                                 alt="@u.Id"
                                 class="icon-img" />
                        }
                        else
                        {
                            @u.Id
                        }
                    </button>
                }
            </div>
        </section>
        @if (_stage.Id == "s00")
        {
            <section class="@($"menu-panel menu-section {UI.PanelClass("guild-contracts-tutorial")}")">
                <h3 class="title">Encerrar Tutorial</h3>
                <div class="icon-grid">
                    @foreach (var u in _contractsTutorial)
                    {
                        var c101 = _stage.ActiveContracts.TryGetValue("c101", out var qnt);
                        var price = Cost.CanAfford(ItemHelper.ItemType.Upgrade, u.Id, _stage.Id);
                        var can = price && c101;
                        <button class="icon-button" disabled="@(!can || _autoBuyEnabled)"
                                @onclick="() => OnClickBuy(u.Id)"
                                @onmouseenter="() => Tooltips.Show(Tooltips.GetHover(HoverType.Upgrade, u.Id, _stage.Id))"
                                @onmouseleave="Tooltips.Clear">
                            @if (!string.IsNullOrWhiteSpace(u.Icon))
                            {
                                <img src="@u.Icon"
                                     alt="@u.Id"
                                     class="icon-img" />
                            }
                            else
                            {
                                @u.Id
                            }
                        </button>
                    }
                </div>
            </section>
        }
    }
</div>

@code {
    private StageModel? _stage;

    private List<UpgradeModel> _contractsExpedition = new();
    private List<UpgradeModel> _contractsExpansion = new();
    private List<UpgradeModel> _contractsTutorial = new();

    private bool freeProcess = true;
    private bool _autoBuyEnabled = false;
    private DateTime _lastAutoBuyUtc = DateTime.MinValue;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        RefreshStage();
        RebuildLists();
    }

    protected override void OnGameChanged()
    {
        RefreshStage();
        RebuildLists();

        if (_autoBuyEnabled)
        {
            _ = InvokeAsync(AutoBuyTick);
        }
    }

    private void RefreshStage()
    {
        if (!Game.IsReady || string.IsNullOrWhiteSpace(Game?.CurrentGame.SelectedStageId))
        {
            _stage = null;
            _autoBuyEnabled = false;
            return;
        }

        var g = Game.CurrentGame;
        g.Stages.TryGetValue(Game?.CurrentGame.SelectedStageId, out var st);
        _stage = st;
    }

    private void RebuildLists()
    {
        if (!Game.IsReady || _stage is null)
            return;

        Notifications.UpdateVisibleUpgrades("guild-contracts");

        Notifications.TabsUpgrades.TryGetValue("contractsExpedition", out _contractsExpedition);
        Notifications.TabsUpgrades.TryGetValue("contractsExpansion", out _contractsExpansion);
        Notifications.TabsUpgrades.TryGetValue("contractsTutorial", out _contractsTutorial);
    }

    private async Task<bool> TryBuyUpgrade(UpgradeModel upgrade)
    {
        if (_stage is null)
            return false;

        var stageId = _stage.Id;
        var game = Game.CurrentGame;
        if (game is null || upgrade is null)
            return false;

        if (!Cost.CanAfford(ItemHelper.ItemType.Upgrade, upgrade.Id, stageId))
            return false;

        if (upgrade.Id.StartsWith("uc"))
        {
            if (string.IsNullOrWhiteSpace(upgrade.TargetId))
                return false;

            var nextBuy = Math.Max(1, upgrade.ActualBuy + 1);
            var maxBuy = upgrade.MaxBuy <= 0 ? int.MaxValue : upgrade.MaxBuy;
            if (nextBuy > maxBuy) return false;

            if (!(_stage.ActiveContracts?.TryGetValue(upgrade.TargetId, out var qty) ?? false) || qty <= 0)
                return false;

            var needed = Notifications.ContractUpgradeAvailable(upgrade.EffectType, nextBuy);
            if (needed > 0 && qty < needed)
                return false;
        }

        var isEndGoal = upgrade.Id == "us01";
        if (isEndGoal)
        {
            UI.SetBusy("Objetivo alcançado! Vamos nos preparar para o próximo.");
        }

        await Purchase.Purchase(ItemHelper.ItemType.Upgrade, upgrade.Id, stageId);

        if (isEndGoal)
        {
            await Expedition.EndExpansion(Game.CurrentGame.CurrentExpansionId);
            await Expedition.SecondExpeditionStart();
            await UI.LoadStage("s01");
            UI.ClearBusy();
        }

        if (_stage is not null)
        {
            var hover = Tooltips.GetHover(HoverType.Upgrade, upgrade.Id, stageId);
            Tooltips.Show(hover);
        }

        return true;
    }

    private async Task OnClickBuy(string upgradeId)
    {
        if (_stage is null)
            return;

        if (!freeProcess)
            return;

        if (_autoBuyEnabled)
            return;

        freeProcess = false;

        try
        {
            var game = Game.CurrentGame;
            if (game is null) return;

            var upgrade = Locate.LocateUpgrade(game, upgradeId);
            await TryBuyUpgrade(upgrade);
        }
        finally
        {
            freeProcess = true;
        }
    }

    private async Task OnClickBuyAll()
    {
        if (_stage is null)
            return;

        _autoBuyEnabled = !_autoBuyEnabled;

        if (_autoBuyEnabled)
        {
            _lastAutoBuyUtc = DateTime.UtcNow.AddSeconds(-2);
            await AutoBuyTick();
        }

        StateHasChanged();
    }

    private async Task AutoBuyTick()
    {
        if (!_autoBuyEnabled)
            return;

        if (_stage is null)
            return;

        if (!freeProcess)
            return;

        var now = DateTime.UtcNow;
        if ((now - _lastAutoBuyUtc).TotalSeconds < 2)
            return;

        freeProcess = false;

        try
        {
            var game = Game.CurrentGame;
            if (game is null) return;

            var list = _contractsExpedition
                .Concat(_contractsExpansion)
                .ToList();

            if (list.Count == 0)
                return;

            foreach (var u in list)
            {
                if (_stage is null)
                    break;

                var upgrade = Locate.LocateUpgrade(game, u.Id);
                var success = await TryBuyUpgrade(upgrade);

                if (success)
                {
                    RebuildLists();
                    StateHasChanged();
                    break;
                }
            }
        }
        finally
        {
            freeProcess = true;
        }
    }

}

@* Components/ShopMenuStage.razor *@
@inherits UiHelper

@using System.Linq
@using FurmaIdle.Models
@using FurmaIdle.Data
@using FurmaIdle.Helpers
@using FurmaIdle.Services

@inject IPurchaseService Purchase
@inject ILocateService Locate
@inject ITooltipService Tooltips
@inject IUiLogService Log
@inject IExpeditionService Expedition
@inject IUiService Ui

@if (!Game.IsReady || string.IsNullOrWhiteSpace(_stage.Id) || _stage is null)
{
    <div class="contracts-placeholder">Stage não Selecionado</div>
}
else
{
    var game = Game.CurrentGame;

    var unlockedStages = OrderedStages(game)
        .Where(s => s.State == UnlockHelper.State.Unlocked)
        .ToList();

    var availableStageUpgrades = OrderedStageUnlockUpgrades(game)
        .Where(u => u.State == UnlockHelper.State.Available)
        .ToList();

    var unlockedLocalsInStage = _stage is null ? Enumerable.Empty<LocalModel>() :
        OrderedLocals(game)
            .Where(l => string.Equals(l.StageId, _stage.Id, StringComparison.OrdinalIgnoreCase)
                     && l.State == UnlockHelper.State.Unlocked);

    var availableLocalUpgradesInStage = _stage is null ? Enumerable.Empty<UpgradeModel>() :
        OrderedLocalUnlockUpgrades(game)
            .Where(u =>
                u.State == UnlockHelper.State.Available &&
                string.Equals(u.UnlockId, _stage.Id, StringComparison.OrdinalIgnoreCase));

    <div class="shop-menu-stages">
        <h3>Unlocked Stages</h3>
        @if (!unlockedStages.Any())
        {
            <div>Nenhuma Stage desbloqueada.</div>
        }
        else
        {
            <div>
                @foreach (var stage in unlockedStages)
                {
                    var isSelected = string.Equals(_stage.Id, stage.Id, StringComparison.OrdinalIgnoreCase);

                    <button type="button"
                            class="icon-button"
                            disabled="@(isSelected)"
                            aria-pressed="@(isSelected)"
                            @onclick="() => SelectStage(stage.Id)"
                            @onmouseenter="() => Tooltips.Show(Tooltips.GetHover(HoverType.Stage, stage.Id, _stage.Id))"
                            @onmouseleave="Tooltips.Clear"
                            @onfocus="() => Tooltips.Show(Tooltips.GetHover(HoverType.Stage, stage.Id, _stage.Id))"
                            @onblur="Tooltips.Clear"
                            tabindex="0">
                        @stage.Id
                    </button>
                }
            </div>
        }
    </div>

    <div>
        <h3>Available Stages</h3>
        @if (!availableStageUpgrades.Any())
        {
            <div>Nenhum Stage disponível.</div>
        }
        else
        {
            <div>
                @foreach (var upgrade in availableStageUpgrades)
                {
                    var canBuy = Purchase.CanAfford(ItemHelper.ItemType.Upgrade, upgrade.Id, _stage.Id);

                    <button type="button"
                            class="icon-button"
                            disabled="@( !canBuy )"
                            @onclick="() => OnClickBuyStageUpgrade(upgrade.Id)"
                            @onmouseenter="() => Tooltips.Show(Tooltips.GetHover(HoverType.Upgrade, upgrade.Id, _stage.Id))"
                            @onmouseleave="Tooltips.Clear"
                            @onfocus="() => Tooltips.Show(Tooltips.GetHover(HoverType.Upgrade, upgrade.Id, _stage.Id))"
                            @onblur="Tooltips.Clear"
                            tabindex="0">
                        @upgrade.Id
                    </button>
                }
            </div>
        }
    </div>

    <div>
        <h3>Selected Stage</h3>
        @if (_stage is null)
        {
            <div>Nenhuma Stage selecionada.</div>
        }
        else
        {
            <div>
                <div>@_stage.Id - @_stage.Name</div>
                <div><b>PartySize:</b> @Expedition.GetPartyCap(_stage) / @_stage.MaxPartySize</div>
                <div><b>MaxContractLevel:</b> @_stage.MaxContractLevel</div>
            </div>
        }
    </div>

    <div>
        <h3>Unlocked Locals in Stage</h3>
        @if (_stage is null)
        {
            <div>Selecione uma Stage.</div>
        }
        else if (!unlockedLocalsInStage.Any())
        {
            <div>Nenhum Local desbloqueado nessa Stage.</div>
        }
        else
        {
            <div>
                @foreach (var local in unlockedLocalsInStage)
                {
                    <button type="button"
                            class="icon-button"
                            disabled
                            @onmouseenter="() => Tooltips.Show(Tooltips.GetHover(HoverType.Local, local.Id, _stage.Id))"
                            @onmouseleave="Tooltips.Clear"
                            @onfocus="() => Tooltips.Show(Tooltips.GetHover(HoverType.Local, local.Id, _stage.Id))"
                            @onblur="Tooltips.Clear"
                            tabindex="0">
                        @local.Id
                    </button>
                }
            </div>
        }
    </div>

    <!-- Available Local Upgrades in SelectedStage (ul...) -->
    <div>
        <h3>Available Locals in Stage</h3>
        @if (_stage is null)
        {
            <div>Selecione uma Stage.</div>
        }
        else if (!availableLocalUpgradesInStage.Any())
        {
            <div>Nenhum Local disponível para esta Stage.</div>
        }
        else
        {
            <div>
                @foreach (var upgrade in availableLocalUpgradesInStage)
                {
                    var canBuy = Purchase.CanAfford(ItemHelper.ItemType.Upgrade, upgrade.Id, _stage.Id);
                    <button type="button"
                            class="icon-button"
                            disabled="@( !canBuy )"
                            @onclick="() => OnClickBuyLocalUpgrade(upgrade.Id)"
                            @onmouseenter="() => Tooltips.Show(Tooltips.GetHover(HoverType.Upgrade, upgrade.Id, _stage.Id))"
                            @onmouseleave="Tooltips.Clear"
                            @onfocus="() => Tooltips.Show(Tooltips.GetHover(HoverType.Upgrade, upgrade.Id, _stage.Id))"
                            @onblur="Tooltips.Clear"
                            tabindex="0">
                        @upgrade.Id
                    </button>
                }
            </div>
        }
    </div>
}

@code {
    private StageModel? _stage;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        RefreshStage();
    }

    protected override void OnGameChanged()
    {
        RefreshStage();
    }

    private void RefreshStage()
    {
        if (!Game.IsReady || string.IsNullOrWhiteSpace(Game?.CurrentGame.SelectedStageId))
        {
            _stage = null;
            return;
        }

        var g = Game.CurrentGame;
        g.Stages.TryGetValue(Game?.CurrentGame.SelectedStageId, out var st);
        _stage = st;
    }

    // ===== Ordenações =====
    private static IEnumerable<StageModel> OrderedStages(GameModel m)
        => m.Stages.Values.OrderBy(s =>
            {
                var idx = StageData.ShowOrder.FindIndex(id => string.Equals(id, s.Id, StringComparison.OrdinalIgnoreCase));
                return idx < 0 ? int.MaxValue : idx;
            }).ThenBy(s => s.Id);

    private static IEnumerable<UpgradeModel> OrderedStageUnlockUpgrades(GameModel m)
        => m.Upgrades.Values
            .Where(u => u?.Id != null && u.Id.StartsWith("us", StringComparison.OrdinalIgnoreCase))
            .OrderBy(u =>
            {
                var idx = UpgradeData.ShowOrder.FindIndex(id => string.Equals(id, u.Id, StringComparison.OrdinalIgnoreCase));
                return idx < 0 ? int.MaxValue : idx;
            })
            .ThenBy(u => u.Id);

    private static IEnumerable<LocalModel> OrderedLocals(GameModel m)
        => m.Locals.Values.OrderBy(l =>
            {
                var idx = LocalData.ShowOrder.FindIndex(id => string.Equals(id, l.Id, StringComparison.OrdinalIgnoreCase));
                return idx < 0 ? int.MaxValue : idx;
            }).ThenBy(l => l.Id);

    private static IEnumerable<UpgradeModel> OrderedLocalUnlockUpgrades(GameModel m)
        => m.Upgrades.Values
            .Where(u => u?.Id != null && u.Id.StartsWith("ul", StringComparison.OrdinalIgnoreCase))
            .OrderBy(u =>
            {
                var idx = UpgradeData.ShowOrder.FindIndex(id => string.Equals(id, u.Id, StringComparison.OrdinalIgnoreCase));
                return idx < 0 ? int.MaxValue : idx;
            })
            .ThenBy(u => u.Id);

    // ===== Ações =====
    private async Task SelectStage(string stageId)
    {
        await Ui.LoadStage(stageId);
    }

    private async Task OnClickBuyLocalUpgrade(string upgradeId)
    {
        var canAfford = Purchase.CanAfford(ItemHelper.ItemType.Upgrade, upgradeId, _stage.Id);
        if (!canAfford)
        {
            Log.Error($"Sem recursos para comprar upgrade {upgradeId}.");
            return;
        }

        await Purchase.Purchase(ItemHelper.ItemType.Upgrade, upgradeId, _stage.Id);
    }

    private async Task OnClickBuyStageUpgrade(string upgradeId)
    {
        var canAfford = Purchase.CanAfford(ItemHelper.ItemType.Upgrade, upgradeId, _stage.Id);
        if (!canAfford)
        {
            Log.Error($"Sem recursos para comprar upgrade {upgradeId}.");
            return;
        }
        await Purchase.Purchase(ItemHelper.ItemType.Upgrade, upgradeId, _stage.Id);
    }
}

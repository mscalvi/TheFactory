@inherits UiHelper

@using System.Linq
@using FurmaIdle.Helpers
@using FurmaIdle.Models
@using FurmaIdle.Services

<div class="game-area nav-menu">
    <div class="nav-col">
        @foreach (var it in UI.VisibleMenu)
        {
            var isSelected = string.Equals(UI.OpenMenuId, it.Id, StringComparison.OrdinalIgnoreCase);
            var hasNotif = it.Notification;
            var notifClass = "";

            if (hasNotif)
            {
                notifClass = it.NotificationKind switch
                {
                    NotificationKind.Info => " has-notif notif-info",
                    NotificationKind.NewItem => " has-notif notif-newitem",   
                    NotificationKind.Affordable => " has-notif notif-affordable",
                    _ => " has-notif"
                };
            }

            <button class="@($"nav-button{(isSelected ? " is-selected" : "")}{notifClass}")"
                    title="@it.Label"
                    aria-label="@it.Label"
                    aria-pressed="@isSelected"
                    @onclick="() => Select(it.Id)">
                <span class="nav-glyph">@it.Label</span>
            </button>
        }
    </div>
</div>

@code {
    [Parameter] public EventCallback<string> OnSelect { get; set; }
    [Parameter] public string IconBasePath { get; set; } = "/icons/nav-menu";

    protected override void OnInitialized()
    {
        base.OnInitialized();

        UI.Changed += OnUiChanged;
        UI.Pulse += OnUiPulse;
    }

    private void OnUiChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    protected override void OnGameChanged()
    {
        base.OnGameChanged();
    }

    private async Task Select(string id)
    {
        UI.SetOpenMenu(id);
        if (OnSelect.HasDelegate) await OnSelect.InvokeAsync(id);
    }

    private string GetIconPath(string id)
        => $"{IconBasePath}/{id}.svg";
}

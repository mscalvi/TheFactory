@inherits UiHelper

@using System.Linq
@using FurmaIdle.Models
@using FurmaIdle.Data
@using FurmaIdle.Helpers
@using FurmaIdle.Services

@inject IPurchaseService Purchase
@inject ICostService Cost
@inject ILocateService Locate
@inject ITooltipService Tooltips
@inject IUiLogService Log
@inject INotificationService Notifications

<div class="menu-root">
    @if (!Game.IsReady || _stage is null)
    {
        <div class="contracts-placeholder">Stage não Selecionado</div>
    }
    else
    {
        <section class="@($"menu-panel menu-section {UI.PanelClass("stage-dock-routes")}")">
            <h3 class="title">Rotas Disponíveis</h3>
            <div class="icon-grid">
                @if (_stageRoutes.Count <= 0)
                {
                    <div class="upgrades-empty">
                        <img src="@($"images/upgrades-noUpgrades.svg")" alt="Nenhuma Melhoria disponível" class="no-upgrades" />
                    </div>
                }
                else
                {
                    foreach (var u in _stageRoutes)
                    {
                        var can = Cost.CanAfford(ItemHelper.ItemType.Upgrade, u.Id, _stage.Id);
                        <button class="icon-button"
                                disabled="@(!can)"
                                @onmouseenter="() => Tooltips.Show(Tooltips.GetHover(HoverType.Upgrade, u.Id, _stage.Id))"
                                @onmouseleave="Tooltips.Clear"
                                @onclick="() => OnClickBuy(u.Id)">
                            @if (!string.IsNullOrWhiteSpace(u.Icon))
                            {
                                <img src="@u.Icon"
                                     alt="@u.Id"
                                     class="icon-img" />
                            }
                            else
                            {
                                @u.Id
                            }
                        </button>
                    }
                }
            </div>
        </section>

        <section class="@($"menu-panel menu-section {UI.PanelClass("stage-dock-ships")}")">
            <h3 class="title">Navios Disponíveis</h3>
            <div class="icon-grid">
                @if (_stageShips.Count <= 0)
                {
                    <div class="upgrades-empty">
                        <img src="@($"images/upgrades-noUpgrades.svg")" alt="Nenhuma Melhoria disponível" class="no-upgrades" />
                    </div>
                } else
                {
                    foreach (var u in _stageShips)
                    {
                        var can = Cost.CanAfford(ItemHelper.ItemType.Upgrade, u.Id, _stage.Id);
                        <button class="icon-button"
                                disabled="@(!can)"
                                @onmouseenter="() => Tooltips.Show(Tooltips.GetHover(HoverType.Upgrade, u.Id, _stage.Id))"
                                @onmouseleave="Tooltips.Clear"
                                @onclick="() => OnClickBuy(u.Id)">
                            @if (!string.IsNullOrWhiteSpace(u.Icon))
                            {
                                <img src="@u.Icon"
                                     alt="@u.Id"
                                     class="icon-img" />
                            }
                            else
                            {
                                @u.Id
                            }
                        </button>
                    }
                }
               
            </div>
        </section>

    }
</div>

@code {
    private StageModel? _stage;

    private List<UpgradeModel> _stageShips = new();
    private List<UpgradeModel> _stageRoutes = new();

    private bool freeProcess = true;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        RefreshStage();
        RebuildLists();
    }

    protected override void OnGameChanged()
    {
        RefreshStage();
        RebuildLists();
    }

    private void RefreshStage()
    {
        if (!Game.IsReady || string.IsNullOrWhiteSpace(Game?.CurrentGame.SelectedStageId))
        {
            _stage = null;
            return;
        }

        var g = Game.CurrentGame;
        g.Stages.TryGetValue(g.SelectedStageId, out var st);
        _stage = st;
    }

    private void RebuildLists()
    {
        if (!Game.IsReady || _stage is null)
            return;

        Notifications.UpdateVisibleUpgrades("stage-dock");

        Notifications.TabsUpgrades.TryGetValue("stageShips", out _stageShips);
        Notifications.TabsUpgrades.TryGetValue("stageRoutes", out _stageRoutes);
    }

    private async Task OnClickBuy(string upgradeId)
    {
        if (_stage is null)
            return;

        var stageId = _stage.Id;

        if (!Cost.CanAfford(ItemHelper.ItemType.Upgrade, upgradeId, stageId))
        {
            Log.Error($"Sem recursos para comprar upgrade {upgradeId}.");
            return;
        }

        if (!freeProcess)
            return;

        freeProcess = false;
        try
        {
            await Purchase.Purchase(ItemHelper.ItemType.Upgrade, upgradeId, stageId);
        }
        finally
        {
            freeProcess = true;
        }
    }
}

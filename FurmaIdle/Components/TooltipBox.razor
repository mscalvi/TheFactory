@using FurmaIdle.Models
@using FurmaIdle.Services

@inject ITooltipService Tooltips

<div class="game-area">
    @if (Tooltips.Current is not null)
    {
        TooltipModel Model = Tooltips.Current;

        var infoEntries = (Model.Info ?? new Dictionary<string, string>())
            .Where(kv => !string.IsNullOrWhiteSpace(kv.Key))
            .Take(4)
            .ToList();

        <div class="tooltip-card">

            <!-- Faixa superior -->
            <section class="tt-top">
                <span class="tt-title">
                    @Model.Name
                    @if (!string.IsNullOrWhiteSpace(Model.CostAmount))
                    {
                        <span class="tt-cost">
                            - @Model.CostAmount

                            @if (!string.IsNullOrWhiteSpace(Model.CostIcon))
                            {
                                <img src="@Model.CostIcon"
                                     alt="@Model.CostName"
                                     class="tt-cost-icon" />
                            }
                        </span>
                    }
                </span>
            </section>

            <section class="tt-desc">
                <span class="tt-description">
                    @Model.Description
                </span>
            </section>

            <!-- Quadro de informações -->
            <section class="tt-mid">
                @for (int i = 0; i < 4; i++)
                {
                    if (i < infoEntries.Count)
                    {
                        var line = infoEntries[i];
                        <div class="tt-info">
                            <div class="tt-info-title">
                                <strong>@line.Key</strong>
                            </div>
                            <div class="tt-info-item">
                                @if (!string.IsNullOrWhiteSpace(line.Value) &&
                                                    line.Value.EndsWith(".svg", StringComparison.OrdinalIgnoreCase))
                                {
                                    <div class="tt-icon">

                                        <img src="@line.Value"
                                             alt="S/I"
                                             class="tt-img" />
                                    </div>
                                }
                                else
                                {
                                    <div class="tt-item">
                                        @line.Value
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="tt-info tt-info-empty"></div>
                    }
                }
            </section>


            <!-- Quadro com lore -->
            <section class="tt-bot">
                <span class="tt-lore">@Model.Lore</span>
            </section>
        </div>
    }
</div>

@code {
    protected override void OnInitialized()
    {
        Tooltips.Changed += OnChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Tooltips.Changed -= OnChanged;
}

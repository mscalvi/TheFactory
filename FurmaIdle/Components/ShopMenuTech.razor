@* Components/ShopMenuTech.razor *@
@inherits UiHelper

@using System.Linq
@using FurmaIdle.Models
@using FurmaIdle.Data
@using FurmaIdle.Helpers
@using FurmaIdle.Services

@inject IPurchaseService Purchase
@inject ITooltipService Tooltips
@inject IUiLogService Log

@{
    var game = Game.CurrentGame;
    if (game is null)
    {
        <div>Carregando…</div>
        return;
    }

    var unlockedKnowledges = game is null ? Enumerable.Empty<KnowledgeModel>() :
        game.Knowledges.Values
            .Where(k => k.State == UnlockHelper.State.Unlocked)
            .OrderBy(k =>
            {
                var idx = KnowledgeData.ShowOrder.FindIndex(id => string.Equals(id, k.Id, StringComparison.Ordinal));
                return idx < 0 ? int.MaxValue : idx;
            })
            .ThenBy(k => k.Id);

    var unlockedTechs = game is null ? Enumerable.Empty<TechModel>() :
        game.Techs.Values
            .Where(t => t.State == UnlockHelper.State.Unlocked)
            .OrderBy(t => t.Id);
}

<div>
    <h3>Knowledges</h3>
    @if (!unlockedKnowledges.Any())
    {
        <div>Nenhum Knowledge desbloqueado.</div>
    }
    else
    {
        <div>
            @foreach (var k in unlockedKnowledges)
            {
                var id = k.Id;
                var total = Total(id);
                <button type="button"
                        class="icon-button"
                        disabled
                        @onmouseenter="() => Tooltips.Show(Tooltips.GetHover(HoverType.Knowledge, id, game.SelectedStageId))"
                        @onmouseleave="Tooltips.Clear"
                        @onfocus="() => Tooltips.Show(Tooltips.GetHover(HoverType.Knowledge, id, game.SelectedStageId))"
                        @onblur="Tooltips.Clear">
                    @id <text>:</text> @total
                </button>
            }
        </div>
    }
</div>

<div>
    <h3>Unlocked Techs</h3>
    @if (!unlockedTechs.Any())
    {
        <div>Nenhuma Tech desbloqueada.</div>
    }
    else
    {
        <div>
            @foreach (var t in unlockedTechs)
            {
                var id = t.Id;
                <button type="button"
                        class="icon-button"
                        disabled
                        @onmouseenter="() => Tooltips.Show(Tooltips.GetHover(HoverType.Tech, id, game.SelectedStageId))"
                        @onmouseleave="Tooltips.Clear"
                        @onfocus="() => Tooltips.Show(Tooltips.GetHover(HoverType.Tech, id, game.SelectedStageId))"
                        @onblur="Tooltips.Clear">
                    @id
                </button>
            }
        </div>
    }
</div>

@code {
    long Total(string kId) => Game?.CurrentGame.ExpansionStats.Knowledge.TryGetValue(kId, out var v) == true ? v : 0L;

    private async Task OnClickBuyKnowledgeUpgrade(string upgradeId)
    {
        if (!Purchase.CanAffordTech(upgradeId))
        {
            Log.Error($"Sem recursos para comprar upgrade {upgradeId}.");
            return;
        }

        await Purchase.PurchaseTech(upgradeId);
    }
}
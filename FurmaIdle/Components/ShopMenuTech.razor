@* Components/ShopMenuTech.razor *@
@inherits UiHelper

@using System.Linq
@using FurmaIdle.Models
@using FurmaIdle.Data
@using FurmaIdle.Helpers
@using FurmaIdle.Services

@inject IPurchaseService Purchase
@inject ITooltipService Tooltips
@inject IUiLogService Log

@{
    var game = Game.CurrentGame;
    if (game is null)
    {
        <div>Carregando…</div>
        return;
    }

    var unlockedKnowledges = game is null ? Enumerable.Empty<KnowledgeModel>() :
        game.Knowledges.Values
            .Where(k => k.State == UnlockHelper.State.Unlocked)
            .OrderBy(k =>
            {
                var idx = KnowledgeData.ShowOrder.FindIndex(id => string.Equals(id, k.Id, StringComparison.Ordinal));
                return idx < 0 ? int.MaxValue : idx;
            })
            .ThenBy(k => k.Id);

    var availableTechUpgrades = game is null ? Enumerable.Empty<UpgradeModel>() :
        game.Upgrades.Values
            .Where(u => u?.Id != null
                     && u.Id.StartsWith("uh", StringComparison.OrdinalIgnoreCase)
                     && u.State == UnlockHelper.State.Available)
            .OrderBy(u =>
            {
                var idx = UpgradeData.ShowOrder.FindIndex(id => string.Equals(id, u.Id, StringComparison.Ordinal));
                return idx < 0 ? int.MaxValue : idx;
            })
            .ThenBy(u => u.Id);

    var unlockedTechs = game is null ? Enumerable.Empty<TechModel>() :
        game.Techs.Values
            .Where(t => t.State == UnlockHelper.State.Unlocked)
            .OrderBy(t => t.Id);


    var availableKnowledgeUpgrades = Game.CurrentGame is null ? Enumerable.Empty<UpgradeModel>() :
        Game.CurrentGame.Upgrades.Values
            .Where(u => u?.Id != null
                     && u.Id.StartsWith("uk", StringComparison.OrdinalIgnoreCase)
                     && u.State == UnlockHelper.State.Available)
            .OrderBy(u =>
            {
                var idx = UpgradeData.ShowOrder.FindIndex(id => string.Equals(id, u.Id, StringComparison.Ordinal));
                return idx < 0 ? int.MaxValue : idx;
            })
            .ThenBy(u => u.Id);
}

<div>
    <h3>Knowledges</h3>
    @if (!unlockedKnowledges.Any())
    {
        <div>Nenhum Knowledge desbloqueado.</div>
    }
    else
    {
        <div>
            @foreach (var k in unlockedKnowledges)
            {
                var id = k.Id;
                var total = Total(id);
                <button type="button"
                        class="icon-button"
                        disabled
                        @onmouseenter="() => Tooltips.Show(Tooltips.GetHover(HoverType.Knowledge, id, game.SelectedStageId))"
                        @onmouseleave="Tooltips.Clear"
                        @onfocus="() => Tooltips.Show(Tooltips.GetHover(HoverType.Knowledge, id, game.SelectedStageId))"
                        @onblur="Tooltips.Clear">
                    @id <text>:</text> @total
                </button>
            }
        </div>
    }
</div>

<div>
    <h3>Available Knowledge Upgrades</h3>
    @if (!availableKnowledgeUpgrades.Any())
    {
        <div>Nenhum upgrade de Knowledge disponível.</div>
    }
    else
    {
        <div>
            @foreach (var u in availableKnowledgeUpgrades)
            {
                var id = u.Id;
                var canBuy = Purchase.CanAfford(ItemHelper.ItemType.Upgrade, id, game.SelectedStageId);

                <button type="button"
                        class="icon-button"
                        disabled="@( !canBuy )"
                        @onclick="() => OnClickBuyKnowledgeUpgrade(id)"
                        @onmouseenter="() => Tooltips.Show(Tooltips.GetHover(HoverType.Upgrade, id, game.SelectedStageId))"
                        @onmouseleave="Tooltips.Clear"
                        @onfocus="() => Tooltips.Show(Tooltips.GetHover(HoverType.Upgrade, id, game.SelectedStageId))"
                        @onblur="Tooltips.Clear">
                    @id
                </button>
            }
        </div>
    }
</div>

<div>
    <h3>Available Tech Upgrades</h3>
    @if (!availableTechUpgrades.Any())
    {
        <div>Nenhum Upgrade de Tech disponível.</div>
    }
    else
    {
        <div>
            @foreach (var u in availableTechUpgrades)
            {
                var id = u.Id;
                var canBuy = Purchase.CanAfford(ItemHelper.ItemType.Upgrade, id, game.SelectedStageId);
                <button type="button"
                        class="icon-button"
                        disabled="@( !canBuy )"
                        @onclick="() => OnClickBuyTechUpgrade(id)"
                        @onmouseenter="() => Tooltips.Show(Tooltips.GetHover(HoverType.Upgrade, id, game.SelectedStageId))"
                        @onmouseleave="Tooltips.Clear"
                        @onfocus="() => Tooltips.Show(Tooltips.GetHover(HoverType.Upgrade, id, game.SelectedStageId))"
                        @onblur="Tooltips.Clear">
                    @id
                </button>
            }
        </div>
    }
</div>


<div>
    <h3>Unlocked Techs</h3>
    @if (!unlockedTechs.Any())
    {
        <div>Nenhuma Tech desbloqueada.</div>
    }
    else
    {
        <div>
            @foreach (var t in unlockedTechs)
            {
                var id = t.Id;
                <button type="button"
                        class="icon-button"
                        disabled
                        @onmouseenter="() => Tooltips.Show(Tooltips.GetHover(HoverType.Tech, id, game.SelectedStageId))"
                        @onmouseleave="Tooltips.Clear"
                        @onfocus="() => Tooltips.Show(Tooltips.GetHover(HoverType.Tech, id, game.SelectedStageId))"
                        @onblur="Tooltips.Clear">
                    @id
                </button>
            }
        </div>
    }
</div>

@code {
    long Total(string kId) => Game?.CurrentGame.GameStats.Knowledge.TryGetValue(kId, out var v) == true ? v : 0L;

    private async Task OnClickBuyTechUpgrade(string upgradeId)
    {
        if (!Purchase.CanAfford(ItemHelper.ItemType.Upgrade, upgradeId, Game?.CurrentGame.SelectedStageId))
        { 
            Log.Error($"Sem recursos para comprar upgrade {upgradeId}."); 
            return; 
        }

        await Purchase.Purchase(ItemHelper.ItemType.Upgrade, upgradeId, Game?.CurrentGame.SelectedStageId);
    }

    private async Task OnClickBuyKnowledgeUpgrade(string upgradeId)
    {
        if (!Purchase.CanAfford(ItemHelper.ItemType.Upgrade, upgradeId, Game?.CurrentGame.SelectedStageId))
        {
            Log.Error($"Sem recursos para comprar upgrade {upgradeId}.");
            return;
        }

        await Purchase.Purchase(ItemHelper.ItemType.Upgrade, upgradeId, Game?.CurrentGame.SelectedStageId);
    }
}
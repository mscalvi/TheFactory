@* Components/ShopMenuTech.razor *@
@inherits UiHelper

@using System.Linq
@using FurmaIdle.Models
@using FurmaIdle.Data
@using FurmaIdle.Helpers
@using FurmaIdle.Services

@inject IPurchaseService Purchase
@inject ICostService Cost
@inject ILocateService Locate
@inject ITooltipService Tooltips
@inject IUiLogService Log

@{
    var game = Game.CurrentGame;
    var stage = Locate.LocateStage(game, game.SelectedStageId);

    var availableTechUpgrades = game is null ? Enumerable.Empty<UpgradeModel>() :
    game.Upgrades.Values
        .Where(u => u?.Id != null
                 && u.Id.StartsWith("uh", StringComparison.OrdinalIgnoreCase)
                 && u.State == UnlockHelper.State.Available);

    var unlockedKnowledges = game is null ? Enumerable.Empty<KnowledgeModel>() :
        game.Knowledges.Values
            .Where(k => k.State == UnlockHelper.State.Unlocked);

    var unlockedTechs = game is null ? Enumerable.Empty<TechModel>() :
        game.Techs.Values
            .Where(t => t.State == UnlockHelper.State.Unlocked)
            .OrderBy(t => t.Id);
}

<div>
    <h3>Knowledges</h3>
    @foreach (var k in unlockedKnowledges)
    {
        var id = k.Id;
        var total = Total(id);
        <button type="button"
                class=" "
                disabled
                @onmouseenter="() => Tooltips.Show(Tooltips.GetHover(HoverType.Knowledge, id, stage.Id))"
                @onmouseleave="Tooltips.Clear"
                @onfocus="() => Tooltips.Show(Tooltips.GetHover(HoverType.Knowledge, id, stage.Id))"
                @onblur="Tooltips.Clear">
            @id <text>:</text> @total
        </button>
    }
</div>

<div>
    <h3>Available Techs</h3>
    @foreach (var u in availableTechUpgrades)
    {
        var id = u.Id;
        var canBuy = Cost.CanAfford(ItemHelper.ItemType.Upgrade, id, stage.Id);
        <button type="button"
                class="icon-button"
                disabled="@( !canBuy )"
                @onclick="() => OnClickBuyTech(id)"
                @onmouseenter="() => Tooltips.Show(Tooltips.GetHover(HoverType.Upgrade, id, stage.Id))"
                @onmouseleave="Tooltips.Clear"
                @onfocus="() => Tooltips.Show(Tooltips.GetHover(HoverType.Upgrade, id, stage.Id))"
                @onblur="Tooltips.Clear">
            @id
        </button>
    }
</div>

<div>
    <h3>Unlocked Techs</h3>
    @foreach (var t in unlockedTechs)
    {
        var id = t.Id;
        <button type="button"
                class="icon-button"
                disabled
                @onmouseenter="() => Tooltips.Show(Tooltips.GetHover(HoverType.Tech, id, stage.Id))"
                @onmouseleave="Tooltips.Clear"
                @onfocus="() => Tooltips.Show(Tooltips.GetHover(HoverType.Tech, id, stage.Id))"
                @onblur="Tooltips.Clear">
            @id
        </button>
    }
</div>

@code {
    private bool freeProcess = true;

    private long Total(string kId)
    {
        long total = 0;

        var game = Game.CurrentGame;
        var expansion = Locate.LocateExpansion(game, game.CurrentExpansionId);

        expansion.ExpansionStats.Knowledge.TryGetValue(kId, out var value);
        total = value;

        return total;
    }

    private async Task OnClickBuyTech(string upgradeId)
    {
        if (!Cost.CanAfford(ItemHelper.ItemType.Upgrade, upgradeId, Game.CurrentGame.SelectedStageId))
        {
            Log.Error($"Sem recursos para comprar upgrade {upgradeId}.");
            return;
        }

        if (freeProcess)
        {
            freeProcess = false;
            await Purchase.Purchase(ItemHelper.ItemType.Upgrade, upgradeId, Game.CurrentGame.SelectedStageId);
            freeProcess = true;
        }
        else
        {
            return;
        }
    }
}
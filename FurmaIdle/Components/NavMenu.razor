@inherits UiHelper

@using System.Linq
@using FurmaIdle.Data
@using FurmaIdle.Helpers
@using FurmaIdle.Models
@using FurmaIdle.Services

<div class="nav-menu">
    <div class="nav-col">
        @if (!VisibleNav.Any())
        {
            <div style="padding:8px;border:1px dashed #9aa2b1;border-radius:8px;font-size:12px;opacity:.85">
                NavMenu: nenhum item visível. (Unlocked == true)
            </div>
        }
        else
        {
            @foreach (var it in VisibleNav)
            {
                var isSelected = it.Id == SelectedMenuId;
                <button class="nav-button @(isSelected ? "is-selected" : null)"
                        title="@it.Label"
                        aria-label="@it.Label"
                        aria-pressed="@isSelected"
                        @onclick="() => Select(it.Id)">
                    <span class="nav-glyph">@it.Label</span>
                </button>
            }
        }
    </div>
</div>


@code {
    // ==== PARÂMETROS ====
    /// <summary>Id selecionado (permite usar bind-SelectedMenuId no pai)</summary>
    [Parameter] public string? SelectedMenuId { get; set; } = "i1";
    [Parameter] public EventCallback<string?> SelectedMenuIdChanged { get; set; }

    /// <summary>Callback quando um ícone é selecionado</summary>
    [Parameter] public EventCallback<string> OnSelect { get; set; }

    /// <summary>Pasta base dos ícones (ex.: /icons)</summary>
    [Parameter] public string IconBasePath { get; set; } = "/icons/nav-menu";

    protected override void OnInitialized()
    {
        base.OnInitialized();
        // se quiser carregar algo só uma vez, faça aqui
    }

    protected override void OnGameChanged()
    {
        // se precisar recalcular alguma cache local, faça aqui
        // o base já chama StateHasChanged()
    }

    // ==== MODELO INTERNO ====
    private sealed class NavItem
    {
        public required string Id { get; init; }
        public required string Label { get; init; }
        public bool Unlocked { get; set; }
        public bool Selected { get; set; }
        public bool Notification { get; set; }

        public int SortKey =>
            int.TryParse(Id.AsSpan(1), out var position) ? position : int.MaxValue;
    }

    private readonly List<NavItem> _nav = new()
    {
        new() { Id = "i1", Label = "Stage", Unlocked = true, Selected = true, Notification = false },
        new() { Id = "i2", Label = "Tech", Unlocked = true, Selected = false, Notification = false },
        new() { Id = "i3", Label = "Party", Unlocked = true, Selected = false, Notification = false },
        new() { Id = "i4", Label = "Exped", Unlocked = true, Selected = false, Notification = false },
        new() { Id = "i5", Label = "Expan", Unlocked = true, Selected = false, Notification = false },
        new() { Id = "i6", Label = "Up", Unlocked = true, Selected = false, Notification = false },
        new() { Id = "i97", Label = "Achiev", Unlocked = true, Selected = false, Notification = false },
        new() { Id = "i98", Label = "Out", Unlocked = true, Selected = false, Notification = false },
        new() { Id = "i99", Label = "Sett", Unlocked = true, Selected = false, Notification = false },
    };

    private IEnumerable<NavItem> VisibleNav =>
        _nav.Where(item => item.Unlocked).OrderBy(position => position.SortKey);

    private async Task Select(string id)
    {
        SelectedMenuId = id;
        UI.SetOpenMenu(id);
        if (SelectedMenuIdChanged.HasDelegate)
            await SelectedMenuIdChanged.InvokeAsync(SelectedMenuId);

        if (OnSelect.HasDelegate)
            await OnSelect.InvokeAsync(id);
    }

    private string GetIconPath(string id)
        => $"{IconBasePath}/{id}.jpg";

    public void UnlockMenu(string id)
    {
        var it = _nav.FirstOrDefault(n => n.Id == id);
        it.Unlocked = true;
        StateHasChanged();
    }

    public void LockMenu(string id)
    {
        var it = _nav.FirstOrDefault(n => n.Id == id);
        if (it is not null && it.Unlocked)
        {
            it.Unlocked = false;
            if (SelectedMenuId == id) SelectedMenuId = null;
            StateHasChanged();
        }
    }
}

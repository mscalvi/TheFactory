@inherits UiHelper

@using FurmaIdle.Models

<div class="game-area shop-shell">
    @if (!Game.IsReady || _stage is null || string.IsNullOrWhiteSpace(_stage.Id))
    {
        <div class="contracts-placeholder">Stage não Selecionado</div>
    }
    else
    {
        <div class="shop-header">
            <div class="submenu-tabs">
                @foreach (var tab in UI.VisibleTabs(SelectedMenuId))
                {
                    var isSelected = IsTabSelected(tab.Id);
                    var hasNotif = tab.Notification;

                    <button class="@SubTabClass(isSelected, hasNotif)"
                            @onclick="@(() => SelectTab(tab.Id))">
                        @tab.Label
                    </button>
                }

            </div>
        </div>

        <div class="shop-content">

            @if (SelectedMenuId == "i99")
            {
                <NavSettingsArea />
            }
            else if (SelectedMenuId == "i98")
            {
                <NavStoreArea />
            }
            else
            {
                switch (ActiveTabId)
                {
                    case "guild-hall":
                        <NavGuildHallArea />
                        break;
                    case "guild-contracts":
                        <NavGuildContractsArea />
                        break;
                    case "guild-lab":
                        <NavGuildLabArea />
                        break;
                    case "guild-members":
                        <NavGuildMembersArea />
                        break;

                    case "stage-expedition":
                        <NavStageExpeditionArea />
                        break;
                    case "stage-dock":
                        <NavStageDockArea />
                        break;
                    case "stage-locals":
                        <NavStageLocalsArea />
                        break;

                    case "world-expansion":
                        <NavWorldExpansionArea />
                        break;
                    case "world-ships":
                        <NavWorldShipsArea />
                        break;
                    case "world-map":
                        <NavWorldMapArea />
                        break;
                    case "world-influence":
                        <NavWorldInfluenceArea />
                        break;

                    case "game-info":
                        <NavGameInfoArea />
                        break;
                    case "game-arch":
                        <NavGameArchArea />
                        break;
                    case "game-tips":
                        <NavGameTipsArea />
                        break;

                    default:
                        <div class="tab-placeholder">Selecione uma Aba.</div>
                        break;
                }  
            }
        </div>
    }
</div>

@code {
    private StageModel? _stage;
    private string? SelectedMenuId;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        UI.Changed += OnUiChanged;
        SelectedMenuId = UI.OpenMenuId;
        RefreshStage();
    }

    protected override void OnGameChanged()
    {
        RefreshStage();
    }

    private void OnUiChanged()
    {
        SelectedMenuId = UI.OpenMenuId;
        InvokeAsync(StateHasChanged);
    }

    private void RefreshStage()
    {
        if (!Game.IsReady || string.IsNullOrWhiteSpace(Game?.CurrentGame.SelectedStageId))
        {
            _stage = null;
            return;
        }

        var g = Game.CurrentGame;
        g.Stages.TryGetValue(Game?.CurrentGame.SelectedStageId, out var st);
        _stage = st;
    }

    private string _guildTab = "guild-contracts";
    private string _stageTab = "stage-expedition";
    private string _worldTab = "world-expansion";
    private string _gameTab = "game-info";

    private string? ActiveTabId => SelectedMenuId switch
    {
        "i1" => _guildTab,
        "i2" => _stageTab,
        "i3" => _worldTab,
        "i4" => _gameTab,
        _ => null
    };

    private bool IsTabSelected(string tabId)
        => tabId switch
        {
            "guild-hall" or "guild-contracts" or "guild-lab" or "guild-members"
                => _guildTab == tabId,

            "stage-expedition" or "stage-locals" or "stage-dock"
                => _stageTab == tabId,

            "world-expansion" or "world-influence" or "world-ships" or "world-map"
                => _worldTab == tabId,

            "game-info" or "game-arch" or "game-tips"
                => _gameTab == tabId,

            _ => false
        };

    private void SelectTab(string tabId)
    {
        if (tabId.StartsWith("guild-"))
            _guildTab = tabId;
        else if (tabId.StartsWith("stage-"))
            _stageTab = tabId;
        else if (tabId.StartsWith("world-"))
            _worldTab = tabId;
        else if (tabId.StartsWith("game-"))
            _gameTab = tabId;

        UI.SetOpenTab(tabId);

        StateHasChanged();
    }

    private string SubTabClass(bool isSelected, bool hasNotif)
        => "subnav-button"
           + (isSelected ? " is-selected" : "")
           + (hasNotif ? " has-notif" : "");
}
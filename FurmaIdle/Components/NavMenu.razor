@* ShopMenu.razor *@

@inherits UiHelper

@using FurmaIdle.Models

<div class="game-area shop-shell">
    @if (!Game.IsReady || _stage is null || string.IsNullOrWhiteSpace(_stage.Id))
    {
        <div class="contracts-placeholder">Stage não Selecionado</div>
    }
    else
    {
        <div class="shop-header">
            @RenderSubNav()
        </div>

        <div class="shop-body">
            @if (SelectedMenuId == "i1")
            {
                @* MENU GUILD *@
                @switch (_guildTab)
                {
                    case "expedition":
                        <GuildExpeditionArea />
                        break;

                    case "guildinfo":
                        <GuildInfoArea />
                        break;

                    case "hall":
                        <GuildHallArea />
                        break;

                    case "manage":
                        <GuildManagerArea />
                        break;

                    default:
                        <GuildExpeditionArea />
                        break;
                }
            }
            else if (SelectedMenuId == "i2")
            {
                @* MENU WORLD *@
                @switch (_worldTab)
                {
                    case "expansion":
                        <WorldExpansionArea />
                        break;

                    case "dock":
                        <WorldShipsArea />
                        break;

                    case "map":
                        <WorldMapArea />
                        break;

                    case "lab":
                        <WorldTechArea />
                        break;

                    default:
                        <WorldExpansionArea />
                        break;
                }
            }
            else if (SelectedMenuId == "i3")
            {
                @* MENU GAME *@
                @switch (_gameTab)
                {
                    case "info":
                        <GameInfoArea />
                        break;

                    case "arch":
                        <GameArchArea />
                        break;

                    case "tips":
                        <GameTipsArea />
                        break;

                    default:
                        <GameInfoArea />
                        break;
                }
            }
            else
            {
                @* MENUS SEM SUBTABS *@
                @switch (SelectedMenuId)
                {
                    case "i5":
                        <StoreArea />
                        break;

                    case "i6":
                        <SettingsArea />
                        break;

                    default:
                        <SettingsArea />
                        break;
                }
            }
        </div>
    }
</div>


@code {
    private StageModel? _stage;
    private string? SelectedMenuId;

    private string _guildTab = "manager";
    private string _worldTab = "expansion";
    private string _gameTab = "info";

    protected override void OnInitialized()
    {
        base.OnInitialized();
        UI.Changed += OnUiChanged;
        SelectedMenuId = UI.OpenMenuId;
        RefreshStage();
    }

    protected override void OnGameChanged()
    {
        RefreshStage();
    }

    private void OnUiChanged()
    {
        SelectedMenuId = UI.OpenMenuId;
        InvokeAsync(StateHasChanged);
    }

    private void RefreshStage()
    {
        if (!Game.IsReady || string.IsNullOrWhiteSpace(Game?.CurrentGame.SelectedStageId))
        {
            _stage = null;
            return;
        }

        var g = Game.CurrentGame;
        g.Stages.TryGetValue(Game?.CurrentGame.SelectedStageId, out var st);
        _stage = st;
    }

    private RenderFragment RenderSubNav() => 
        @<div>
            @* GUILD (i1) *@
            @if (SelectedMenuId == "i1")
                {
                <div class="submenu-tabs">
                    <button class="@SubTabClass(_guildTab, "expedition")"
                            @onclick="@(() => _guildTab = "expedition")">
                        Expedição
                    </button>

                    <button class="@SubTabClass(_guildTab, "guildinfo")"
                            @onclick="@(() => _guildTab = "guildinfo")">
                        Guild Info
                    </button>

                    <button class="@SubTabClass(_guildTab, "hall")"
                            @onclick="@(() => _guildTab = "hall")">
                        Guild Hall
                    </button>

                    <button class="@SubTabClass(_guildTab, "manage")"
                            @onclick="@(() => _guildTab = "manage")">
                        Gerência
                    </button>
                </div>
                }
            @* WORLD (i2) *@
                else if (SelectedMenuId == "i2")
                {
                <div class="submenu-tabs">
                    <button class="@SubTabClass(_worldTab, "expansion")"
                            @onclick="@(() => _worldTab = "expansion")">
                        Expansão
                    </button>

                    <button class="@SubTabClass(_worldTab, "dock")"
                            @onclick="@(() => _worldTab = "dock")">
                        Doca
                    </button>

                    <button class="@SubTabClass(_worldTab, "map")"
                            @onclick="@(() => _worldTab = "map")">
                        Mapa
                    </button>

                    <button class="@SubTabClass(_worldTab, "lab")"
                            @onclick="@(() => _worldTab = "lab")">
                        Lab
                    </button>
                </div>
                }
            @* WORLD (i3) *@
                else if (SelectedMenuId == "i3")
                {
                <div class="submenu-tabs">
                    <button class="@SubTabClass(_gameTab, "info")"
                    @onclick="@(() => _gameTab = "info")">
                        Informações
                    </button>

            <button class="@SubTabClass(_gameTab, "arch")"
                    @onclick="@(() => _gameTab = "arch")">
                        Archievments
                    </button>

            <button class="@SubTabClass(_gameTab, "tips")"
                    @onclick="@(() => _gameTab = "tips")">
                        Manual
                    </button>
                </div>
                }
                else
                {
            @* Menus que não têm sub-abas (Game, Store, Settings...) *@
                <div class="submenu-tabs submenu-tabs--empty"></div>
                }
        </div>;

        private string SubTabClass(string current, string id)
         => "subnav-button" + (current == id ? " is-selected" : "");

}
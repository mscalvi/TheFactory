@inherits UiHelper

@using FurmaIdle.Models
@using FurmaIdle.Services
@using FurmaIdle.Data
@using FurmaIdle.Helpers

@inject ILocateService Locate
@inject IIncomeService Income
@inject IClickService Clicks
@inject IJSRuntime JS

<div class="game-area" @ref="_root" @onpointerdown="HandleClick">
    <img class="click-stage-img"
         src="@LocalImagePath()"
         alt="@($"Stage {_stage?.Name ?? _stage?.Id ?? "—"}")"
         draggable="false" />
</div>

@code {
    private StageModel? _stage;
    private LocalModel? _currentLocal;
    private ElementReference _root;

    private string LocalImagePath()
    {
        if (!Game.IsReady || string.IsNullOrWhiteSpace(Game.CurrentGame.SelectedStageId))
            return "images/locals/a.svg";

        var stageId = Game.CurrentGame.SelectedStageId;

        // pega o último Local desbloqueado desse stage
        _currentLocal = Game.CurrentGame.Locals.Values
            .Where(l => l.StageId == stageId && l.State == UnlockHelper.State.Unlocked)
            .OrderBy(l => l.Id) // ou Order, Level… o critério que você usa
            .LastOrDefault();

        return !string.IsNullOrWhiteSpace(_currentLocal?.Image)
            ? _currentLocal!.Image
            : "images/locals/a.svg";
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        RefreshStage();
    }

    protected override void OnGameChanged()
    {
        RefreshStage();
    }

    private void RefreshStage()
    {
        if (!Game.IsReady || string.IsNullOrWhiteSpace(Game?.CurrentGame.SelectedStageId))
        {
            _stage = null;
            return;
        }

        var g = Game.CurrentGame;
        g.Stages.TryGetValue(Game?.CurrentGame.SelectedStageId, out var st);
        _stage = st;
    }

    private double GetClickAmount() => Clicks.ClickGain;

    private async Task HandleClick(PointerEventArgs e)
    {
        if (_stage is null) return;

        var expedition = _stage.Expedition;
        if (expedition.ExpeditionState == UnlockHelper.ExpeditionState.Idle) return;

        await Clicks.Click();

        var amount = GetClickAmount();
        var text = $"+{amount:0.#}";

        var coin = Locate.LocateCoin(Game.CurrentGame, _stage.CoinId);
        var iconPath = coin.Image;

        await JS.InvokeVoidAsync(
            "ClickPops.spawn",
            _root,                     // <<–– agora vai o elemento, não a string
            text,
            new { durationMs = 800, icon = iconPath }
        );
    }

}
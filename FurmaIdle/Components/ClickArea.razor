@inherits UiHelper

@using FurmaIdle.Models
@using FurmaIdle.Services
@using FurmaIdle.Data
@using FurmaIdle.Helpers

@inject ILocateService Locate
@inject IIncomeService Income
@inject IClickService Clicks

@if (!Game.IsReady || _stage is null)
{
    <div class="contracts-placeholder">Stage não Selecionado</div>
}
else
{
    <div class="click-area-root" @ref="_root" @onpointerdown="HandleClick">
        <img class="click-stage-img"
             src="@StageImagePath()"
             alt="@($"Stage {_stage?.Name ?? _stage?.Id ?? "—"}")"
             draggable="false" />

        @foreach (var p in _pops)
        {
            <span class="click-pop"
                  style="left:@p.Xpx; top:@p.Ypx; --dx:@p.Dxpx; --dy:@p.Dypx; --dur:@p.Durms;">
                @p.Text
            </span>
        }
    </div>
}

@code {
    [Inject] IJSRuntime JS { get; set; } = default!;

    private StageModel? _stage;

    private string StageImagePath()
        => StageImageHelper.GetStageImagePath(Game.CurrentGame, _stage!);

    [Parameter] public EventCallback<int> OnClick { get; set; }
    [Parameter] public EventCallback<double> ClickAdd { get; set; }

    private ElementReference _root;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        RefreshStage();
    }

    protected override void OnGameChanged()
    {
        RefreshStage();
    }

    private void RefreshStage()
    {
        if (!Game.IsReady || string.IsNullOrWhiteSpace(Game?.CurrentGame.SelectedStageId))
        {
            _stage = null;
            return;
        }

        var g = Game.CurrentGame;
        g.Stages.TryGetValue(Game?.CurrentGame.SelectedStageId, out var st);
        _stage = st;
    }

    private double GetClickAmount() => Clicks.ClickGain;

    private async Task HandleClick(PointerEventArgs e)
    {
        if (_stage is null) return;

        var expedition = _stage.Expedition;
        if (expedition.ExpeditionState == UnlockHelper.ExpeditionState.Idle) return;

        await Clicks.Click();

        var pos = await JS.InvokeAsync<Pos>("ClickArea.getPos", _root, e);

        var originOffsetY = _rng.Next(4, 9);     // 4..8 px acima
        var originOffsetX = _rng.Next(-5, 6);    // -5..+5 px

        var dx = (_rng.NextDouble() * 40) - 20;  // -20..+20 px
        var dy = -(_rng.Next(64, 104));          // sobe 64..104 px
        var dur = $"{_rng.Next(650, 850)}ms";

        var amount = GetClickAmount();
        var id = $"p{++_seq}";
        var pop = new Pop(id, $"+{amount:0.#}", pos.x + originOffsetX, pos.y - originOffsetY, dx, dy, dur);

        _pops.Add(pop);
        StateHasChanged();

        try
        {
            await Task.Delay(1000);
            var i = _pops.FindIndex(p => p.Id == id);
            if (i >= 0) { _pops.RemoveAt(i); await InvokeAsync(StateHasChanged); }
        }
        catch { /* ignore */ }
    }

    private readonly record struct Pos(double x, double y);

    private sealed record Pop(string Id, string Text, double X, double Y, double Dx, double Dy, string Dur)
    {
        public string Xpx => $"{X}px";
        public string Ypx => $"{Y}px";
        public string Dxpx => $"{Dx}px";
        public string Dypx => $"{Dy}px";
        public string Durms => Dur;
    }

    private readonly List<Pop> _pops = new();
    private int _seq;
    private readonly Random _rng = new();
}
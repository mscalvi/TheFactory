@using FurmaIdle.Models
@using FurmaIdle.Services
@using FurmaIdle.Data
@using FurmaIdle.Helpers

@inject ICurrentGameService Game
@inject ILocateService Locate
@inject IIncomeService Income

@if (LoadGameReady())
{
    <p>Carregando…</p>
}
else
{
    <div class="click-area-root"
         @oncontextmenu:preventDefault
         @onpointerdown="Click"
         tabindex="0">

        @* imagem do stage cobrindo 100% *@
        @{
            var game = Game.CurrentGame;
            var stageId = game?.SelectedStageId;
            StageModel? Stage = null;
            if (!string.IsNullOrWhiteSpace(stageId))
                game?.Stages?.TryGetValue(stageId, out Stage);

            var stageImg = !string.IsNullOrWhiteSpace(stageId)
            ? $"images/stages/{stageId}_0000.jpg"
            : $"Stage: {Stage.Name}";
        }

        <img class="click-stage-img"
             src="@stageImg"
             alt="@($"Stage {Stage?.Name ?? Stage?.Id ?? "—"}")" />

        @* HUD simples (opcional) *@
        <div class="click-hud">
            <h3>@(Stage?.Name ?? Stage?.Id ?? "—")</h3>
            <small>Click Gain: @GetClickTotalString()</small>
        </div>

        @* textos flutuantes dos cliques *@
        @foreach (var clickVisual in _ClickVisual)
        {
            <span class="click-fx"
                  style="left:@clickVisual.Xpx; top:@clickVisual.Ypx">
                @clickVisual.Text
            </span>
        }
    </div>
}

@code {

    private bool LoadGameReady()
    {
        GameModel CurrentGame = Game.CurrentGame;
        if (CurrentGame.On)
        {
            return true;
        }
        else
        {
            return false;
        }
    }

    // eventos externos
    [Parameter] public EventCallback<int> OnClick { get; set; }
    [Parameter] public EventCallback<double> ClickAdd { get; set; }

    // Efeito Visual do Click
    private sealed class ClickVisual
    {
        public required string Text { get; init; }
        public required string Xpx { get; init; }
        public required string Ypx { get; init; }
        public required long BornMs { get; init; }
        public int LifespanMs { get; init; } = 700;
    }
    private readonly List<ClickVisual> _ClickVisual = new();

    private async Task Click(PointerEventArgs e)
    {
        var ClickTotal = GetClickTotal();

        var game = Game.CurrentGame;
        var stageId = game?.SelectedStageId;

        if (!string.IsNullOrWhiteSpace(stageId) &&
            game?.Stages is not null &&
            game.Stages.TryGetValue(stageId, out var stage) &&
            !string.IsNullOrWhiteSpace(stage.CoinId))
        {
            var gain = await Income.AddAsync(ItemHelper.ItemType.Coin, stage.CoinId, ClickTotal);
        }

        var now = Environment.TickCount64;
        var clickVisual = new ClickVisual
        {
            Text = $"+{ClickTotal:0.##}",
            Xpx = $"{e.ClientX + 4}px",
            Ypx = $"{e.ClientY - 12}px",
            BornMs = now
        };
        _ClickVisual.Add(clickVisual);

        StateHasChanged();

        // Remove o Efeito Visual
        _ = Task.Run(async () =>
        {
            await Task.Delay(clickVisual.LifespanMs);
            _ClickVisual.Remove(clickVisual);
            await InvokeAsync(StateHasChanged);
        });
    }

    // ===== Cálculo do ClickTotal =====
    // ClickTotal = (BaseGain + AddMod) * MultMod
    private double GetClickTotal()
    {
        var game = Game.CurrentGame;
        var stageId = game?.SelectedStageId;
        if (string.IsNullOrWhiteSpace(stageId)) return 0;

        ClickModel Click = Locate.LocateStageClick(stageId);

        var baseGain = Click.BaseGain;
        var addMod = Click.AddMod;
        var multMod = Click.MultMod <= 0 ? 1.0 : Click.MultMod;
        return (baseGain + addMod) * multMod;
    }

    private string GetClickTotalString() => GetClickTotal().ToString("0.##");
}

@* Components/ShopMenuShips.razor *@
@inherits UiHelper

@using FurmaIdle.Helpers
@using FurmaIdle.Models
@using FurmaIdle.Services

@inject ILocateService Locate
@inject ITooltipService Tooltips
@inject IUiLogService Log
@inject IShipService Ships

<div class="menu-root">
    @if (!Game.IsReady || _stage is null)
    {
        <div class="contracts-placeholder">Stage não selecionado.</div>
    }
    else
    {
        <div class="menu-panel ships-layout">
            @if (_ships.Count == 0)
            {
                <div class="ships-empty">
                    <p>Nenhum navio atracado neste porto.</p>
                    <p class="ships-empty-hint">
                        Construa um navio e traga-o para esta região para começar a explorá-la.
                    </p>
                </div>
            }
            else
            {
                var ship = _ships[_currentShipIndex];
                var selectedRouteId = GetSelectedRouteId(ship.Id);
                var routeSelected = !string.IsNullOrWhiteSpace(selectedRouteId)
                ? FindRoute(selectedRouteId)
                : null;

                <!-- TOPO: navegação entre navios -->
                <div class="ship-top-nav">
                    <button class="ship-nav-btn"
                            disabled="@(_currentShipIndex <= 0)"
                            @onclick="PrevShip">
                        ‹
                    </button>

                    <div class="ship-top-current">
                        <div class="ship-icon">
                            @if (!string.IsNullOrWhiteSpace(ship.Icon))
                            {
                                <img src="@ship.Icon" alt="@ship.Name" />
                            }
                            else
                            {
                                <div class="ship-icon-fallback">@ship.Id</div>
                            }
                        </div>
                        <div class="ship-header-text">
                            <div class="ship-name">@ship.Name</div>
                            <div class="ship-sub">
                                @ShipStateLabel(ship)
                            </div>
                        </div>
                    </div>

                    <button class="ship-nav-btn"
                            disabled="@(_currentShipIndex >= _ships.Count - 1)"
                            @onclick="NextShip">
                        ›
                    </button>
                </div>

                <!-- MEIO: informações do navio + rota selecionada -->
                <section class="ship-middle">
                    <div class="ship-info-block">
                        <div class="ship-info-row">
                            <span class="ship-info-label">Situação:</span>
                            <span class="ship-info-value">@ShipStateLabel(ship)</span>
                        </div>

                        @* Aqui você pode encaixar velocidade / tripulação quando tiver as props certinhas *@
                        @* 
                        <div class="ship-info-row">
                            <span class="ship-info-label">Velocidade:</span>
                            <span class="ship-info-value">@ship.Speed</span>
                        </div>
                        <div class="ship-info-row">
                            <span class="ship-info-label">Tripulação:</span>
                            <span class="ship-info-value">@ship.CrewAtual / @ship.CrewMax</span>
                        </div>
                        *@

                        @if (routeSelected is not null)
                        {
                            <div class="ship-info-row">
                                <span class="ship-info-label">Rota:</span>
                                <span class="ship-info-value">@routeSelected.Name</span>
                            </div>
                            <div class="ship-info-row">
                                <span class="ship-info-label">Distância:</span>
                                <span class="ship-info-value">@routeSelected.Distance</span>
                            </div>

                            @* Exemplo de progresso: ajusta conforme seu modelo (TravelProgress vs Distance) *@
                            <div class="ship-info-row">
                                <span class="ship-info-label">Progresso:</span>
                                <span class="ship-info-value">
                                    @ship.TravelProgress / @routeSelected.Distance
                                </span>
                            </div>
                        }
                        else
                        {
                            <div class="ship-info-row">
                                <span class="ship-info-label">Rota:</span>
                                <span class="ship-info-value ship-info-hint">
                                    Selecione uma rota abaixo.
                                </span>
                            </div>
                        }
                    </div>

                    <div class="ship-middle-actions">
                        @{
                            bool hasRoute = routeSelected is not null;
                            bool canStart = hasRoute && CanStartVoyage(ship, routeSelected!);
                        }

                        <button class="btn ship-start-button @(canStart ? null : "is-locked")"
                                disabled="@( !canStart )"
                                @onclick="() => StartVoyage(ship, routeSelected)">
                            @if (routeSelected is null)
                            {
                                <span>Escolha uma rota</span>
                            }
                            else
                            {
                                <span>@RouteButtonLabel(ship, routeSelected)</span>
                            }
                        </button>
                    </div>
                </section>

                <!-- BAIXO: grid de rotas -->
                <section class="ship-routes-section">
                    <h4 class="ship-routes-title">Rotas a partir desta região</h4>

                    <div class="ship-routes-grid">
                        @foreach (var route in _routesFromStage)
                        {
                            bool isSelected = route.Id == selectedRouteId;
                            bool isBusy = _busyRouteIds.Contains(route.Id);
                            bool canStartThisRoute = CanStartVoyage(ship, route);
                            bool isDisabled = isBusy || !canStartThisRoute;

                            <button class="ship-route-card
                                                       @(isSelected ? "is-selected" : null)
                                                       @(isDisabled ? "is-locked" : null)"
                                    disabled="@isDisabled"
                                    @onclick="() => OnRouteSelected(ship.Id, route.Id)">
                                <div class="ship-route-image">
                                    @if (!string.IsNullOrWhiteSpace(route.Icon))
                                    {
                                        <img src="@route.Icon" alt="@route.Name" />
                                    }
                                    else
                                    {
                                        <span class="ship-route-icon-fallback">
                                            @route.Name
                                        </span>
                                    }
                                </div>

                                <div class="ship-route-name">
                                    @route.Name
                                </div>

                                <div class="ship-route-meta">
                                    @if (IsRouteKnown(route))
                                    {
                                        <span>Rota conhecida</span>
                                    }
                                    else
                                    {
                                        <span>Rota desconhecida</span>
                                    }

                                    @if (isBusy)
                                    {
                                        <span> · Em uso</span>
                                    }
                                </div>
                            </button>
                        }
                    </div>
                </section>
            }
        </div>
    }
</div>

@code {
    private StageModel? _stage;
    private readonly List<ShipModel> _ships = new();
    private readonly List<RouteModel> _routesFromStage = new();
    private readonly HashSet<string> _busyRouteIds = new();

    // shipId -> routeId selecionada na UI
    private readonly Dictionary<string, string?> _selectedRouteByShip = new();

    private int _currentShipIndex = 0;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        RefreshStage();
    }

    protected override void OnGameChanged()
    {
        RefreshStage();
    }

    private void RefreshStage()
    {
        _ships.Clear();
        _routesFromStage.Clear();
        _busyRouteIds.Clear();

        if (!Game.IsReady || string.IsNullOrWhiteSpace(Game?.CurrentGame.SelectedStageId))
        {
            _stage = null;
            _currentShipIndex = 0;
            return;
        }

        var g = Game.CurrentGame;
        if (!g.Stages.TryGetValue(Game.CurrentGame.SelectedStageId, out var st))
        {
            _stage = null;
            _currentShipIndex = 0;
            return;
        }

        _stage = st;

        // Navios atracados neste stage
        if (g.Ships is not null)
        {
            foreach (var ship in g.Ships.Values)
            {
                if (ship is null) continue;
                if (ship.State != UnlockHelper.State.Unlocked) continue;
                if (!string.Equals(ship.InStageId, _stage.Id, StringComparison.Ordinal)) continue;

                _ships.Add(ship);

                // Marca rotas ocupadas (para desabilitar na grid)
                if (!string.IsNullOrEmpty(ship.InRouteId)
                    && (ship.ShipState == UnlockHelper.ShipState.InDiscovery
                        || ship.ShipState == UnlockHelper.ShipState.InRoute))
                {
                    _busyRouteIds.Add(ship.InRouteId);
                }
            }
        }

        // Rotas que saem deste stage
        if (g.Routes is not null)
        {
            foreach (var route in g.Routes.Values)
            {
                if (route is null) continue;
                if (!string.Equals(route.PointA, _stage.Id, StringComparison.Ordinal)) continue;
                if (route.RouteState == UnlockHelper.RouteState.Blocked) continue;

                _routesFromStage.Add(route);
            }
        }

        // Ordena para visual estável
        _ships.Sort((a, b) => string.Compare(a.Id, b.Id, StringComparison.Ordinal));
        _routesFromStage.Sort((a, b) => string.Compare(a.Id, b.Id, StringComparison.Ordinal));

        // Garante índice válido
        if (_ships.Count == 0)
        {
            _currentShipIndex = 0;
        }
        else if (_currentShipIndex >= _ships.Count)
        {
            _currentShipIndex = _ships.Count - 1;
        }
    }

    private void PrevShip()
    {
        if (_currentShipIndex > 0)
        {
            _currentShipIndex--;
            StateHasChanged();
        }
    }

    private void NextShip()
    {
        if (_currentShipIndex < _ships.Count - 1)
        {
            _currentShipIndex++;
            StateHasChanged();
        }
    }

    private string? GetSelectedRouteId(string shipId)
    {
        if (_selectedRouteByShip.TryGetValue(shipId, out var id))
            return id;
        return null;
    }

    private void OnRouteSelected(string shipId, string? routeId)
    {
        if (string.IsNullOrWhiteSpace(routeId))
        {
            _selectedRouteByShip[shipId] = null;
        }
        else
        {
            _selectedRouteByShip[shipId] = routeId;
        }

        StateHasChanged();
    }

    private RouteModel? FindRoute(string routeId)
    {
        var g = Game.CurrentGame;
        if (g?.Routes is null) return null;

        g.Routes.TryGetValue(routeId, out var route);
        return route;
    }

    private string ShipStateLabel(ShipModel ship)
    {
        return ship.ShipState switch
        {
            UnlockHelper.ShipState.InDiscovery => "Em viagem de descoberta",
            UnlockHelper.ShipState.InRoute => "Em rota",
            UnlockHelper.ShipState.InStage => "Atracado",
            _ => "Indefinido"
        };
    }

    private string RouteActionLabel(RouteModel route)
    {
        if (IsRouteKnown(route))
            return "Melhorar relações com esta região.";
        else
            return "Descobrir essa rota marítima.";
    }

    private string RouteButtonLabel(ShipModel ship, RouteModel route)
    {
        if (ship.ShipState == UnlockHelper.ShipState.InDiscovery ||
            ship.ShipState == UnlockHelper.ShipState.InRoute)
        {
            return "Viagem em andamento...";
        }

        return IsRouteKnown(route)
            ? "Iniciar rota para melhorar relações"
            : "Iniciar viagem de descoberta";
    }

    private bool CanStartVoyage(ShipModel ship, RouteModel route)
    {
        return Ships.CanStartVoyage(ship, route);
    }

    private bool IsRouteKnown(RouteModel route)
    {
        return route.RouteState == UnlockHelper.RouteState.Known;
    }

    private void StartVoyage(ShipModel ship, RouteModel? route)
    {
        if (route is null) return;

        var ok = Ships.StartVoyage(ship.Id, route.Id);

        if (!ok)
        {
            Log.Error($"[Navios] Não foi possível iniciar a viagem de {ship.Name} para {route.Name}.");
        }
        // ShipService deve disparar GameChanged → RefreshStage cuida do resto.
    }
}

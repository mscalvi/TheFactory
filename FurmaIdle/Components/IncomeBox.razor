@using System.Linq
@using FurmaIdle.Data
@using FurmaIdle.Helpers
@using FurmaIdle.Models
@using FurmaIdle.Services

@inject ICurrentGameService Game

@if (!_ready)
{
    <p>Carregando…</p>
}
else
{
    <section class="income-box panel">
        <h4>Income</h4>

        @if (Game.CurrentGame?.Coins is not { Count: > 0 })
        {
            <p>Carregando…</p>
        }
        else
        {
            var list = GetUnlockedCoins().ToList();

            if (list.Count == 0)
            {
                <p>Nenhuma moeda desbloqueada</p>
            }
            else
            {
                <ul class="income-list">
                    @foreach (var it in list)
                    {
                        <li class="income-row">
                            <span class="income-name">@it.Name</span>
                            <span class="income-total">@FormatTotal(it.Coin)</span>
                            <span class="income-ps">(@FormatPerSecond(it.Coin))/s</span>
                        </li>
                    }
                </ul>
            }
        }
    </section>
}


@code {

    private bool _ready = false;


    // ---- helpers ----

    // Projeta para um DTO de tela com Name resolvido via runtime -> catálogo -> id
    private IEnumerable<(CoinModel Coin, string Name)> GetUnlockedCoins()
    {
        var g = Game.CurrentGame!;
        var order = CoinsData.ShowOrder ?? new List<string>();

        foreach (var id in order)
        {
            if (!g.Coins.TryGetValue(id, out var coin)) continue;
            if (coin.State != UnlockHelper.State.Unlocked) continue;

            var name =
                (!string.IsNullOrWhiteSpace(coin.Name) ? coin.Name :
                 CoinsData.GetDef(id)?.Name) ?? id;

            yield return (coin, name);
        }

        // caso falte algum no ShowOrder, cai para os que sobraram
        var leftovers = g.Coins.Values
            .Where(c => c.State == UnlockHelper.State.Unlocked &&
                        (order == null || !order.Contains(c.Id)))
            .OrderBy(c => c.Id, StringComparer.Ordinal);

        foreach (var c in leftovers)
        {
            var name =
                (!string.IsNullOrWhiteSpace(c.Name) ? c.Name :
                 CoinsData.GetDef(c.Id)?.Name) ?? c.Id;

            yield return (c, name);
        }
    }

    // Placeholders: ajusta quando o CoinModel tiver os campos reais
    private static string FormatTotal(CoinModel coin)
    {
        // se existir coin.Total ou coin.Amount, use-o. Placeholder por enquanto:
        // return coin.Amount.ToString("N0", CultureInfo.InvariantCulture);
        return "0";
    }

    private static string FormatPerSecond(CoinModel coin)
    {
        // se existir coin.PerSecond, use-o. Placeholder por enquanto:
        return "+0";
    }
}

@inherits UiHelper

@using FurmaIdle.Services
@using FurmaIdle.Helpers
@using FurmaIdle.Models

@inject ILocateService Locate
@inject IContractsService Contracts
@inject IResourcesService Resource

<section class="income-box panel">
    <!-- TOPO: COINS -->
    @{
        var coins = GetCoinTiles();
        var coinCount = coins.Count;
    }
    <div class="band band-coins" style="--count:@(coinCount)">
        @foreach (var it in coins)
        {
            <div class="coin-camp">
                <img class="image-resource" src="@it.Image"
                     alt="@it.Id"
                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                <span class="income-total">
                    @it.Total.ToString("N0")
                    @if (it.PerSec > 0)
                    {
                        <text> +@it.PerSec.ToString("N2")/s</text>
                    }
                </span>
            </div>
        }
    </div>

    <div class="band-divider" aria-hidden="true"></div>

    <!-- BASE: RESOURCES -->
    @{
        var res = GetResourceTiles();
        var resCount = res.Count;
    }
    <div class="band band-resources" style="--count:@(resCount)">
        @foreach (var it in res)
        {
            <div class="coin-camp">
                <img class="image-resource" src="@it.Image"
                     alt="@it.Id"
                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                <span class="income-total">
                    @it.Total.ToString("N0") / @it.Cap.ToString()
                    @if (it.PerSec > 0)
                    {
                        <text> +@it.PerSec.ToString("N2")/s</text>
                    }
                </span>
            </div>
        }
    </div>
</section>


@code {
    protected override void OnInitialized()
    {
        base.OnInitialized();
    }

    protected override void OnGameChanged()
    {
        base.OnGameChanged();
    }

    private sealed record TileVM(string Id, string Image, long Total, long Cap, double PerSec);

    // COINS (topo)
    private List<TileVM> GetCoinTiles()
    {
        var game = Game.CurrentGame;
        var list = new List<TileVM>();

        if (game?.Coins is null) return list;

        // produção por segundo por moeda (dos contratos)
        var perSecByCoin = Contracts.GetTotalContractsPerSecond(game);

        foreach (var kv in game.Coins)
        {
            var coin = kv.Value;
            if (coin.State != UnlockHelper.State.Unlocked) continue;

            // total atual
            long total = 0;
            foreach (var stage in game.Stages)
            {
                if (stage.Value.ExpeditionStats?.Coins?.TryGetValue(coin.Id, out var t) == true)
                    total = t;
            }

            // per-sec (se existir)
            perSecByCoin.TryGetValue(coin.Id, out var psec);

            list.Add(new TileVM(coin.Id, coin.Image, total, 0, psec));
        }

        return list;
    }

    // RESOURCES (base)
    private List<TileVM> GetResourceTiles()
    {
        var game = Game.CurrentGame;
        var list = new List<TileVM>();

        if (game?.Resources is null) return list;

        foreach (var kv in game.Resources)
        {
            var psec = Resource.GetResourceInfo(game, kv.Value.Id);

            var res = kv.Value;
            if (res.State != UnlockHelper.State.Unlocked) continue;

            // total atual (se você guarda em ExpeditionStats)
            long total = 0;
            foreach (var stage in game.Stages)
            {
                if (stage.Value.ExpeditionStats?.Resources?.TryGetValue(res.Id, out var t) == true)
                    total = t;
            }

            list.Add(new TileVM(res.Id, res.Image, total, psec.rsCap, psec.rsRegen));
        }

        return list;
    }
}

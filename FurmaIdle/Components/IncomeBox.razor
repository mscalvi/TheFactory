@using FurmaIdle.Services
@using FurmaIdle.Helpers
@using FurmaIdle.Models

@inject ICurrentGameService Game
@inject ILocateService Locate

<section class="income-box panel">
    @{
        var unlocked = GetCoins().ToList();
        <ul class="income-list">
            @if (unlocked == null)
            {
                <p>Nenhuma moeda desbloqueada.</p>
            }
            else
            {
                foreach (var it in unlocked)
                {
                    <li class="income-row">
                        <span class="income-name">@it.Key</span>
                        <span class="income-total">@it.Value</span>
                    </li>
                }
            }
        </ul>
    }
</section>

@code {
    private bool IsReady = false;

    Dictionary<string, string> CoinsTotal = new();
    Dictionary<string, double> CoinsPerSecond = new();

    Dictionary<string, string> Broken = new();

    protected override void OnInitialized()
    {
        // Atualiza quando o jogo muda (Init, clicks, etc.)
        Game.GameChanged += OnGameChanged;
        OnGameChanged();
    }

    private void OnGameChanged()
    {
        IsReady = Game.IsReady && Game.CurrentGame is not null;
        InvokeAsync(StateHasChanged);
    }

    private Dictionary<string, string> GetCoins()
    {
        var g = Game.CurrentGame;
        CoinsTotal.Clear();
        Broken.Clear();

        if (IsReady)
        {
            Console.WriteLine($"[Income] Getting Coins");

            var order = g.Coins;

            foreach (string coinId in order.Keys)
            {
                CoinModel coin = Locate.LocateCoin(coinId);
                if (coin.State != UnlockHelper.State.Unlocked)
                {
                    continue;
                }

                g.Stats.Coins.TryGetValue(coinId, out var current);
                Console.WriteLine($"[Income] Computando {coin.Name} = {current}");

                string formatedValue = FormatTotal(current);

                Console.WriteLine($"[Income] Computando {coinId} = {formatedValue}");
                CoinsTotal.Add(coin.Name, formatedValue);
            }
            return CoinsTotal;
        }
        else
        {
            Console.WriteLine($"[Income] Tentaiva Falha");
            Broken.Add("Moedas", "Quebradas");
            return Broken;
        }
    }

    private static string FormatTotal(long current)
    {
        string formatedTotal = current.ToString();
        return formatedTotal;
    }

    public void Dispose() => Game.GameChanged -= OnGameChanged;
}

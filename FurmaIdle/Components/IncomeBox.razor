@inherits UiHelper

@using FurmaIdle.Services
@using FurmaIdle.Helpers
@using FurmaIdle.Models

@inject ILocateService Locate
@inject IContractsService Contracts

<section class="income-box panel">
    @{
        var rows = GetCoins();
        <ul class="income-list">
            @if (rows.Count == 0)
            {
                <p>Nenhuma moeda desbloqueada.</p>
            }
            else
            {
                foreach (var it in rows)
                {
                    <li class="income-row">
                        <span class="income-name">@it.Key</span>
                        <span class="income-total">
                            @it.Value.total.ToString("N0")
                            @if (it.Value.perSec > 0)
                            {
                                <text> +@it.Value.perSec.ToString("N2") /s</text>
                            }
                        </span>
                    </li>
                }
            }
        </ul>
    }
</section>

@code {
    private readonly Dictionary<string, long> _lastTotals = new(StringComparer.Ordinal);
    private DateTime _lastSampleUtc = DateTime.UtcNow;

    private readonly Dictionary<string, double> _emaRates = new(StringComparer.Ordinal);
    private const double EmaAlpha = 0.5;

    protected override void OnInitialized()
    {
        base.OnInitialized();
    }

    protected override void OnGameChanged()
    {
        var g = Game.CurrentGame;
        if (g is null) return;

        var now = DateTime.UtcNow;
        var dt = (now - _lastSampleUtc).TotalSeconds;
        if (dt <= 0) return;

        var statsCoins = g.ExpeditionStats?.Coins;
        if (statsCoins is not null)
        {
            foreach (var kv in statsCoins)
            {
                var id = kv.Key;
                var cur = kv.Value;

                _lastTotals.TryGetValue(id, out var prev);
                var rawRate = Math.Max(0, (cur - prev) / dt);

                if (_emaRates.TryGetValue(id, out var old))
                    _emaRates[id] = old + EmaAlpha * (rawRate - old);
                else
                    _emaRates[id] = rawRate;

                _lastTotals[id] = cur;
            }
        }

        _lastSampleUtc = now;

        base.OnGameChanged();
    }

    private static string FormatTotal(long v) => v.ToString("N0");

    private static string FormatRate(double r)
        => r >= 1000 ? r.ToString("0,0.##") : r.ToString("0.##");

    private Dictionary<string, (long total, double perSec)> GetCoins()
    {
        var result = new Dictionary<string, (long, double)>();
        if (Game.CurrentGame is null) return result;

        var g = Game.CurrentGame;
        foreach (var kv in g.Coins)
        {
            var coinId = kv.Key;

            long current = 0;
            if (g.ExpeditionStats?.Coins?.TryGetValue(coinId, out var v) == true)
                current = v;

            var perSec = Contracts.GetContractsPerSecond(g, g.SelectedStageId, coinId);
            result[coinId] = (current, perSec);
        }
        return result;
    }
}

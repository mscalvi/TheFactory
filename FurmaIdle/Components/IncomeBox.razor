@inherits UiHelper

@using FurmaIdle.Services
@using FurmaIdle.Helpers
@using FurmaIdle.Models

@inject ILocateService Locate
@inject IContractsService Contracts

<section class="income-box panel">
    @foreach (var it in GetCoins())
    {
        <ul>
            <li class="income-row">
                <span class="nano-image"></span>
                <span class="income-name">@it.Key</span>
                <span class="income-total">
                    @it.Value.total.ToString("N0")
                    @if (it.Value.perSec > 0)
                    {
                        <text> +@it.Value.perSec.ToString("N2") /s</text>
                    }
                </span>
            </li>
        </ul>
    }
</section>

@code {
    protected override void OnInitialized()
    {
        base.OnInitialized();
    }

    protected override void OnGameChanged()
    {
        base.OnGameChanged();
    }

    private Dictionary<string, (string image, long total, double perSec)> GetCoins()
    {
        var game = Game.CurrentGame;

        var result = new Dictionary<string, (string, long, double)>();

        foreach(var coin in game.Coins)
        {
            long current = 0;
            double generation = 0;

            if (coin.Value.State == UnlockHelper.State.Unlocked)
            {
                var coinsGeneration = Contracts.GetTotalContractsPerSecond(game);

                if (coinsGeneration.TryGetValue(coin.Key, out var g) == true)
                    generation = g;

                if (game.ExpeditionStats?.Coins?.TryGetValue(coin.Key, out var v) == true)
                    current = v;

                result[coin.Value.Id] = (coin.Value.Image, current, generation);
            }
        }

        return result;
    }
}

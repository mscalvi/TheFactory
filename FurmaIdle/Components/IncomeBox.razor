@inherits UiHelper

@using FurmaIdle.Services
@using FurmaIdle.Helpers
@using FurmaIdle.Models

@inject ILocateService Locate
@inject IContractsService Contracts
@inject IResourcesService Resource
@inject ITooltipService Tooltips

<section class="game-area">
    <!-- TOPO: COINS -->
    @{
        var coins = GetCoinTiles();
        var coinCount = coins.Count;
        var stage = Locate.LocateStage(Game.CurrentGame, Game.CurrentGame.SelectedStageId);
    }

    <div class="coins" style="--count:@(coinCount)">
        @foreach (var it in coins)
        {
            <div class="coin-camp">
                <img class="image-resource" src="@it.Image"
                     alt="@it.Id"
                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                     @onmouseenter="() => Tooltips.Show(Tooltips.GetHover(HoverType.Coins, it.Id))"
                     @onmouseleave="Tooltips.Clear">
                <span class="income-total">
                     @NumbersHelper.Padronize(it.GameTotal)
@*                     @if (it.GamePerSec > 0)
                    {
                        <text> +@it.StagePerSec.ToString("N2")/s</text>
                    } *@
                </span>
            </div>
        }
    </div>

    <!-- BASE: RESOURCES -->
    @{
        var res = GetResourceTiles();
        var resCount = res.Count;
    }
    <div class="resources" style="--count:@(resCount)">
        @foreach (var it in res)
        {
            <div class="coin-camp">
                <img class="image-resource" src="@it.Image"
                     alt="@it.Id"
                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                     @onmouseenter="() => Tooltips.Show(Tooltips.GetHover(HoverType.Resources, it.Id))"
                     @onmouseleave="Tooltips.Clear">
                <span class="income-total">
                     @NumbersHelper.Padronize(it.GameTotal) / @NumbersHelper.Padronize(it.Cap)
@*                     @if (it.GamePerSec > 0)
                    {
                        <text> +@it.GamePerSec.ToString("N2")/s</text>
                    } *@
                </span>
            </div>
        }
    </div>
</section>


@code {
    protected override void OnInitialized()
    {
        base.OnInitialized();
    }

    protected override void OnGameChanged()
    {
        base.OnGameChanged();
    }

    private sealed record TileVM(string Id, string Image, long GameTotal, long StageTotal, long Cap, double GamePerSec, double StagePerSec);

    // COINS (topo)
    private List<TileVM> GetCoinTiles()
    {
        var game = Game.CurrentGame;
        var list = new List<TileVM>();

        if (game?.Coins is null) return list;

        var perSecStage = Contracts.GetStageContractsPerSecond(game, game.SelectedStageId);
        var perSecGame = Contracts.GetGameContractsPerSecond(game);

        foreach (var kv in game.Coins)
        {
            var coin = kv.Value;
            if (coin.State != UnlockHelper.State.Unlocked) continue;

            long gameTotal = 0;
            long stageTotal = 0;
            foreach (var stage in game.Stages)
            {
                if(game.SelectedStageId == stage.Key)
                {
                    if (stage.Value.ExpeditionStats?.Coins?.TryGetValue(coin.Id, out var st) == true)
                        stageTotal = st;
                }
                if (stage.Value.ExpeditionStats?.Coins?.TryGetValue(coin.Id, out var rt) == true)
                    gameTotal = rt;
            }

            if (game.NoExpeditionStats?.Coins?.TryGetValue(coin.Id, out var t) == true)
                gameTotal += t;

            perSecGame.TryGetValue(coin.Id, out var pSecGame);
            perSecStage.TryGetValue(coin.Id, out var pSecStage);

            list.Add(new TileVM(coin.Id, coin.Image, gameTotal, stageTotal, 0, pSecGame, pSecStage));
        }

        return list;
    }

    // RESOURCES (base)
    private List<TileVM> GetResourceTiles()
    {
        var game = Game.CurrentGame;
        var list = new List<TileVM>();

        if (game?.Resources is null) return list;

        foreach (var kv in game.Resources)
        {
            var psec = Resource.GetResourceInfo(game, kv.Value.Id);

            var res = kv.Value;
            if (res.State != UnlockHelper.State.Unlocked) continue;

            long total = 0;
            foreach (var expansion in game.Expansions)
            {
                if (expansion.Value.ExpansionStats?.Resources?.TryGetValue(res.Id, out var t) == true)
                    total = t;
            }

            list.Add(new TileVM(res.Id, res.Image, total, 0, psec.rsCap, psec.rsRegen, 0));
        }

        return list;
    }
}

@inherits UiHelper

@using FurmaIdle.Helpers
@using FurmaIdle.Models
@using FurmaIdle.Services

@inject ILocateService Locate
@inject ITooltipService Tooltips
@inject IUiLogService Log
@inject IExpeditionService Expedition

<div class="menu-root">
    @if (!Game.IsReady || _stage is null)
    {
        <div class="contracts-placeholder">Stage não Selecionado</div>
    }
    else
    {
        var item = _items[_currentItemIndex];

        <!-- Seletor -->
        <section class="@($"menu-panel nav-panel {UI.PanelClass("guildinfo-nav")}")">
            <button class="nav-selector-button"
                    disabled="@(_currentItemIndex <= 0)"
                    @onclick="PrevItem">
                ‹
            </button>

            <div class="selector-icon">
                <img class="selector-icon-img" src="@item.Icon" alt="@item.Id" />
            </div>

            <button class="nav-selector-button"
                    disabled="@(_currentItemIndex >= _items.Count - 1)"
                    @onclick="NextItem">
                ›
            </button>
        </section>

        <!-- Informações -->
        <section class="@($"menu-panel info-panel {UI.PanelClass("guildinfo-character")}")">
            <div class="guildinfo-top">
                <h3 class="guildinfo-name">@item.Name</h3>

                <div class="guildinfo-row">
                    <span class="guildinfo-label">Classe</span>
                    <span class="guildinfo-value">@item.Id</span>
                </div>

                <div class="guildinfo-row">
                    <span class="guildinfo-label">Traço</span>
                    <span class="guildinfo-value">@item.TraitId</span>
                </div>

                <div class="guildinfo-row">
                    <span class="guildinfo-label">Especialidade</span>
                    <span class="guildinfo-value">@item.SpecialtyId</span>
                </div>

                <div class="guildinfo-row guildinfo-row--multiline">
                    <span class="guildinfo-label">Descrição</span>
                    <p class="guildinfo-text">
                        @item.Description
                    </p>
                </div>

                <div class="guildinfo-row guildinfo-row--multiline">
                    <span class="guildinfo-label">Lore</span>
                    <p class="guildinfo-text guildinfo-text--lore">
                        @item.Lore
                    </p>
                </div>
            </div>

            <div class="guildinfo-botton">
                <div class="guildinfo-bigimage">
                    <img src="@item.Image"
                         alt="@item.Id"
                         class="guildinfo-bigimage-img" />
                </div>
            </div>
        </section>
    }
</div>

@code {
    private StageModel? _stage;
    private readonly List<CharacterModel> _items = new();
    private int _currentItemIndex = 0;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        RefreshStage();
    }

    protected override void OnGameChanged()
    {
        RefreshStage();
    }

    private void RefreshStage()
    {
        if (!Game.IsReady || string.IsNullOrWhiteSpace(Game?.CurrentGame.SelectedStageId))
        {
            _stage = null;
            _items.Clear();
            _currentItemIndex = 0;
            return;
        }

        var game = Game.CurrentGame;
        game.Stages.TryGetValue(Game?.CurrentGame.SelectedStageId, out var st);
        _stage = st;

        _items.Clear();

        if (game.Characters is not null)
        {
            foreach (var character in game.Characters.Values)
            {
                if (character is null) continue;
                if (character.State != UnlockHelper.State.Unlocked) continue;

                _items.Add(character);
            }

            _items.Sort((a, b) => string.Compare(a.Name, b.Name, StringComparison.Ordinal));
        }

        if (_items.Count == 0)
        {
            _currentItemIndex = 0;
        }
        else if (_currentItemIndex >= _items.Count)
        {
            _currentItemIndex = _items.Count - 1;
        }
        else if (_currentItemIndex < 0)
        {
            _currentItemIndex = 0;
        }
    }

    private void PrevItem()
    {
        if (_currentItemIndex > 0)
        {
            _currentItemIndex--;
            StateHasChanged();
        }
    }

    private void NextItem()
    {
        if (_currentItemIndex < _items.Count - 1)
        {
            _currentItemIndex++;
            StateHasChanged();
        }
    }

}

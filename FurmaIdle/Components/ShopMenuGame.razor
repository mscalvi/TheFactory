@* Components/ShopMenuExpansion.razor *@
@inherits UiHelper

@using FurmaIdle.Helpers
@using FurmaIdle.Models
@using FurmaIdle.Services
@using FurmaIdle.Data

@inject ITooltipService Tooltips
@inject IUiLogService Log
@inject ILocateService Locate
@inject IExpeditionService Expedition

<div class="menu-root">
@if (!Game.IsReady || _stage is null)
{
    <div class="contracts-placeholder">Stage não Selecionado</div>
}
else
{
    var game = Game.CurrentGame;

    var gameStats = game.GameStats;

    var expansion = Locate.LocateExpansion(game, game.CurrentExpansionId);

    TimeSpan gameDuration = DateTime.UtcNow - game.StartTime;
    
        <section class="@($"menu-panel {UI.PanelClass("game-status")}")">
        <h3 class="title">Game Stats</h3>

            <table class="info-table">
                <thead>
                    <tr><th colspan="2">@expansion.Name</th></tr>
                </thead>
                <tbody>
                    @foreach (var coin in gameStats.CoinsGain)
                    {
                        <tr class="info-row">
                            <td class="info-name">@coin.Key</td>
                            <td class="info-value">@coin.Value.ToString("N0")</td>
                        </tr>
                    }
                    @foreach (var resource in gameStats.ResourcesGain)
                    {
                        <tr class="info-row">
                            <td class="info-name">@resource.Key</td>
                            <td class="info-value">@resource.Value.ToString("N0")</td>
                        </tr>
                    }
                    @foreach (var knowledge in gameStats.KnowledgeGain)
                    {
                        <tr class="info-row">
                            <td class="info-name">@knowledge.Key</td>
                            <td class="info-value">@knowledge.Value.ToString("N0")</td>
                        </tr>
                    }
                    @foreach (var click in gameStats.ClicksMade)
                    {
                        <tr class="info-row">
                            <td class="info-name">@click.Key</td>
                            <td class="info-value">@click.Value.ToString("N0")</td>
                        </tr>
                    }
                    <tr class="info-row" colspan="2">Characters Unlocked: @game.GameStats.CharactersUnlocked</tr>
                    <tr class="info-row" colspan="2">Coins Unlocked: @game.GameStats.CoinsUnlocked</tr>
                    <tr class="info-row" colspan="2">Contracts Unlocked: @game.GameStats.ContractsUnlocked</tr>
                    <tr class="info-row" colspan="2">Expansions Unlocked: @game.GameStats.ExpansionsUnlocked</tr>
                    <tr class="info-row" colspan="2">Knowledges Unlocked: @game.GameStats.KnowledgesUnlocked</tr>
                    <tr class="info-row" colspan="2">Locals Unlocked: @game.GameStats.LocalsUnlocked</tr>
                    <tr class="info-row" colspan="2">Stages Unlocked: @game.GameStats.StagesUnlocked</tr>
                    <tr class="info-row" colspan="2">Techs Unlocked: @game.GameStats.TechUnlocked</tr>
                    <tr class="info-row" colspan="2">Resources Unlocked: @game.GameStats.ResourcesUnlocked</tr>
                    <tr class="info-row" colspan="2">Upgrades Unlocked: @game.GameStats.UpgradesUnlocked</tr>
                </tbody>
            </table>
    </section>
}

</div>

@code {
    private StageModel? _stage;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        RefreshStage();
    }

    protected override void OnGameChanged()
    {
        RefreshStage();
    }

    private void RefreshStage()
    {
        if (!Game.IsReady || string.IsNullOrWhiteSpace(Game?.CurrentGame.SelectedStageId))
        {
            _stage = null;
            return;
        }

        var g = Game.CurrentGame;
        g.Stages.TryGetValue(Game?.CurrentGame.SelectedStageId, out var st);
        _stage = st;
    }
}
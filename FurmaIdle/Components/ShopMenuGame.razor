@* Components/ShopMenuExpansion.razor *@
@inherits UiHelper

@using FurmaIdle.Helpers
@using FurmaIdle.Models
@using FurmaIdle.Services
@using FurmaIdle.Data

@inject ITooltipService Tooltips
@inject IUiLogService Log
@inject ILocateService Locate
@inject IExpeditionService Expedition

<div class="menu-root">
@if (!Game.IsReady || _stage is null)
{
    <div class="contracts-placeholder">Stage não Selecionado</div>
}
else
{
    var game = Game.CurrentGame;

    var gameStats = game.GameStats;

    var unlockedUpgrades = OrderedUpgrades(game)
        .Where(u => u?.Id != null
        && !u.Id.StartsWith("uc", StringComparison.OrdinalIgnoreCase)
        && !u.Id.StartsWith("uu", StringComparison.OrdinalIgnoreCase)
        && !u.Id.StartsWith("ub", StringComparison.OrdinalIgnoreCase)
        && !u.Id.StartsWith("um", StringComparison.OrdinalIgnoreCase)
        && u.State == UnlockHelper.State.Unlocked);

    var expansion = Locate.LocateExpansion(game, game.CurrentExpansionId);

    TimeSpan gameDuration = DateTime.UtcNow - game.StartTime;

        var totalHours = (int)gameDuration.TotalHours;
        var durationText = $"{totalHours:00}:{gameDuration.Minutes:00}:{gameDuration.Seconds:00}";

        <section class="@($"menu-panel {UI.PanelClass("game-status")}")">
        <h3 class="title">Jogo</h3>

            <table class="info-table">
                <thead>
                    <tr><th colspan="2">@expansion.Name</th></tr>
                    <tr>
                        <th colspan="2">
                            @durationText
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var coinEntry in gameStats.CoinsGain)
                    {
                        var coin = Locate.LocateCoin(game, coinEntry.Key);
                        <tr class="info-row">
                            <td class="info-name">@coin.Name</td>
                            <td class="info-value">@NumbersHelper.Padronize(coinEntry.Value)</td>
                        </tr>
                    }
                    @foreach (var resourceEntry in gameStats.ResourcesGain)
                    {
                        var resource = Locate.LocateResource(game, resourceEntry.Key);
                        <tr class="info-row">
                            <td class="info-name">@resource.Name</td>
                            <td class="info-value">@NumbersHelper.Padronize(resourceEntry.Value)</td>
                        </tr>
                    }
                    @foreach (var knowEntry in gameStats.KnowledgeGain)
                    {
                        var know = Locate.LocateKnowledge(game, knowEntry.Key);
                        <tr class="info-row">
                            <td class="info-name">@know.Name</td>
                            <td class="info-value">@NumbersHelper.Padronize(knowEntry.Value)</td>
                        </tr>
                    }
                    @foreach (var clickEntry in gameStats.ClicksMade)
                    {
                        var click = Locate.LocateClick(game, clickEntry.Key);
                        var stage = Locate.LocateStage(game, click.StageId);
                        <tr class="info-row">
                            <td class="info-name">Clicks em @stage.Name</td>
                            <td class="info-value">@NumbersHelper.Padronize(clickEntry.Value)</td>
                        </tr>
                    }
                    <tr class="info-row" colspan="2">Personagens Contratados: @game.GameStats.CharactersUnlocked / @game.Characters.Count.ToString()</tr>
                    <tr class="info-row" colspan="2">Contratos Desbloqueados: @game.GameStats.ContractsUnlocked / @game.Contracts.Count.ToString()</tr>
                    <tr class="info-row" colspan="2">Moedas Conhecidas: @game.GameStats.CoinsUnlocked / @game.Coins.Count.ToString()</tr>
                    <tr class="info-row" colspan="2">Recursos Conhecidos: @game.GameStats.ResourcesUnlocked / @game.Resources.Count.ToString()</tr>
                    <tr class="info-row" colspan="2">Conhecimentos Estudados: @game.GameStats.KnowledgesUnlocked / @game.Knowledges.Count.ToString()</tr>
                    <tr class="info-row" colspan="2">Pesquisas Realizadas: @game.GameStats.TechUnlocked / @game.Techs.Count.ToString()</tr>
                    <tr class="info-row" colspan="2">Melhorias Completas: @game.GameStats.UpgradesUnlocked / @game.Upgrades.Count.ToString()</tr>
                    <tr class="info-row" colspan="2">Locais Explorados: @game.GameStats.LocalsUnlocked / @game.Locals.Count.ToString()</tr>
                    <tr class="info-row" colspan="2">Regiões Exploradas: @game.GameStats.StagesUnlocked / @game.Stages.Count.ToString()</tr>
                    <tr class="info-row" colspan="2">Expansões Feitas: @game.GameStats.ExpansionsUnlocked / @game.Expansions.Count.ToString()</tr>
                </tbody>
            </table>
    </section>

        <section class="@($"menu-panel menu-section {UI.PanelClass("game-upgrades")}")">
            <h3 class="title">Upgrades de Desbloqueio</h3>
            @if (!unlockedUpgrades.Any())
            {
                <div>Nenhum upgrade concluído.</div>
            }
            else
            {
                <div class="icon-grid">
                    @foreach (var u in unlockedUpgrades)
                    {
                        var id = u.Id;
                        <button type="button"
                                class="icon-button"
                                disabled
                                @onmouseenter="() => Tooltips.Show(Tooltips.GetHover(HoverType.Upgrade, id, _stage.Id))"
                                @onmouseleave="Tooltips.Clear"
                                @onfocus="() => Tooltips.Show(Tooltips.GetHover(HoverType.Upgrade, id, _stage.Id))"
                                @onblur="Tooltips.Clear">
                            @if (!string.IsNullOrWhiteSpace(u.Icon))
                            {
                                <img src="@u.Icon"
                                     alt="@u.Id"
                                     class="icon-img" />
                            }
                            else
                            {
                                @u.Id
                            }
                        </button>
                    }
                </div>
            }
        </section>
}

</div>

@code {
    private StageModel? _stage;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        RefreshStage();
    }

    protected override void OnGameChanged()
    {
        RefreshStage();
    }

    private void RefreshStage()
    {
        if (!Game.IsReady || string.IsNullOrWhiteSpace(Game?.CurrentGame.SelectedStageId))
        {
            _stage = null;
            return;
        }

        var g = Game.CurrentGame;
        g.Stages.TryGetValue(Game?.CurrentGame.SelectedStageId, out var st);
        _stage = st;
    }

    private static IEnumerable<UpgradeModel> OrderedUpgrades(GameModel g)
        => g.Upgrades.Values
            .OrderBy(u => u.Id);
}
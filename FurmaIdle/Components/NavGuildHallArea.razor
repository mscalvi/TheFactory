@inherits UiHelper

@using System.Linq
@using FurmaIdle.Models
@using FurmaIdle.Data
@using FurmaIdle.Helpers
@using FurmaIdle.Services

@inject IPurchaseService Purchase
@inject ICostService Cost
@inject IContractsService Contracts
@inject ILocateService Locate
@inject ITooltipService Tooltips
@inject IUiLogService Log
@inject INotificationService Notifications

<div class="menu-root">
@if (!Game.IsReady || _stage is null)
{
        <div class="contracts-placeholder">Stage não Selecionado</div>
    }
    else
    {
        var game = Game.CurrentGame;

        <section class="@($"menu-panel menu-section {UI.PanelClass("hall-permanents")}")">
            <h3 class="title">Desenvolvimento Permanente</h3>
            <div class="icon-grid">
                @foreach (var u in _hallPermanents)
                {
                    var can = Cost.CanAfford(ItemHelper.ItemType.Upgrade, u.Id, _stage.Id);
                    <button class="icon-button" disabled="@(!can)"
                            @onclick="() => OnClickBuy(u.Id)"
                            @onmouseenter="() => Tooltips.Show(Tooltips.GetHover(HoverType.Upgrade, u.Id, _stage.Id))"
                            @onmouseleave="Tooltips.Clear">
                        @if (!string.IsNullOrWhiteSpace(u.Icon))
                        {
                            <img src="@u.Icon"
                                 alt="@u.Id"
                                 class="icon-img" />
                        }
                        else
                        {
                            @u.Id
                        }
                    </button>
                }
            </div>
        </section>

        <section class="@($"menu-panel menu-section {UI.PanelClass("hall-expansion")}")">
                <h3 class="title">Impulsos Temporários</h3>
            <div class="icon-grid">
                @foreach (var u in _hallExpansion)
                {
                    var can = Cost.CanAfford(ItemHelper.ItemType.Upgrade, u.Id, _stage.Id);
                    <button class="icon-button" disabled="@(!can)"
                            @onclick="() => OnClickBuy(u.Id)"
                            @onmouseenter="() => Tooltips.Show(Tooltips.GetHover(HoverType.Upgrade, u.Id, _stage.Id))"
                            @onmouseleave="Tooltips.Clear">
                        @if (!string.IsNullOrWhiteSpace(u.Icon))
                        {
                            <img src="@u.Icon"
                                 alt="@u.Id"
                                 class="icon-img" />
                        }
                        else
                        {
                            @u.Id
                        }
                    </button>
                }
            </div>
        </section>
}
</div>

@code {
    private StageModel? _stage;

    private List<UpgradeModel> _hallPermanents = new();
    private List<UpgradeModel> _hallExpansion = new();

    private bool freeProcess = true;
    private bool firstLists = true;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        RefreshStage();
        RebuildLists();
    }

    protected override void OnGameChanged()
    {
        RefreshStage();

        if (Purchase.PurchaseChangeHall)
        {
            RebuildLists();
            Purchase.PurchaseChangeHall = false;
        }
    }

    private void RefreshStage()
    {
        if (!Game.IsReady || string.IsNullOrWhiteSpace(Game?.CurrentGame.SelectedStageId))
        {
            _stage = null;
            return;
        }

        var g = Game.CurrentGame;
        g.Stages.TryGetValue(Game?.CurrentGame.SelectedStageId, out var st);
        _stage = st;
    }

    private void RebuildLists()
    {
        if (!Game.IsReady || _stage is null)
            return;

        Notifications.UpdateVisibleUpgrades("guild-hall");

        Notifications.TabsUpgrades.TryGetValue("hallPermanents", out _hallPermanents);
        Notifications.TabsUpgrades.TryGetValue("hallExpansion", out _hallExpansion);
    }

    // ===== Ações =====
    private async Task OnClickBuy(string upgradeId)
    {
        var game = Game.CurrentGame;
        var upgrade = Locate.LocateUpgrade(game, upgradeId);

        if (!Cost.CanAfford(ItemHelper.ItemType.Upgrade, upgrade.Id, _stage.Id))
        {
            Log.Error($"Sem recursos para comprar upgrade {upgradeId}.");
            return;
        }

        if (freeProcess)
        {
            freeProcess = false;

            try
            {
                await Purchase.Purchase(ItemHelper.ItemType.Upgrade, upgradeId, _stage.Id);

                if (_stage is not null)
                {
                    var hover = Tooltips.GetHover(HoverType.Upgrade, upgradeId, _stage.Id);
                    Tooltips.Show(hover);
                }

            }
            finally
            {
                freeProcess = true;
            }
        }
        else
        {
            return;
        }
    }
}

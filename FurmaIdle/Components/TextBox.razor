@inherits UiHelper

@using FurmaIdle.Services

@inject IJSRuntime JS
@inject IUiLogService UiLog

<div class="game-area">
    <section class="text-box panel" role="status" aria-live="polite">
        <!-- Barra de filtros -->
        <header class="msg-filters">
            <span class="msg-filters-label">Mostrar:</span>

            <label class="msg-filter">
                <input type="checkbox" @bind="_showLore" />
                <span>História</span>
            </label>

            <label class="msg-filter">
                <input type="checkbox" @bind="_showInfo" />
                <span>Sistema</span>
            </label>
        </header>

        <!-- Lista de mensagens -->
        <div class="msg-body" @ref="_msgBodyRef">
            <div class="msg-list">
                @if (!_msgs.Any(m => PassesFilter(m)))
                {
                    <em>Sem mensagens visíveis.</em>
                }
                else
                {
                    @foreach (var m in _msgs.Where(PassesFilter))
                    {
                        <div class="msg-row @Css(m.Kind)">
                            <span class="msg-time">@m.Time.ToString("HH:mm:ss: ")</span>
                            <span class="msg-text">@DisplayText(m)</span>
                        </div>
                    }
                }
            </div>
        </div>
    </section>
</div>

@code {
    ElementReference _msgBodyRef;
    bool _scrollPending;

    // filtros (ligados por padrão)
    bool _showLore = true; // Lore + personagens
    bool _showInfo = true; // Info + Erros

    enum MsgKind { Error, Info, Lore, Ferri, Maik, Claimi, Alan, Jaime, Yg}

    sealed class UiMessage
    {
        public DateTime Time { get; init; } = DateTime.Now;
        public string Text { get; init; } = "";
        public MsgKind Kind { get; init; } = MsgKind.Info;
    }

    readonly List<UiMessage> _msgs = new();

    protected override void OnInitialized()
    {
        base.OnInitialized();

        var buf = Game.CurrentGame?.Ui?.LogBuffer;
        if (buf is not null && buf.Count > 0)
        {
            foreach (var m in buf)
            {
                _msgs.Add(new UiMessage
                {
                    Text = m.Text,
                    Time = m.Time,
                    Kind = m.Kind switch
                    {
                        UiLogKind.Lore => MsgKind.Lore,
                        UiLogKind.Error => MsgKind.Error,
                        UiLogKind.Ferri => MsgKind.Ferri,
                        UiLogKind.Maik => MsgKind.Maik,
                        UiLogKind.Claimi => MsgKind.Claimi,
                        UiLogKind.Alan => MsgKind.Alan,
                        UiLogKind.Jaime => MsgKind.Jaime,
                        UiLogKind.Yg => MsgKind.Yg,
                        _ => MsgKind.Info
                    }
                });
            }

            _scrollPending = true;
        }

        UiLog.OnMessage += HandleUiLogMessage;
    }

    public void Dispose()
    {
        UiLog.OnMessage -= HandleUiLogMessage;
        base.Dispose();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_scrollPending)
        {
            _scrollPending = false;
            await JS.InvokeVoidAsync("ui.scrollToBottom", _msgBodyRef);
        }
    }

    void HandleUiLogMessage(UiLogMessage msg)
    {
        _msgs.Add(new UiMessage
        {
            Text = msg.Text,
            Time = msg.Time,
            Kind = msg.Kind switch
            {
                UiLogKind.Lore => MsgKind.Lore,
                UiLogKind.Error => MsgKind.Error,
                UiLogKind.Ferri => MsgKind.Ferri,
                UiLogKind.Maik => MsgKind.Maik,
                UiLogKind.Claimi => MsgKind.Claimi,
                UiLogKind.Alan => MsgKind.Alan,
                UiLogKind.Jaime => MsgKind.Jaime,
                UiLogKind.Yg => MsgKind.Yg,
                _ => MsgKind.Info
            }
        });

        _scrollPending = true;
        InvokeAsync(StateHasChanged);
    }

    // História = Lore + Ferri (e outros personagens no futuro)
    // Sistema  = Info + Error
    bool PassesFilter(UiMessage m) => m.Kind switch
    {
        MsgKind.Lore => _showLore,
        MsgKind.Ferri => _showLore,
        MsgKind.Maik => _showLore,
        MsgKind.Claimi => _showLore,
        MsgKind.Alan => _showLore,
        MsgKind.Jaime => _showLore,
        MsgKind.Yg => _showLore,
        MsgKind.Info => _showInfo,
        MsgKind.Error => _showInfo,
        _ => true
    };

    string DisplayText(UiMessage m) => m.Kind switch
    {
        MsgKind.Ferri => $"Ferri: {m.Text}",
        MsgKind.Maik => $"Maik: {m.Text}",
        MsgKind.Claimi => $"Claimi: {m.Text}",
        MsgKind.Alan => $"Alan: {m.Text}",
        MsgKind.Jaime => $"Jaime: {m.Text}",
        MsgKind.Yg => $"Yg: {m.Text}",
        _ => m.Text
    };

    string Css(MsgKind k) => k switch
    {
        MsgKind.Lore => "is-lore",
        MsgKind.Error => "is-error",
        MsgKind.Ferri => "is-ferri",
        MsgKind.Maik => "is-maik",
        MsgKind.Claimi => "is-claimi",
        MsgKind.Alan => "is-alan",
        MsgKind.Jaime => "is-jaime",
        MsgKind.Yg => "is-yg",
        _ => "is-info"
    };
}

@inherits UiHelper

@using FurmaIdle.Services

@inject IJSRuntime JS
@inject ITooltipService Tooltips
@inject IUiLogService UiLog

<section class="text-box panel" role="status" aria-live="polite">
    <div class="msg-body" @ref="_msgBodyRef">
        <div class="msg-list">
            @if (Tooltips.Current is null)
            {
                if (_msgs.Count == 0)
                {
                    <em>Sem mensagens.</em>
                }
                else
                {
                    @foreach (var m in _msgs)
                    {
                        <div class="msg-row @Css(m.Kind)">
                            <span class="msg-time">@m.Time.ToString("HH:mm:ss: ")</span>
                            <span class="msg-text">@m.Text</span>
                        </div>
                    }
                }
            }
            else
            {
                <div class="tip-title">@Tooltips.Current.Title</div>
                <pre class="tip-body">@Tooltips.Current.Body</pre>
            }
        </div>
    </div>
</section>

@code {
    ElementReference _msgBodyRef;
    bool _scrollPending;

    enum MsgKind { Info, Warn, Error, Success }
    sealed class UiMessage
    {
        public DateTime Time { get; init; } = DateTime.Now;
        public string Text { get; init; } = "";
        public MsgKind Kind { get; init; } = MsgKind.Info;
    }
    readonly List<UiMessage> _msgs = new();

    protected override void OnInitialized()
    {
        base.OnInitialized();
        UiLog.OnMessage += HandleUiLogMessage;
        Tooltips.Changed += OnTooltipChanged;
    }

    public void Dispose()
    {
        Tooltips.Changed -= OnTooltipChanged;
        UiLog.OnMessage -= HandleUiLogMessage;
        base.Dispose();
    }

    void OnTooltipChanged()
    {
        // Se a tooltip sumiu, queremos ir para baixo
        if (Tooltips.Current is null)
        {
            _scrollPending = true;
            InvokeAsync(StateHasChanged);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_scrollPending)
        {
            _scrollPending = false;
            await JS.InvokeVoidAsync("ui.scrollToBottom", _msgBodyRef);
        }
    }

    void HandleUiLogMessage(UiLogMessage msg)
    {
        _msgs.Add(new UiMessage
        {
            Text = msg.Text,
            Time = msg.Time,
            Kind = msg.Kind switch
            {
                UiLogKind.Warn => MsgKind.Warn,
                UiLogKind.Error => MsgKind.Error,
                UiLogKind.Success => MsgKind.Success,
                _ => MsgKind.Info
            }
        });
        InvokeAsync(StateHasChanged);
    }

    string Css(MsgKind k) => k switch
    {
        MsgKind.Warn => "is-warn",
        MsgKind.Error => "is-error",
        MsgKind.Success => "is-success",
        _ => "is-info"
    };
}

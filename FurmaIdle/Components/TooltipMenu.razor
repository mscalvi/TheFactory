@inherits UiHelper

@using FurmaIdle.Models
@using FurmaIdle.Services

@inject ITooltipService Tooltips

<div class="game-area">
    @if (Tooltips.Current is not null)
    {
        <TooltipBox />
    }
    else
    {
        <p>Placeholder </p>
        // <LogoBox />
    }
</div>

@code {
    protected override void OnInitialized()
    {
        Tooltips.Changed += OnChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Tooltips.Changed -= OnChanged;
}

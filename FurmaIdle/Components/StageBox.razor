@inherits UiHelper

@using FurmaIdle.Data
@using FurmaIdle.Models
@using FurmaIdle.Services
@using FurmaIdle.Helpers;

@inject IUnlockService Unlock
@inject ILocateService Locate

<div class="stage-box">
    @{
        var stageId = Game.CurrentGame.SelectedStageId;
        var stage = Locate.LocateStage(Game.CurrentGame, stageId);
    }
    <div class="stage-name">
        @if (stage is null)
        {
            <h3>(carregando…)</h3>
        }
        else
        {
            <h3>@stage.Name</h3>
        }
    </div>
    <div class="stage-locals">
        @{
            var unlocked = new List<string>();
            foreach (var lid in Game.CurrentGame.Locals)
            {
                var local = Locate.LocateLocal(Game.CurrentGame, lid.Key);
                if (local.StageId == stage.Id)
                {
                    if (local.State == UnlockHelper.State.Unlocked)
                    {
                        unlocked.Add(local.Name);
                    }
                }
            }
            <p>@(unlocked.Count > 0 ? string.Join(", ", unlocked) : "Nenhum local desbloqueado")</p>
        }
    </div>
</div>


@code {
    protected override void OnInitialized()
    {
        base.OnInitialized();
        // se quiser carregar algo só uma vez, faça aqui
    }

    protected override void OnGameChanged()
    {
        // se precisar recalcular alguma cache local, faça aqui
        // o base já chama StateHasChanged()
    }
}

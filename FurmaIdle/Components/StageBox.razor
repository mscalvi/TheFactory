@* Components/StageBox.razor *@
@inherits UiHelper

@using System.Linq
@using FurmaIdle.Helpers
@using FurmaIdle.Models
@using FurmaIdle.Data
@using FurmaIdle.Services

@inject ITooltipService Tooltips
@inject IUiLogService Log
@inject IExpeditionService Expedition
@inject ICostService Cost
@inject ISpecialtiesService Specialty
@inject IPurchaseService Purchase
@inject ILocateService Locate
@inject IResourcesService Resource
@inject IContractsService Contracts

<div class="game-area">
@if (!Game.IsReady || _stage is null)
{
    <div class="contracts-placeholder">Stage não Selecionado</div>
}
else
{
    var game = Game.CurrentGame;

    var activeCharsForCap = game.Characters.Values
        .Where(c => c.State == UnlockHelper.State.Unlocked
                && c.CharState == UnlockHelper.CharState.InStage
                && c.InStageId == game.SelectedStageId)
        .ToList();
    var members = activeCharsForCap.Count;

    var unlockedResources = game.Resources.Values
        .Where(r => r.State == UnlockHelper.State.Unlocked)
        .OrderBy(r => r.Id)
        .ToList();

    var activeChars = game.Characters.Values
        .Where(c => c.State == UnlockHelper.State.Unlocked
                 && c.CharState == UnlockHelper.CharState.InStage
                 && c.InStageId == game.SelectedStageId)
        .OrderBy(c => c.Id)
        .ToList();

    <!-- ========= Party grid (PartySizeMax slots) ========= -->
    <section class="party-grid panel"
             style="--slots:@Expedition.GetPartyCap(_stage)"
             tabindex="0"
             @ref="_host"
             @onkeydown="HandleKey">
        @for (var i = 0; i < Expedition.GetPartyCap(_stage); i++)
        {
            if (i < activeChars.Count)
            {
                var c = activeChars[i];
                var id = c.Id;

                var spec = Locate.LocateSpecialty(Game.CurrentGame, c.SpecialtyId);

                var canUse = CanUseSpec(spec);
                var isActive = IsSpecActive(spec);

                var timer = Specialty.GetSpecialtyTimer(spec);

                double ratio = isActive && timer.Total > 0 ? (1.0 - ((timer.Total - timer.Actual) / timer.Total)) : 0.0;
                int stepsOn = Math.Clamp((int)Math.Floor(ratio * 10.0), 0, 10);

                <div class="party-slot">
                    <div class="party-card">
                        <div class="pc-action">
                            <button class="spec-button"
                                    disabled="@(!canUse)"
                                    @onclick="() => UseSpec(spec)"
                                    @onmouseover="() => Tooltips.Show(Tooltips.GetHover(HoverType.Specialty, spec.Id, _stage!.Id))"
                                        @onmouseout="Tooltips.Clear">
                                    @if (!string.IsNullOrWhiteSpace(spec.Image))
                                    {
                                        <img src="@spec.Image"
                                             alt="@spec.Name"
                                             class="spec-img" />
                                    }
                                    else
                                    {
                                        @spec.Name
                                    }
                            </button>
                        </div>

                        <div class="pc-progress">
                            @if (isActive)
                            {
                                var prog = (timer.Total > 0) ? (1.0 - (timer.Actual / timer.Total)) : 0.0;
                                prog = Math.Clamp(prog, 0.0, 1.0);
                                const int steps = 10;                 

                                var pct = $"{prog * 100:0.#}%";
                                var secs = $"{timer.Actual:0.##}s";

                                int filled = Math.Clamp((int)Math.Ceiling(prog * steps), 0, steps);

                                    <div class="specialty-steps">
                                        @for (int j = 0; j < steps; j++)
                                        {
                                            <span class="step @(j < filled ? "is-on" : null)"></span>
                                        }
                                    </div>
                            }
                        </div>
                    </div>
                </div>


            }
            else
            {
                <div class="party-slot">
                    <div class="party-card is-empty">
                        <div class="party-slot-empty">—</div>
                    </div>
                </div>
            }
        }
    </section>
}
</div>

@code {
    private StageModel? _stage;
    private ElementReference _host;
    private bool _focusedOnce;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender && !_focusedOnce)
        {
            _focusedOnce = true;
            try { await _host.FocusAsync(); } catch { /* ignore */ }
        }
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        RefreshStage();
    }

    protected override void OnGameChanged()
    {
        RefreshStage();
    }

    private void RefreshStage()
    {
        if (!Game.IsReady || string.IsNullOrWhiteSpace(Game?.CurrentGame.SelectedStageId))
        {
            _stage = null;
            return;
        }

        var g = Game.CurrentGame;
        g.Stages.TryGetValue(Game?.CurrentGame.SelectedStageId, out var st);
        _stage = st;
    }

    private List<SpecialtyModel> GetOrderedSpecs()
    {
        var g = Game.CurrentGame;
        var activeChars = g.Characters.Values
            .Where(c => c.State == UnlockHelper.State.Unlocked
                     && c.CharState == UnlockHelper.CharState.InStage
                     && c.InStageId == g.SelectedStageId)
            .OrderBy(c => c.Id)
            .ToList();

        return activeChars
            .Select(c => Locate.LocateSpecialty(g, c.SpecialtyId))
            .ToList();
    }

    private async Task HandleKey(KeyboardEventArgs e)
    {
        var key = e.Key;             
        int slot = ParseDigitKey(key);
        if (slot < 1) return;        

        var specs = GetOrderedSpecs();
        if (slot > specs.Count) return;

        var spec = specs[slot - 1];
        if (CanUseSpec(spec))
            await UseSpec(spec);
    }

    private static int ParseDigitKey(string key)
    {
        if (string.IsNullOrEmpty(key)) return 0;

        if (key.StartsWith("Numpad", StringComparison.OrdinalIgnoreCase))
            key = key.Substring("Numpad".Length);

        if (key.Length == 1 && char.IsDigit(key[0]))
        {
            if (key == "0") return 10;           
            return (key[0] - '0');               
        }

        return 0;
    }

    bool IsSpecActive(SpecialtyModel spec)
    {
        var timer = Specialty.GetSpecialtyTimer(spec);
        return timer.Actual > 0;
    }

    bool CanUseSpec(SpecialtyModel spec)
    {
        if (IsSpecActive(spec)) return false;

        var stageId = _stage.Id;
        if (string.IsNullOrWhiteSpace(stageId)) return false;

        return Cost.CanAfford(ItemHelper.ItemType.Specialty, spec.Id, stageId);
    }

    public async Task UseSpec(SpecialtyModel spec)
    {
        await Purchase.Purchase(ItemHelper.ItemType.Specialty, spec.Id, _stage.Id);

        if (spec.Id == "e01")
        {
            await Contracts.BurstProduction(spec.EffectValue, _stage.Id, spec.Id);
        }
    }

    long getResTotal(string resId)
    {
        long resTotal = 0;
        foreach(var stage in Game.CurrentGame.Stages)
        {
            resTotal += stage.Value.ExpeditionStats.Resources.TryGetValue(resId, out var v) == true ? v : 0L;
            
        }
        return resTotal;
    }

    private static string CharImg(string id) => $"images/characters/{id}.png";

}

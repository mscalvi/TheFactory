@inherits UiHelper

@using FurmaIdle.Data
@using FurmaIdle.Models
@using FurmaIdle.Services
@using FurmaIdle.Helpers;

@inject IUnlockService Unlock
@inject ILocateService Locate

@if (!Game.IsReady || string.IsNullOrWhiteSpace(_stage.Id) || _stage is null)
{
    <div class="contracts-placeholder">Stage não Selecionado</div>
}
else
{
    var game = Game.CurrentGame;
    <div class="stage-box title">
        <div class="stage-name">
            <h3>@_stage.Name</h3>
        </div>
        <div class="stage-locals text">
            @{
                var unlocked = new List<string>();
                foreach (var lid in game.Locals)
                {
                    var local = Locate.LocateLocal(game, lid.Key);
                    if (local.StageId == _stage.Id)
                    {
                        if (local.State == UnlockHelper.State.Unlocked)
                        {
                            unlocked.Add(local.Name);
                        }
                    }
                }
                <p>@(unlocked.Count > 0 ? string.Join("- ", unlocked) : "Nenhum local desbloqueado")</p>
            }
        </div>
    </div>
}



@code {
    private StageModel? _stage;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        RefreshStage();
    }

    protected override void OnGameChanged()
    {
        RefreshStage();
    }

    private void RefreshStage()
    {
        if (!Game.IsReady || string.IsNullOrWhiteSpace(Game?.CurrentGame.SelectedStageId))
        {
            _stage = null;
            return;
        }

        var g = Game.CurrentGame;
        g.Stages.TryGetValue(Game?.CurrentGame.SelectedStageId, out var st);
        _stage = st;
    }
}

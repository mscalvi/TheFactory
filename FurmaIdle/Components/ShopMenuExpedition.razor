@* Components/ShopMenuExpedition.razor *@
@inherits UiHelper

@using FurmaIdle.Helpers
@using FurmaIdle.Models
@using FurmaIdle.Services

@inject IExpeditionService Expedition
@inject ILocateService Locate
@inject ITooltipService Tooltips
@inject IUiLogService Log
@inject IKnowledgeService Knowledge

<div class="menu-root">
    @if (!Game.IsReady || _stage is null)
    {
        <div class="contracts-placeholder">Stage não Selecionado</div>
    }
    else
    {
        var game = Game.CurrentGame;
        var expedition = _stage.Expedition;
        var expeditionStats = _stage.ExpeditionStats;

        var started = expedition.StartedAt;

        string durationText;

        if (started.HasValue)
        {
            var expDuration = DateTimeOffset.UtcNow - started.Value;

            var totalHours = (int)expDuration.TotalHours;
            durationText = $"{totalHours:00}:{expDuration.Minutes:00}:{expDuration.Seconds:00}";
        }
        else
        {
            durationText = "--:--:--";
        }

        var isActive = isExpActive(_stage);
        var partySize = Expedition.GetPartyCap(_stage);
        var partyIds = expedition.PartyIds;

        var selectedCount = CountLine();

        var canLaunch = !isActive && _stage is not null && selectedCount <= partySize && selectedCount >= 1;

        var chars = game.Characters?.Values ?? Enumerable.Empty<CharacterModel>();

        var avaliableChars = chars.Where(c => c.State == UnlockHelper.State.Unlocked
        && c.CharState == UnlockHelper.CharState.InBase || c.CharState == UnlockHelper.CharState.InLine)
        .OrderBy(c => c.Id)
        .ToList();

        var inStageChars = chars.Where(c => c.State == UnlockHelper.State.Unlocked
        && c.CharState == UnlockHelper.CharState.InStage && c.InStageId == _stage.Id)
        .OrderBy(c => c.Id)
        .ToList();

        <section class="@($"menu-panel {UI.PanelClass("expedition-toggle")}")">
            <button class="objetive-button"
                    disabled="@( !isActive && !canLaunch )"
                    @onclick="OnClickToggleExpedition"
                    @onmouseenter="() => Tooltips.Show(Tooltips.GetHover(HoverType.Expedition, _stage.Id))"
                    @onmouseleave="Tooltips.Clear">
                @(isActive ? "Encerrar Expedição" : "Iniciar Expedição")
            </button>
        </section>

        <section class="@($"menu-panel menu-section {UI.PanelClass("expedition-party")}")">
            @if (_stage.Expedition.ExpeditionState == UnlockHelper.ExpeditionState.Active)
            {
                <h3 class="title">Personagens na Expedição</h3>
                <div class="image-grid">
                    @foreach (var ch in inStageChars)
                    {
                        <button class="character-button"
                                disabled
                                @onmouseenter="() => Tooltips.Show(Tooltips.GetHover(HoverType.Character, ch.Id, _stage.Id))"
                                @onmouseleave="Tooltips.Clear"
                                @onfocus="() => Tooltips.Show(Tooltips.GetHover(HoverType.Character, ch.Id, _stage.Id))"
                                @onblur="Tooltips.Clear">
                            @if (!string.IsNullOrWhiteSpace(ch.Image))
                            {
                                <img src="@ch.Image"
                                     alt="@ch.Id"
                                     class="icon-img" />
                            }
                            else
                            {
                                @ch.Id
                            }
                        </button>
                    }
                </div>
            }
            else
            {
                <h3 class="title">Personagens na Base</h3>
                <div class="image-grid">
                    @foreach (var ch in avaliableChars)
                    {
                        var selected = ch.CharState == UnlockHelper.CharState.InLine;
                        var canToggle = Expedition.CanToggleChar(_stage, ch.Id);

                        <button type="button"
                                class="character-button @(selected ? "selected" : null)"
                                disabled="@( !canToggle )"
                                @onclick="() => OnToggleChar(ch.Id)"
                                @onmouseenter="() => Tooltips.Show(Tooltips.GetHover(HoverType.Character, ch.Id, _stage.Id))"
                                @onmouseleave="Tooltips.Clear"
                                @onfocus="() => Tooltips.Show(Tooltips.GetHover(HoverType.Character, ch.Id, _stage.Id))"
                                @onblur="Tooltips.Clear">
                            @if (!string.IsNullOrWhiteSpace(ch.Image))
                            {
                                <img src="@ch.Image"
                                     alt="@ch.Id"
                                     class="icon-img" />
                            }
                            else
                            {
                                @ch.Id
                            }
                        </button>
                    }
                </div>
            }
        </section>

        <section class="@($"menu-panel {UI.PanelClass("expedition-status")}")">
            @if (expedition.ExpeditionState != UnlockHelper.ExpeditionState.Active)
            {
                <h3 class="title">Expedição Inativa</h3>
            }
            else
            {
                var knowFactor = Knowledge.GetKnowFactor(_stage);
                <h3 class="title">Expedição Atual</h3>
                <table class="info-table">
                    <thead>
                        <tr>
                            <th colspan="2">
                                @durationText
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var factor in knowFactor)
                        {
                            var knowledge = Locate.LocateKnowledge(game, factor.Key);
                            <tr class="info-row">
                                <td class="info-name">Fator de @knowledge.Name</td>
                                <td class="info-value">@NumbersHelper.Padronize(factor.Value)</td>
                            </tr>
                        }
                        @foreach (var coinEntry in expeditionStats.CoinsGain)
                        {
                            var coin = Locate.LocateCoin(game, coinEntry.Key);
                            <tr class="info-row">
                                <td class="info-name">@coin.Name</td>
                                <td class="info-value">@NumbersHelper.Padronize(coinEntry.Value)</td>
                            </tr>
                        }
                        @foreach (var resourceEntry in expeditionStats.ResourcesGain)
                        {
                            var resource = Locate.LocateResource(game, resourceEntry.Key);
                            <tr class="info-row">
                                <td class="info-name">@resource.Name</td>
                                <td class="info-value">@NumbersHelper.Padronize(resourceEntry.Value)</td>
                            </tr>
                        }
                        @foreach (var clickEntry in expeditionStats.ClicksMade)
                        {
                            var click = Locate.LocateClick(game, clickEntry.Key);
                            var stage = Locate.LocateStage(game, click.StageId);
                            <tr class="info-row">
                                <td class="info-name">Clicks em @stage.Name</td>
                                <td class="info-value">@NumbersHelper.Padronize(clickEntry.Value)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }       
        </section>

        <section class="@($"menu-panel {UI.PanelClass("expedition-gain")}")">
            <h3 class="title">Conhecimentos ao Encerrar</h3>
            @{
                long cTotal = 0L;
                if (_stage?.ExpeditionStats?.CoinsGain?.TryGetValue(_stage.CoinId, out var v) == true)
                    cTotal = v;
                var kPreview = Knowledge.KnowledgeGain(_stage, cTotal);
                if (kPreview.Count > 0)
                {
                    <table class="info-table">
                        <tbody>
                            @foreach (var knowEntry in kPreview.OrderByDescending(x => x.Value))
                            {
                                var know = Locate.LocateKnowledge(game, knowEntry.Key);
                                var knowGain = Math.Floor(knowEntry.Value);

                                <tr class="info-row">
                                    <td class="info-name">@know.Name</td>
                                    <td class="info-value">@NumbersHelper.Padronize(knowGain)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="info-entry">
                        <div class="info-line">-</div>
                    </div>
                }
        
            }
        </section>
    }
</div>

@code {
    private StageModel? _stage;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        RefreshStage();
    }

    protected override void OnGameChanged()
    {
        RefreshStage();
    }

    private void RefreshStage()
    {
        if (!Game.IsReady || string.IsNullOrWhiteSpace(Game?.CurrentGame.SelectedStageId))
        {
            _stage = null;
            return;
        }

        var g = Game.CurrentGame;
        g.Stages.TryGetValue(Game?.CurrentGame.SelectedStageId, out var st);
        _stage = st;
    }

    private bool isExpActive(StageModel stage)
    {
        var expedition = stage.Expedition;

        if(expedition.ExpeditionState == UnlockHelper.ExpeditionState.Active)
        {
            return true;
        } else
        {
            return false;
        }
    }

    private async Task OnClickToggleExpedition()
    {
        var game = Game.CurrentGame;
        if (game is null) return;

        var isActive = isExpActive(_stage);

        if (!isActive)
        {
            await Expedition.LaunchExpedition(_stage);

            return;
        }
        else
        {
            await Expedition.EndExpedition(_stage);
        }
    }

    private void OnToggleChar(string id)
    {
        Expedition.ToggleChar(_stage, id);

        StateHasChanged();
    }

    private int CountLine()
    {
        int line = 0;

        foreach (var character in Game.CurrentGame.Characters)
        {
            if (character.Value.CharState == UnlockHelper.CharState.InLine) line++;
        }

        return line;
    }
}

@* Components/ShopMenuExpedition.razor *@
@inherits UiHelper

@using FurmaIdle.Helpers
@using FurmaIdle.Models
@using FurmaIdle.Services

@inject IExpeditionService Expedition
@inject ILocateService Locate
@inject ITooltipService Tooltips
@inject IUiLogService Log
@inject IKnowledgeService Knowledge

@if (!Game.IsReady || _stage is null)
{
    <div class="contracts-placeholder">Stage não Selecionado</div>
}
else
{
    var game = Game.CurrentGame;
    var expedition = _stage.Expedition;
    var expeditionStats = _stage.ExpeditionStats;

    var isActive = isExpActive(_stage);
    var partySize = Expedition.GetPartyCap(_stage);
    var partyIds = expedition.PartyIds;

    var selectedCount = CountLine();

    var canLaunch = !isActive && _stage is not null && selectedCount <= partySize && selectedCount >= 1;

    <div class="expedition-actions">
        <button type="button"
                class="expedition-button"
                disabled="@( !isActive && !canLaunch )"
                @onclick="OnClickToggleExpedition">
            @(isActive ? "Encerrar Expedição" : "Iniciar Expedição")
        </button>
    </div>

    @if (isActive)
    {
        <!-- Status da expedição -->
        var started = expedition.StartedAt;
        var duration = started.HasValue ? (DateTimeOffset.UtcNow - started.Value) : (TimeSpan?)null;

        <div class="status-card">

            <h3>Status</h3>
            <div class="kv-list">
                <div class="kv">
                    <div class="key">Duração:</div><div class="val">
                        @(duration?.ToString("hh\\:mm\\:ss") ?? "--:--:--")
                    </div>
                </div>
            </div>

            <h4>Ganhos</h4>
            <div class="kv-list">
                @foreach (var coin in expeditionStats.CoinsGain)
                {
                    <div class="kv"><div class="key">@coin.Key</div><div class="val">@coin.Value</div></div>
                }
                @foreach (var resource in expeditionStats.ResourcesGain)
                {
                    <div class="kv"><div class="key">@resource.Key</div><div class="val">@resource.Value</div></div>
                }
                @foreach (var click in expeditionStats.ClicksMade)
                {
                    <div class="kv"><div class="key">@click.Key</div><div class="val">@click.Value</div></div>
                }
            </div>

            <div style="margin-top:.5rem;">
                <h4>Conhecimento</h4>
                @{
                    long cTotal = 0L;
                    if (_stage?.ExpeditionStats?.CoinsGain?.TryGetValue(_stage.CoinId, out var v) == true)
                        cTotal = v;
                    var kPreview = Knowledge.KnowledgeGain(_stage, cTotal);
                }
                @if (kPreview.Count > 0)
                {
                    <div class="stack-list">
                        @foreach (var kv in kPreview.OrderByDescending(x => x.Value))
                        {
                            <div>@kv.Key @kv.Value.ToString("N2")</div>
                        }
                    </div>
                }
                else
                {
                    <div class="stack-list">Não aprendemos nada ainda</div>
                }
            </div>
        </div>

    }
    else
    {
        <!-- Characters inBase -->
        var chars = game.Characters?.Values ?? Enumerable.Empty<CharacterModel>();
        var avaliableChars = chars.Where(c => c.State == UnlockHelper.State.Unlocked
                                   && c.CharState == UnlockHelper.CharState.InBase || c.CharState == UnlockHelper.CharState.InLine)
                          .OrderBy(c => c.Id)
                          .ToList();

        <div>
            <h3>Characters in Base</h3>
            @if (avaliableChars.Count == 0)
            {
                <div>Nenhum personagem na base.</div>
            }
            else
            {
                <div class="characters-grid">
                    @foreach (var ch in avaliableChars)
                    {
                        var selected = ch.CharState == UnlockHelper.CharState.InLine;
                        var canToggle = Expedition.CanToggleChar(_stage, ch.Id);

                        <button type="button"
                                class="icon-button @(selected ? "selected" : null)"
                                disabled="@( !canToggle )"
                                @onclick="() => OnToggleChar(ch.Id)"
                                @onmouseenter="() => Tooltips.Show(Tooltips.GetHover(HoverType.Character, ch.Id, _stage.Id))"
                                @onmouseleave="Tooltips.Clear"
                                @onfocus="() => Tooltips.Show(Tooltips.GetHover(HoverType.Character, ch.Id, _stage.Id))"
                                @onblur="Tooltips.Clear">
                            @ch.Id
                        </button>
                    }
                </div>
            }
        </div>
    }
}

@code {
    private StageModel? _stage;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        RefreshStage();
    }

    protected override void OnGameChanged()
    {
        RefreshStage();
    }

    private void RefreshStage()
    {
        if (!Game.IsReady || string.IsNullOrWhiteSpace(Game?.CurrentGame.SelectedStageId))
        {
            _stage = null;
            return;
        }

        var g = Game.CurrentGame;
        g.Stages.TryGetValue(Game?.CurrentGame.SelectedStageId, out var st);
        _stage = st;
    }

    private bool isExpActive(StageModel stage)
    {
        var expedition = stage.Expedition;

        if(expedition.ExpeditionState == UnlockHelper.ExpeditionState.Active)
        {
            return true;
        } else
        {
            return false;
        }
    }

    private async Task OnClickToggleExpedition()
    {
        var game = Game.CurrentGame;
        if (game is null) return;

        var isActive = isExpActive(_stage);

        if (!isActive)
        {
            await Expedition.LaunchExpedition(_stage);

            return;
        }
        else
        {
            await Expedition.EndExpedition(_stage);
        }
    }

    private void OnToggleChar(string id)
    {
        Expedition.ToggleChar(_stage, id);

        StateHasChanged();
    }

    private int CountLine()
    {
        int line = 0;

        foreach (var character in Game.CurrentGame.Characters)
        {
            if (character.Value.CharState == UnlockHelper.CharState.InLine) line++;
        }

        return line;
    }
}

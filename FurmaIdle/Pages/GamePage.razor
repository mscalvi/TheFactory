@page "/"

@using System.Linq
@using FurmaIdle.Components;
@using FurmaIdle.Models;
@using FurmaIdle.Data
@using FurmaIdle.Helpers;
@using FurmaIdle.Services;

@inject IJSRuntime JS;
@implements IDisposable

@inject ICreateGameService Start
@inject ICurrentGameService Game
@inject ITooltipService Tooltip
@inject ITickService Ticks
@inject IUnlockService Unlock
@inject IUiService UI

@code {
    #region GameStart
    private bool _ready;

    void OnGameChanged() => InvokeAsync(StateHasChanged);

    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine($"[GP] Iniciando FurmaIdle");

        await Start.InitAsync();
        Console.WriteLine($"[GP] Finalizado Load/Create");

        await UnlockInitialStage();
        Console.WriteLine("[GP] Estágio Inicial Desbloqueado");

        await Ticks.StartAsync();
        Console.WriteLine("[GP] Ticks iniciados");

        StateHasChanged();
        Console.WriteLine("[GP] Jogo atualizado");

        Console.WriteLine("[GP] Jogo iniciado");
    }

    private async Task UnlockInitialStage()
    {
        await Unlock.UnlockStage("s00");
        await Unlock.UnlockExpansion("x00");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Game.GameChanged += () => InvokeAsync(StateHasChanged);
            await Start.InitAsync();
            _ready = IsGameReady();
            StateHasChanged();
        }
    }

    private bool IsGameReady()
    {
        return Game.CurrentGame?.Stages?.Count > 0;
    }
    #endregion

    #region NavMenu
    private NavMenu? navRef;
    private string? _navId = "i4";

    private IEnumerable<StageModel> GetStagesByState(UnlockHelper.State state)
    {
        var game = Game.CurrentGame;
        if (game?.Stages is not { Count: > 0 })
            return Enumerable.Empty<StageModel>();

        var result = new List<StageModel>();
        foreach (var id in StageData.ShowOrder)
        {
            if (game.Stages.TryGetValue(id, out var st) && st.State == state)
                result.Add(st);
        }
        return result;
    }
    #endregion

    #region Gerais
    public void Dispose()
    {
        _ = Ticks.StopAsync();
        Game.GameChanged -= OnGameChanged;
    }
    #endregion
}

@if (!_ready)
{
    <p>Iniciando Jogo</p>
}
else
{
    <div class="game-grid">
        <!-- Navegador -->
        <aside class="nav-menu panel">
            <NavMenu @bind-SelectedId="_navId" />
        </aside>

        <!-- Texto -->
        <section class="text-box panel">text-box</section>

        <!-- Shop -->
        <section class="shop-menu panel">
            <ShopMenu SelectedId="@_navId" />
        </section>

        <!-- Título -->
        <header class="title-box panel">
            <TitleBox />
        </header>

        <!-- Stage/Área -->
        <section class="stage-box panel">
            @if (Game.CurrentGame?.Stages?.Count > 0)
            {
                <StageBox />
            }
            else
            {
                <p>Stage Desativado</p>
            }
        </section>

        <!-- Click -->
        <main class="click-area panel">
            <ClickArea />
        </main>

        <!-- Income -->
        <section class="income-box panel">
            <IncomeBox />
        </section>

        <!-- Contratos -->
        <section class="contracts-menu panel">contracts-menu</section>
    </div>
}


@page "/"

@using System.Linq
@using FurmaIdle.Models;
@using FurmaIdle.Data
@using FurmaIdle.Helpers;
@using FurmaIdle.Services;

@inject IJSRuntime JS;

@implements IDisposable

@inject IStartService Start
@inject IGameService Game
@inject ITooltipService Tooltip
@inject ITickService Ticks

<div class="page">
    <div class="layout">
        <!-- FAIXA SUPERIOR -->
        <header class="band band-top">
            <div class="top-grid">

                <!-- Informações de Moedas e Ganhos -->
                <div class="top-column span2">
                    @if (_coins.Count == 0)
                    {
                        <span>Carregando…</span>
                    }
                    else
                    {
                        <div class="currency-grid">
                            @foreach (var r in _coins)
                            {
                                <div class="currency-card">
                                    <img class="currency-icon" src="@r.Image" alt="@r.Name" />
                                    <div class="currency-info">
                                        <div class="currency-name">@r.Name</div>
                                        <div>Atual: @r.Actual.ToString("N0")</div>
                                        <div>Total: @r.Total.ToString("N0")</div>
                                        <div>Por Segundo: @r.PerSecond.ToString("N2")</div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Botões do Menu Superior -->
                <div class="top-column">
                    <div class="top-actions">
                        <button class="tab-btn @(IsActive(TopPanel.Base) ? "active" : "")"
                                @onclick="() => TogglePanel(TopPanel.Base)">
                            <span class="icon-wrap">
                                <img src="@IconSrc(TopPanel.Base)" alt="Base"
                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';" />
                                <span class="icon-fallback">@IconFallback(TopPanel.Base)</span>
                            </span>
                        </button>

                        <button class="tab-btn @(IsActive(TopPanel.Melhorias) ? "active" : "")"
                                disabled="@(!CanInteract)"
                                @onclick="() => TogglePanel(TopPanel.Melhorias)">
                            <span class="icon-wrap">
                                <img src="@IconSrc(TopPanel.Melhorias)" alt="Melhorias"
                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';" />
                                <span class="icon-fallback">@IconFallback(TopPanel.Melhorias)</span>
                            </span>
                        </button>

                        <button class="tab-btn @(IsActive(TopPanel.Tecnologias) ? "active" : "")"
                                disabled="@(!CanInteract)"
                              @onclick="() => TogglePanel(TopPanel.Tecnologias)">
                                <span class="icon-wrap">
                                  <img src="@IconSrc(TopPanel.Tecnologias)" alt="Tecnologias"
                                       onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';" />
                                  <span class="icon-fallback">@IconFallback(TopPanel.Tecnologias)</span>
                                </span>
                        </button>

                        <button class="tab-btn @(IsActive(TopPanel.Destinos) ? "active" : "")"
                                disabled="@(!CanInteract)"
                              @onclick="() => TogglePanel(TopPanel.Destinos)">
                            <span class="icon-wrap">
                              <img src="@IconSrc(TopPanel.Destinos)" alt="Destinos"
                                   onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';" />
                              <span class="icon-fallback">@IconFallback(TopPanel.Destinos)</span>
                            </span>
                        </button>
                    </div>
                </div>

                <!-- Menu Superior -->
                <div class="top-column span3">
                    <div class="panel-host @( _topPanel == TopPanel.None ? null : "panel-host--content" )">
                        @if (_topPanel == TopPanel.None)
                        {
                            <div class="msg-panel">
                                <div class="msg-body" @ref="_msgBodyRef">
                                  <div class="msg-list">
                                    @if (_msgs.Count == 0)
                                    {
                                      <em>Sem mensagens.</em>
                                    }
                                    else
                                    {
                                      @foreach (var m in _msgs)
                                      {
                                        <div class="msg-row @Css(m.Kind)">
                                          <span class="msg-time">@m.Time.ToString("HH:mm:ss: ")</span>
                                          <span class="msg-text">@m.Text</span>
                                        </div>
                                      }
                                    }
                                  </div>
                              </div>
                            </div>
                        }
                        else if (_topPanel == TopPanel.Base)
                        {
                            @if (_baseChars.Count == 0)
                            {
                                <em>Nenhum personagem na base.</em>
                            }
                            else
                            {
                                <div class="options-grid">
                                    @foreach (var ch in _baseChars)
                                    {
                                        <button class="option-btn @(CharSelected(ch.Id) ? "selected" : null)"
                                                disabled="@(!_canToggleChar(ch.Id))"
                                                @onclick="() => ToggleCharSelect(ch.Id)"
                                                aria-pressed="@(CharSelected(ch.Id) ? "true" : "false")"
                                                aria-label="@ch.Id"
                                                @onmouseenter="() => ShowHover(FurmaIdle.Services.HoverType.Personagem, ch.Id)"
                                                @onmouseleave="ClearHover">
                                            <span class="icon-wrap">
                                                <img src="@CharMiniSrc(ch.Id)"
                                                     alt="@ch.Id"
                                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';" />
                                                <span class="icon-fallback">@ch.Id</span>
                                            </span>
                                        </button>
                                    }
                                </div>
                            }
                        }
                        else if (_topPanel == TopPanel.Tecnologias)
                        {
                            <div class="options-grid">
                                @if (_techs.Count == 0)
                                {
                                    <em>Nenhuma tecnologia desbloqueada.</em>
                                }
                                else
                                {
                                    @foreach (var t in _techs)
                                    {
                                        var kid = t.CostKnowledgeId;
                                        int have = 0;
                                        if (!string.IsNullOrWhiteSpace(kid) &&
                                        Game.Current.Knowledges.TryGetValue(kid, out var k) && k is not null)
                                            have = k.Points;

                                        bool canAfford = !t.Unlocked && (string.IsNullOrWhiteSpace(kid) || have >= t.Cost);

                                        <button class="option-btn"
                                                disabled="@(!canAfford || t.Unlocked)"
                                                @onclick="() => OnTechClick(t.Id)"
                                                @onmouseenter="() => ShowHover(FurmaIdle.Services.HoverType.Tecnologia, t.Id)"
                                                @onmouseleave="ClearHover"
                                                title="@(t.Unlocked
                                                                                                                        ? "Já pesquisada"
                                                                                                                        : (string.IsNullOrWhiteSpace(kid)
                                                                                                                              ? "Custo 0"
                                                                                                                              : (canAfford ? $"Pesquisar por {t.Cost:N0} {kid}"
                                                                                                                                           : $"Precisa de {t.Cost:N0} {kid} · Você tem {have:N0}")))"
                                                aria-label="@t.Name">
                                            <span class="icon-wrap">
                                                <img src="@t.Image" alt="@t.Name"
                                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';" />
                                                <span class="icon-fallback">@t.Id</span>
                                            </span>
                                        </button>
                                    }
                                }
                            </div>
                        }
                        else if (_topPanel == TopPanel.Destinos)
                        {
                            <div class="options-grid">
                                @if (_dests.Count == 0)
                                {
                                    <em>Nenhum destino desbloqueado.</em>
                                }
                                else
                                {
                                    @foreach (var d in _dests)
                                    {
                                        var resId = string.IsNullOrWhiteSpace(d.CostResourceId) ? "r001" : d.CostResourceId!;
                                        var have = Game.Get(resId)?.Actual ?? 0;
                                        bool canAfford = !d.Unlocked && have >= d.Cost;

                                        <button class="option-btn"
                                                disabled="@(!canAfford || d.Unlocked)"
                                                @onclick="() => OnDestClick(d.Id)"
                                                @onmouseenter="() => ShowHover(FurmaIdle.Services.HoverType.Destino, d.Id)"
                                                @onmouseleave="ClearHover"
                                                title="@(d.Unlocked
                                                                        ? "Já desbloqueado"
                                                                        : (canAfford ? $"Desbloquear por {d.Cost:N0} {resId}"
                                                                                     : $"Precisa de {d.Cost:N0} {resId} · Você tem {have:N0}"))"
                                                aria-label="@d.Name">
                                            <span class="icon-wrap">
                                                <img src="@d.Image" alt="@d.Name"
                                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';" />
                                                <span class="icon-fallback">@d.Id</span>
                                            </span>
                                        </button>
                                    }

                                }
                            </div>
                        }
                        else if (_topPanel == TopPanel.Melhorias)
                        {
                            <div class="options-grid">
                                @if (_upgr.Count == 0 && _shopChars.Count == 0)
                                {
                                    <em>Nada para comprar no momento.</em>
                                }
                                else
                                {
                                    @foreach (var u in _upgr)
                                    {
                                        // resolve ref (live > def) para pegar CostResourceId/MaxBuys/etc.
                                        var uref = u;
                                        if (string.IsNullOrWhiteSpace(uref.CostResourceId))
                                        {
                                            try { var def = UpgradeData.GetDef(u.Id); if (def is not null) uref = def; } catch { }
                                        }

                                        var resId = string.IsNullOrWhiteSpace(uref.CostResourceId) ? "r001" : uref.CostResourceId!;
                                        var price = Helpers.UpgradePricingHelper.NextPrice(uref);
                                        var have = Game.Get(resId)?.Actual ?? 0;

                                        bool canAfford = have >= price;
                                        bool isDisabled = u.IsMaxed || !canAfford;

                                        <button class="option-btn"
                                                disabled="@isDisabled"
                                                @onclick="() => OnUpgrClick(u.Id)"
                                                @onmouseenter="() => ShowHover(FurmaIdle.Services.HoverType.Melhoria, u.Id)"
                                                @onmouseleave="ClearHover"
                                                title="@(u.IsMaxed
                                                                      ? "Maxeada"
                                                                      : (canAfford ? $"Comprar por {price:N0} {resId}"
                                                                                   : $"Precisa de {price:N0} {resId} · Você tem {have:N0}"))"
                                                aria-label="@u.Name">
                                            <span class="icon-wrap">
                                                <img src="@u.Image" alt="@u.Name"
                                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';" />
                                                <span class="icon-fallback">@u.Id</span>
                                            </span>
                                        </button>
                                    }

                                    @foreach (var ch in _shopChars)
                                    {
                                        <button class="option-btn"
                                                @onclick="() => OnCharBuy(ch.Id)"
                                                @onmouseenter="() => ShowHover(HoverType.Personagem, ch.Id)"
                                                @onmouseleave="ClearHover"
                                                aria-label="@ch.Id">
                                            <span class="icon-wrap">
                                                <img src="@CharMiniSrc(ch.Id)"
                                                     alt="@ch.Id"
                                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';" />
                                                <span class="icon-fallback">@ch.Id</span>
                                            </span>
                                        </button>
                                    }
                                }
                            </div>
                        }
                    </div>
                </div>

                <!-- Expedição -->
                <div class="top-column span2">
                    <div class="exp-box">
                        <button class="primary-btn"
                                disabled="@(!_CanStartExpedition())"
                                @onclick="ToggleExpedition">
                            @(ExpeditionActive ? "Terminar expedição" : "Iniciar expedição")
                        </button>

                        @* --- NOVO: botão Expandir (sempre visível) --- *@
                        @{
                            // 1) Descobre o destino "ativo" comprado no stage atual (seu critério pode ser outro)
                            var stageDestUnlocked = Game.Current.Destinations?.Values
                            .Where(d => d is not null && d.StageId == stageId && d.Unlocked)
                            .OrderBy(d => d.Id, StringComparer.Ordinal)    // deterministic
                            .FirstOrDefault();

                            // 2) Seleciona a expansão vinculada a esse destino (se houver)
                            var exp = Game.Current.Expansions?.Values
                            .Where(x => x is not null
                            && (stageDestUnlocked == null || x.DestUnlockId == stageDestUnlocked.Id))
                            .OrderBy(x => x?.Cost ?? double.MaxValue)
                            .FirstOrDefault();

                            // 3) Resolve custo/saldo com segurança
                            string expId = exp?.Id ?? "";
                            string costResId = !string.IsNullOrWhiteSpace(exp?.CoinCostId) ? exp!.CoinCostId! : "r001"; // fallback

                            double costVal = Math.Max(0, exp?.Cost ?? 0);
                            double haveMoney = Game.Get(costResId)?.Actual ?? 0;

                            // 4) Regras de bloqueio
                            bool exists = exp is not null;
                            bool available = exists && exp!.Avaliable && !exp.Unlocked;
                            bool hasMoney = exists && haveMoney >= costVal;
                            bool canExpand = exists && available && hasMoney;

                            // 5) Mensagem de tooltip (motivo do bloqueio)
                            string expandTitle =
                            !exists
                            ? "Nenhuma expansão disponível para este destino."
                            : !exp!.Avaliable
                            ? "Expansão ainda não disponível."
                            : exp.Unlocked
                            ? $"Expansão {exp.Id} já comprada."
                            : hasMoney
                            ? $"Comprar expansão {exp!.Id} por {costVal:N0} {costResId}"
                            : $"Precisa de {costVal:N0} {costResId} (você tem {haveMoney:N0}).";
                        }

                        <button class="primary-btn"
                                disabled="@( !canExpand )"
                                title="@expandTitle"
                                @onclick="@(() => { if (canExpand) OnExpandClick(expId); })">
                                @($"Expandir{(exists ? $" {expId} ({costVal:N0} {costResId})" : "")}")
                        </button>


                        <div class="exp-meta exp-meta--compact"> 
                            <div><strong>Membros ativos:</strong> @Party.UsedStage / @Party.CapStage</div> 
                            @{
                                var kprev = Game.GetKnowledgePreview(stageId);
                                string KName(string kid) { 
                                if (Game.Current.Knowledges.TryGetValue(kid, out var k) && !string.IsNullOrWhiteSpace(k.Name)) 
                                    return k.Name!;
                                    try {
                                        return KnowledgeData.GetDef(kid).Name ?? kid; 
                                    } catch 
                                    { 
                                        return kid; 
                                    } 
                                }
                            }
                            <div>
                                <strong>Conhecimento ao encerrar:</strong> 
                                @if (kprev.Count == 0) {
                                    <text> —</text>
                                } 
                                else
                                {
                                    <text> </text> 
                                    @foreach (var kv in kprev.OrderByDescending(x => x.Value)) {
                                        <span>+@kv.Value @KName(kv.Key) </span>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <!-- FAIXA CENTRAL -->
        <main class="band band-mid">
            <div class="mid-grid">

                <!-- Recursos, Personagens e Especialidades -->
                <div class="mid-column resources">

                    <!-- Recursos e Regeneração -->
                    <div class="resources-top">
                        @if (_resources.Count == 0)
                        {
                            <span>Carregando…</span>
                        }
                        else
                        {
                            <div class="currency-grid">
                                @foreach (var r in _resources)
                                {
                                    var capPerChar = Game.GetResourceCapPerChar(r.Id);
                                    var members = Party.UsedStage;
                                    var resCapTotal = capPerChar > 0 ? capPerChar * members : 0;

                                    <div class="currency-card">
                                        <img class="currency-icon" src="@r.Image" alt="@r.Name" />
                                        <div class="currency-info">
                                            <div class="currency-name">@r.Name</div>
                                            <div>Limite: @r.Actual.ToString("N0") / @resCapTotal.ToString("N0") (por personagem: @capPerChar.ToString("N0"))</div>
                                            <div>Total: @r.Total.ToString("N0")</div>
                                            <div>Por Segundo: @r.PerSecond.ToString("N2")</div>
                                        </div>
                                    </div>
                                }
                            </div>

                        }
                    </div>

                    <!-- Personagens e Especialidades -->
                    @{
                        var specRows = Math.Max(6, stage?.PartyCap ?? 0);
                    }
                    <div class="resources-mid">
                        <div class="char-list-host">
                            <div class="char-rows char-rows--grid" style="@($"--spec-rows:{specRows}")">
                                @for (int i = 0; i < specRows; i++)
                                {
                                    if (i < _activeChars.Count)
                                    {
                                        var c = _activeChars[i];

                                        SpecialtyModel? spec = null;
                                        if (!string.IsNullOrWhiteSpace(c.SpecialtyId))
                                        {
                                            try { spec = SpecialtyData.GetDef(c.SpecialtyId); } catch { spec = null; }
                                        }

                                        var resId = spec?.CostResourceId ?? "r100";
                                        var cost = Math.Max(0, spec?.Cost ?? 0);
                                        var have = Game.Get(resId)?.Actual ?? 0;
                                        var canUse = spec is not null && have >= cost;

                                        <div class="char-row">

                                            <!-- Coluna 1: ícone (grande, com hover Personagem) -->
                                            <div class="char-cell-icon"
                                                 @onmouseover="() => ShowHover(HoverType.Personagem, c.Id)"
                                                 @onmouseout="ClearHover">
                                                <span class="icon-wrap">
                                                    <img class="char-mini"
                                                         src="@BigCharSrc(c.Id)"
                                                         alt="@c.Id"
                                                         onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';" />
                                                    <span class="icon-fallback">@c.Id</span>
                                                </span>
                                            </div>

                                            <!-- Coluna 2: custo -->
                                            <div class="char-cell-cost"
                                                 title="@(spec is null ? "Sem especialidade" : $"{cost:N0} {resId} · Você tem {have:N0}")">
                                                @(spec is null ? "—" : $"{cost:N0} {resId}")
                                            </div>

                                            <!-- Coluna 3: Especialidade (preenche a linha) -->
                                            @{
                                                var timer = Game.GetSpecialtyTimer(c.Id);
                                                bool isActive = timer.active;
                                                double ratio = isActive && timer.total > 0 ? (1.0 - (timer.remaining / timer.total)) : 0.0;
                                                int stepsOn = Math.Clamp((int)Math.Floor(ratio * 10.0), 0, 10);
                                            }

                                            <div class="char-cell-actions">

                                                @if (isActive)
                                                {
                                                    <div class="contract-selected is-compact" aria-hidden="true">
                                                        <div class="contract-progress"></div>
                                                        <div class="contract-steps">
                                                            @for (int j = 0; j < 10; j++)
                                                            {
                                                                var on = j < stepsOn ? "is-on" : null;
                                                                <span class="step @on"></span>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <button class="mini-btn"
                                                            disabled="@(spec is null || !canUse || isActive)"
                                                            title="@(spec is null
                                                                 ? "Sem especialidade"
                                                                 : isActive
                                                                 ? $"Em uso ({Math.Ceiling(timer.remaining):0}s)"
                                                                 : (canUse ? $"Ativar ({cost:N0} {resId})"
                                                                 : $"Precisa de {cost:N0} {resId} · Você tem {have:N0}"))"
                                                            @onclick="() => OnSpecialtyClick(c.Id)"
                                                            @onmouseenter="() => ShowHover(HoverType.Especialidade, c.Id)"
                                                            @onmouseleave="ClearHover">
                                                        Especialidade
                                                    </button>
                                                }
                                            </div>

                                        </div>
                                    }
                                    else
                                    {
                                        <!-- slot vazio só pra manter a divisão igual -->
                                        <div class="char-row char-row--empty">
                                            <div class="char-cell-icon"></div>
                                            <div class="char-cell-cost"></div>
                                            <div class="char-cell-actions"></div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Archievements e Configurações -->
                    <div class="resources-top">
                        @if (_resources.Count == 999)
                        {
                            <span>Carregando…</span>
                        }
                        else
                        {
                            <span>Carregando…</span>
                        }
                    </div>
                </div>

                <!-- Stage e Clicks -->
                <div class="mid-column span2">
                    <img class="stage-image @(ExpeditionActive ? null : "is-idle")"
                         src="@(stage?.ClickImage ?? "images/stages/s00.jpg")"
                         alt="@(stage?.Name ?? "Cenário")"
                         draggable="false"
                         @onclick="OnStageClick" />
                </div>

                <!-- Contratos e Descrições -->
                @{
                    var slots = stage?.ContractsSlots > 0 ? stage.ContractsSlots : 3;
                    var levels = ContractsHelper.GetContractLevelsForStage(Game, stageId);
                }
                <div class="mid-column contracts">
                    <div class="hover-wrap @( _midHoverVisible ? "show" : null)">
                        <div class="hover-base">
                            @{
                                var expd = Game.GetExpedition(stageId);
                                var capTotal = Game.GetContractsCap(stageId);
                                var usedUnits = expd?.Contracts?.Values?.Sum(c => c.Quant) ?? 0;
                                var capReached = usedUnits >= capTotal;
                            }
                            <div class="contracts-capbar">
                                <strong>Contratos:</strong> @usedUnits / @capTotal
                            </div>
                            <div class="contracts-grid" style="--slots:@slots">
                                @for (int i = 0; i < slots; i++)
                                {
                                    if (i < levels.Count)
                                    {
                                        var lvl = levels[i];

                                        string? chosenId = null;
                                        if (expd?.LockedContractByLevel != null && expd.LockedContractByLevel.TryGetValue(lvl, out var cid))
                                            chosenId = cid;

                                        ContractModel? chosen = null;
                                        if (chosenId is not null && expd?.Contracts != null)
                                            expd.Contracts.TryGetValue(chosenId, out chosen);

                                        @if (chosen is not null && chosen.Quant > 0)
                                        {
                                            var price = ContractsPricingHelper.NextPrice(chosen);
                                            var (resId, cps, spc) = ContractsPricingHelper.ProdParams(chosen);
                                            var pps = ContractsPricingHelper.ProdPerSecond(chosen);

                                            var balance = Game.Get(resId)?.Actual ?? 0;
                                            var canAfford = balance >= price;

                                            var p = Game.GetContractProgress01(stageId, chosen.Id);
                                            var pct = (p * 100).ToString("0.##") + "%";
                                            var stepsOn = Math.Clamp((int)Math.Floor(p * 10), 0, 10);

                                            <div class="contract-selected">
                                                <div class="contract-progress" aria-hidden="true"></div>

                                                <div class="contract-steps" aria-hidden="true">
                                                    @for (int j = 0; j < 10; j++)
                                                    {
                                                        var on = j < stepsOn ? "is-on" : null;
                                                        <span class="step @on"></span>
                                                    }
                                                </div>

                                                <span class="icon-wrap"><img src="@chosen.Image" alt="@chosen.Id" /></span>

                                                <div class="contract-selected-info">
                                                    <div class="name">@chosen.Name</div>
                                                    <div class="sub">
                                                        Total: @chosen.Quant
                                                        Preço: @price.ToString("N0") @resId
                                                    </div>
                                                </div>

                                                <button class="mini-btn buy-more"
                                                        disabled="@(capReached || !canAfford)"
                                                        title="@(canAfford ? "+1 contrato" : $"Precisa de {price:N0} {resId} (você tem {balance:N0})")"
                                                        @onclick="() => OnContractBuyMore(chosen.Id)">
                                                    +1
                                                </button>
                                            </div>
                                        }
                                        else
                                        {
                                            var isOpen = _openContractLevel == lvl;

                                            if (!isOpen)
                                            {
                                                <button class="mini-btn contract-btn"
                                                        disabled="@capReached" @onclick="() => ToggleContractLevel(lvl)">
                                                    Contrato Nível @lvl
                                                </button>
                                            }
                                            else
                                            {
                                                var items = ContractsHelper.GetContractsForLevel(Game, stageId, lvl);
                                                <div class="contract-subrow">
                                                    <button class="mini-btn back-btn"
                                                            title="Voltar"
                                                            @onclick="() => ToggleContractLevel(lvl)">
                                                        ← Voltar
                                                    </button>

                                                    <div class="contract-scroll" role="list" aria-label="@($"Contratos do nível {lvl}")">
                                                        @if (items.Count == 0)
                                                        {
                                                            <div class="mini-empty" role="note">Nenhum contrato disponível.</div>
                                                        }
                                                        else
                                                        {
                                                            @foreach (var ct in items)
                                                            {
                                                                <button class="mini-contract"
                                                                        role="listitem"
                                                                        title="@ct.Name"
                                                                        disabled="@capReached"
                                                                        @onclick="() => OnContractClick(ct.Id)">
                                                                    <span class="icon-wrap">
                                                                        <img src="@ct.Image"
                                                                             alt="@ct.Name"
                                                                             onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';" />
                                                                        <span class="icon-fallback">@ct.Name</span>
                                                                    </span>
                                                                </button>
                                                            }
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        }
                                    }
                                    else
                                    {
                                        <div class="contract-slot-empty"></div>
                                    }
                                }
                            </div>
                        </div>

                        <div class="hover-panel">
                            @if (!_midHoverVisible)
                            {
                                <em>Passe o mouse em um item para ver detalhes aqui.</em>
                            }
                            else
                            {
                                <div class="hover-title">@((MarkupString)_midHoverTitle)</div>
                                <div class="hover-row">@((MarkupString)_midHoverBody)</div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>

@code {
    #region Inicialização
    protected override void OnInitialized()
    {
        Game.Changed += OnGameChanged;
        Game.Logged += OnLogged;
    }

    bool _busy;

    protected override async Task OnInitializedAsync()
    {
        var model = await Start.InitAsync();
        Game.Attach(model);

        RefreshCoins();
        RefreshResources();
        RefreshChars();
        RefreshTechs();
        RefreshDestinations();
        RefreshUpgrades();
        RefreshContracts();
        RefreshShopChars();

    Log("Jogo Iniciado.", MsgKind.Success);

        var sid = Game.SelectedStageId;
        var roster = Game.GetRoster();

        double uiAccum = 0;
        Ticks.Start(async dt =>
        {
            Game.Tick(dt);                
            uiAccum += dt;
            if (uiAccum >= 1.0 / 5.0)     
            {
                uiAccum = 0;
                await InvokeAsync(StateHasChanged);
            }
        }, targetHz: 10);

        if (!Game.StartExpedition(sid, roster, out var reason))
        {
            Log(reason ?? "Não foi possível iniciar a expedição.", MsgKind.Error);
            return;
        };

        if (!ExpeditionActive)
        {
            _topPanel = TopPanel.Base;
        }
        else
        {
            GoToMessages();
        }

        Log("Três jovens se reunem e resolvem montar uma Guilda. Ganhe algum dinheiro, mas cuidado que os Contratos são limitados.", MsgKind.Info);
    }
    #endregion

    #region Mensagens
    ElementReference _msgBodyRef;
    int _lastMsgCount;
    bool _scrollMessagesOnOpen;

    // Tipos de mensagem
    enum MsgKind { Info, Warn, Error, Success }

    // Modelo de mensagem
    sealed class UiMessage
    {
        public DateTime Time { get; init; } = DateTime.Now;
        public string Text { get; init; } = "";
        public MsgKind Kind { get; init; } = MsgKind.Info;
    }

    List<UiMessage> _msgs = new();

    void GoToMessages()
    {
        _topPanel = TopPanel.None;
        _scrollMessagesOnOpen = true;
        StateHasChanged();
    } 

    // helper para CSS por tipo
    string Css(MsgKind k) => k switch
    {
        MsgKind.Warn   => "is-warn",
        MsgKind.Error  => "is-error",
        MsgKind.Success=> "is-success",
        _              => "is-info"
    };

    private static MsgKind Map(LogKind k) => k switch
    {
        LogKind.Warn => MsgKind.Warn,
        LogKind.Error => MsgKind.Error,
        LogKind.Success => MsgKind.Success,
        _ => MsgKind.Info
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _lastMsgCount = _msgs.Count;
            if (_topPanel == TopPanel.None) // só se Mensagens estiver visível
                await JS.InvokeVoidAsync("ui.scrollToBottom", _msgBodyRef);
            return;
        }

        // Se abrimos Mensagens nesta renderização, rola para o fim
        if (_scrollMessagesOnOpen && _topPanel == TopPanel.None)
        {
            _scrollMessagesOnOpen = false;
            await JS.InvokeVoidAsync("ui.scrollToBottom", _msgBodyRef);
        }

        // Se chegaram novas mensagens, só rola se o usuário estiver perto do fim
        if (_msgs.Count != _lastMsgCount)
        {
            _lastMsgCount = _msgs.Count;
            if (_topPanel == TopPanel.None)
                await JS.InvokeVoidAsync("ui.scrollToBottomIfNearEnd", _msgBodyRef, 40);
        }
    }


    // atalho para publicar mensagens no log
    void Log(string text, MsgKind kind = MsgKind.Info)
    {
        _msgs.Add(new UiMessage { Text = text, Kind = kind, Time = DateTime.Now });
        StateHasChanged();
    }
    #endregion

    #region Expedition
    PartyInfo Party => Game.GetPartyInfo(stageId);
    ExpeditionModel? Ex => Game.GetExpedition(stageId);
    bool ExpeditionActive => Party.ExpeditionActive;
    bool CanInteract => Game.HasAnyExpeditionActive;
    int SelectedCount => Party.UsedRoster;

    bool _CanStartExpedition()
    {
        if (ExpeditionActive) return true;
        return SelectedCount >= 1 && SelectedCount <= Party.CapStage;
    }

    bool _canToggleChar(string id)
    {
        if (ExpeditionActive) return false;
        if (CharSelected(id)) return true;
        return SelectedCount < Party.CapStage;
    }

    private async Task ToggleExpedition()
    {
        if (_busy) return;
        _busy = true; StateHasChanged();
        try
        {
            var sid = Game.SelectedStageId;
            var roster = Game.GetRoster();

            if (Game.GetExpedition(sid)?.ExpeditionStatus == ExpeditionEnum.ExpeditionStatus.Active)
            {
                foreach (var r in _coins)
                {
                    Log($"{r.Actual} de {r.Name} no retorno, vai virar cerveja!", MsgKind.Success);
                }

                Game.EndExpedition(sid);
                RefreshChars();
                RefreshContracts();
                if (!Game.StartExpedition(sid, roster, out var reason))
                {
                    Log(reason ?? "Não foi possível iniciar a expedição.", MsgKind.Error);

                    if (!ExpeditionActive)
                    {
                        _topPanel = TopPanel.Base;
                    }
                    else
                    {
                        GoToMessages();
                    }
                    return;
                }
                if (!ExpeditionActive)
                {
                    _topPanel = TopPanel.Base;
                }
                else
                {
                    GoToMessages();
                }
                return;
            }  

            if (!Game.StartExpedition(sid, roster, out var reason2))
            {
                Log(reason2 ?? "Não foi possível iniciar a expedição.", MsgKind.Error);
                if (!ExpeditionActive)
                {
                    _topPanel = TopPanel.Base;
                }
                else
                {
                    GoToMessages();
                }
                return;
            }

            RefreshChars();
            RefreshContracts();
            if (!ExpeditionActive)
            {
                _topPanel = TopPanel.Base;
            }
            else
            {
                GoToMessages();
            }
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            _busy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    #endregion

    #region Botões do TOPO

    enum TopPanel { None, Tecnologias, Destinos, Melhorias, Base }
    TopPanel _topPanel = TopPanel.None;

    string _topPanelText => _topPanel switch
    {
        TopPanel.Tecnologias => "Tecnologias",
        TopPanel.Destinos    => "Destinos",
        TopPanel.Melhorias   => "Melhorias",
        TopPanel.Base        => "Base",
        _ => "Mensagens"
    };

    bool IsActive(TopPanel p) => _topPanel == p;

    void TogglePanel(TopPanel p)
    {
        if (!CanInteract)
        {
            _topPanel = TopPanel.Base;
            StateHasChanged();
            return;
        }

        var prev = _topPanel;
        _topPanel = (_topPanel == p) ? TopPanel.None : p;

        if (_topPanel == TopPanel.None && prev != TopPanel.None)
            _scrollMessagesOnOpen = true;

        StateHasChanged();
    }

    string IconSrc(TopPanel p) => p switch
    {
        TopPanel.Tecnologias => "images/icons/tech.png",
        TopPanel.Destinos    => "images/icons/dest.png",
        TopPanel.Melhorias   => "images/icons/upgr.png",
        TopPanel.Base        => "images/icons/base.png",
        _ => ""
    };

    string IconFallback(TopPanel p) => p switch
    {
        TopPanel.Tecnologias => "T",
        TopPanel.Destinos    => "D",
        TopPanel.Melhorias   => "M",
        TopPanel.Base        => "B",
        _ => "?"
    };
    #endregion

    #region Painel de Descrição
    bool _midHoverVisible;
    string _midHoverTitle = "";
    string _midHoverBody  = "";
    (FurmaIdle.Services.HoverType type, string id)? _hoverKey;

    void ShowHover(FurmaIdle.Services.HoverType type, string id)
    {
        if (_hoverKey is { } k && k.type == type && k.id == id && _midHoverVisible)
            return;

        _hoverKey = (type, id);
        var tip = Tooltip.GetHover(type, id);
        _midHoverTitle = tip.Title;
        _midHoverBody = tip.Body;
        _midHoverVisible = true;
    }

    void ClearHover()
    {
        _midHoverVisible = false;
        _hoverKey = null;
        StateHasChanged();
    }
    #endregion

    #region Clicks
    void OnStageClick()
    {
        if (!Party.ExpeditionActive) return;
        Game.Click(stageId);
    }
    #endregion

    #region Moedas
    List<ResourceModel> _coins = new();


    void RefreshCoins()
    {
        _coins = ResourceData.Order
            .Select(id => Game.Get(id))
            .OfType<ResourceModel>()
            .Where(r => r.Unlocked && r.ResourceType == ResourceEnum.ResourceType.Coin)
            .ToList();
    }
    #endregion

    #region Recursos
    List<ResourceModel> _resources = new();

    void RefreshResources()
    {
        _resources = ResourceData.Order
            .Select(id => Game.Get(id))
            .OfType<ResourceModel>()
            .Where(r => r.Unlocked && r.ResourceType == ResourceEnum.ResourceType.Resource)
            .ToList();
    }
    #endregion

    #region Personagens
    List<CharacterModel> _activeChars = new();
    List<CharacterModel> _baseChars = new();
    List<CharacterModel> _shopChars = new();
    IReadOnlyCollection<string> Roster => Game.GetRoster();

    bool CharSelected(string id) => Roster.Contains(id);

    string BigCharSrc(string charId)
        => $"images/characters/bigimage/{charId}.jpg";

    void RefreshChars()
    {
        var all = Game.Current.Characters.Values;

        _activeChars = all
            .Where(c => c.CharState == CharStateEnum.CharState.OnStage
                     && c.CharStageId == stageId)
            .ToList();

        _baseChars = all
            .Where(c => c.CharState == CharStateEnum.CharState.InBase)
            .ToList();
    }

    void RefreshShopChars()
    {
        _shopChars = Game.Current.Characters.Values
            .Where(c => c.Avaliable && !c.Unlocked)
            .OrderBy(c => c.Id, StringComparer.Ordinal)
            .ToList();
    }

    string CharMiniSrc(string charId)
        => $"images/characters/minis/{charId}.png";


    void ToggleCharSelect(string id)
    {
        if (ExpeditionActive) { Log("Não é possível alterar a seleção durante a expedição.", MsgKind.Warn); return; }
        if (!Game.ToggleRoster(id, out var reason))
            Log(reason ?? "Não foi possível alterar a seleção.", MsgKind.Error);
    }

    void OnCharBuy(string charId)
    {
        if (!Game.BuyCharacter(charId, out var reason))
            Log(reason ?? "Não foi possível contratar.", MsgKind.Warn);
        else
            Log($"{charId} contratado!", MsgKind.Success);

        RefreshChars();        // atualiza base/ativos
        RefreshShopChars();    // some da loja
        ClearHover();
        ShowHover(HoverType.Personagem, charId);
    }
    #endregion

    #region Tecnologias
    List<TechModel> _techs = new();

    void OnTechClick(string techId)
    {
        if (!Game.BuyTech(techId, out var reason))
            Log(reason ?? "Não foi possível comprar a tecnologia.", MsgKind.Warn);
        else
            Log($"{techId} desbloqueada.", MsgKind.Success);
        ClearHover();
        ShowHover(HoverType.Tecnologia, techId);
    }

    void RefreshTechs()
    {
        _techs = TechData.Order
            .Select(id => Game.Current.Technologies.TryGetValue(id, out var t) ? t : null)
            .Where(t => t is not null && t.Avaliable)
            .Cast<TechModel>()
            .ToList();
    }
    #endregion

    #region Destions
    List<DestinationModel> _dests = new();

    void OnDestClick(string destId)
    {
        if (!Game.BuyDestination(destId, out var reason))
            Log(reason ?? "Não foi possível desbloquear o destino.", MsgKind.Warn);
        else
            Log($"{destId} desbloqueado.", MsgKind.Success);
        ClearHover();
        ShowHover(HoverType.Destino, destId);
    }

    void RefreshDestinations()
    {
        _dests = DestinationData.Order
            .Select(id => Game.Current.Destinations.TryGetValue(id, out var d) ? d : null)
            .Where(d => d is not null && d.Avaliable)
            .Cast<DestinationModel>()
            .ToList();
    }
    #endregion

    #region Melhorias
    List<UpgradeModel> _upgr = new();

    void OnUpgrClick(string upgrId)
    {
        if (!Game.BuyUpgrade(upgrId, out var reason))
            Log(reason ?? "Não foi possível comprar a melhoria.", MsgKind.Warn);
        else
            Log($"+1 em {upgrId}.", MsgKind.Success);
        ClearHover();
        ShowHover(HoverType.Melhoria, upgrId);
    }

    void RefreshUpgrades()
    {
        _upgr = Game.Current.Upgrades.Values
            .Where(u => u?.Avaliable == true)
            .Where(ShouldShowUpgradeForCurrentExpedition)   // << filtro novo
            .OrderBy(u => u.Id, StringComparer.Ordinal)
            .ToList();
    }

    bool ShouldShowUpgradeForCurrentExpedition(UpgradeModel u)
    {
        var ex = Game.GetExpedition(stageId);
        if (ex is null || ex.ExpeditionStatus != ExpeditionEnum.ExpeditionStatus.Active)
            return true; // fora de expedição, não filtramos (mostra normal)

        // pega os "contratos-alvo" desta melhoria
        var targetedContracts = u.Effects?
            .Where(e =>
                (e.Target == EffectTarget.ContractGain || e.Target == EffectTarget.ContractTime) &&
                !string.IsNullOrWhiteSpace(e.ScopeId) &&
                !string.Equals(e.ScopeId, "all", StringComparison.OrdinalIgnoreCase))
            .Select(e => e.ScopeId!)
            .Distinct(StringComparer.Ordinal)
            .ToList();

        // se não afeta contrato específico, deixa aparecer
        if (targetedContracts is null || targetedContracts.Count == 0)
            return true;

        // só mostra se pelo menos 1 contrato-alvo estiver ativo na expedição
        if (ex.Contracts is null) return false;

        foreach (var cid in targetedContracts)
            if (ex.Contracts.TryGetValue(cid, out var c) && c?.Quant > 0)
                return true;

        return false;
    }
    #endregion

    #region Stage
    string stageId => Game.SelectedStageId;
    StageModel? stage => Game.GetSelectedStage();

    static string GetFirstUnlockedStageId(GameModel model)
    {
        foreach (var id in StageData.Order)
            if (model.Stages.TryGetValue(id, out var s) && s.Unlocked) return id;

        // fallback: primeiro qualquer do dicionário
        return model.Stages.Keys.FirstOrDefault() ?? "s00";
    }
    #endregion

    #region Contracts
    List<ContractsHelper.ContractButton> _contractButtons = new();
    bool _capNotified;
    int? _openContractLevel = null;

    void ToggleContractLevel(int level)
        => _openContractLevel = _openContractLevel == level ? null : level;

    void OnContractClick(string contractId)
    {
        if (!Game.BuyOrActivateContract(stageId, contractId, out var reason))
            Log(reason ?? "Não foi possível ativar o contrato.", MsgKind.Error);
        else
            Log($"Contrato {contractId} ativado.", MsgKind.Success);
    }

    int SumUsedContracts(ExpeditionModel? expd)
    => expd?.Contracts?.Values?.Sum(c => c.Quant) ?? 0;

    void OnContractBuyMore(string contractId)
    {
        var expd = Game.GetExpedition(stageId);
        int usedBefore = SumUsedContracts(expd);
        int cap = Game.GetContractsCap(stageId);

        // já cheio? só avisa e sai
        if (usedBefore >= cap)
        {
            if (!_capNotified)
            {
                Log($"Cap de contratos atingido ({usedBefore}/{cap}).", MsgKind.Info);
                _capNotified = true;
            }
            return;
        }

        // tenta comprar
        if (Game.BuyOrActivateContract(stageId, contractId, out var reason))
        {
            Log($"+1 em {contractId}.", MsgKind.Success);

            // recalcule depois da compra
            var expdAfter = Game.GetExpedition(stageId);
            int usedAfter = SumUsedContracts(expdAfter);

            if (usedAfter >= cap)   // chegou no limite
            {
                Log($"Já fizemos todos os {usedAfter} Contratos possíveis. Será que conseguimos mais? Apenas {cap} parece tão pouco...", MsgKind.Info);
                _capNotified = true;
            }
            else
            {
                _capNotified = false; // ainda não encheu
            }
        }
        else
        {
            Log(reason ?? "Compra não realizada.", MsgKind.Warn);
        }
    }

    bool IsContractsCapReached()
    {
        var expd = Game.GetExpedition(stageId);
        int used = expd?.Contracts?.Values?.Sum(c => c.Quant) ?? 0;
        int cap = Game.GetContractsCap(stageId);

        return used >= cap;
    }


    void RefreshContracts()
    {
        _contractButtons = ContractsHelper.BuildButtons(Game.Current, stageId);

        // fecha o nível aberto caso ele não exista mais na lista
        if (_openContractLevel is int lvl &&
            !_contractButtons.Any(b => b.Level == lvl))
            _openContractLevel = null;
    }
    #endregion

    #region Especialidades
    void OnSpecialtyClick(string charId)
    {
        if (!Game.ActivateSpecialty(charId, out var reason))
            Log(reason ?? "Não foi possível ativar a especialidade.", MsgKind.Warn);
        else
            Log($"Especialidade ativada por {charId}.", MsgKind.Success);
    }

    #endregion

    #region Expansion
    void OnExpandClick(string expId)
    {
        if (!Game.BuyExpansion(expId, out var reason))
        {
            Log(reason ?? "Não foi possível comprar a expansão.", MsgKind.Warn);
            return;
        }
        Log($"Expansão {expId} concluída.", MsgKind.Success);

        // após o hard reset, refreshe as listas visíveis
        RefreshCoins();
        RefreshResources();
        RefreshChars();
        RefreshTechs();
        RefreshDestinations();
        RefreshUpgrades();
        RefreshContracts();

        // volta para Mensagens (opcional)
        GoToMessages();
    }

    #endregion

    #region Helpers
    void OnGameChanged()
    {
        try
        {
            RefreshCoins();
            RefreshResources();
            RefreshChars();
            RefreshTechs();
            RefreshDestinations();
            RefreshUpgrades();
            RefreshContracts();
            RefreshShopChars();
            if (!ExpeditionActive)
            {
                _topPanel = TopPanel.Base;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[UI] OnGameChanged EXCEPTION: {ex}");
        }
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Game.Changed -= OnGameChanged;
        Game.Logged -= OnLogged;
    }

    private void OnLogged(string msg, LogKind kind)
    {
        _msgs.Add(new UiMessage { Text = msg, Kind = Map(kind), Time = DateTime.Now });
        InvokeAsync(StateHasChanged);
    }
    #endregion

}

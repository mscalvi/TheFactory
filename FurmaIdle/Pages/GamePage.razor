@page "/"

@using System.Linq
@using FurmaIdle.Components;
@using FurmaIdle.Models;
@using FurmaIdle.Data
@using FurmaIdle.Helpers;
@using FurmaIdle.Services;

@inject IJSRuntime JS;

@inject ICreateGameService Start
@inject ICurrentGameService Game
@inject ITooltipService Tooltip
@inject ITickService Ticks
@inject IUnlockService Unlock
@inject IUiService UI

@code {
    #region GameStart
    protected override void OnInitialized()
    {
        //Game.GameChanged += OnGameChanged;
        //Game.Logged += OnLogged;
    }

    protected override async Task OnInitializedAsync()
    {
        var NewGame = await Start.InitAsync();

        // Desbloquear Itens
        await Unlock.UnlockStage("s00");
        await Unlock.UnlockExpansion("x00");

        // Preencher Tela
        UI.CreateScreen();

        // Inicializar Ticks

        StateHasChanged();
    }
    #endregion

    private NavMenu? navRef;
    private string? _navId = "i4";

    private void OnNavSelect(string id)
    {

    }

    #region Gerais
    public void Dispose()
    {
        // Desinscreva eventos aqui
        // Game.GameChanged -= OnGameChanged;
        // Game.Logged -= OnLogged;
    }
    #endregion
}

<div class="game-grid">
    <!-- Navegador -->
    <aside class="nav-menu panel">
        <NavMenu @bind-SelectedId="_navId" />
    </aside>

    <!-- Texto -->
    <section class="text-box panel">text-box</section>

    <!-- Shop -->
    <section class="shop-menu panel">shop-menu</section>

    <!-- Título -->
    <header class="title-box panel">
        <TitleBox />
    </header>

    <!-- Stage/Área -->
    <section class="stage-box-box panel">
        @if (Game.CurrentGame?.Stages?.Count > 0)
        {
            <StageBox />
        }
        else
        {
            <p>Carregando…</p>
        }
    </section>

    <!-- Click -->
        <main class="click-area panel">Click-Area
        </main>

    <!-- Income -->
    <section class="income-box panel">income-box</section>

    <!-- Contratos -->
    <section class="contracts-menu panel">contracts-menu</section>
</div>


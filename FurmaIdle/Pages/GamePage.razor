@page "/"

@using System.Linq
@using FurmaIdle.Components;
@using FurmaIdle.Models;
@using FurmaIdle.Data
@using FurmaIdle.Helpers;
@using FurmaIdle.Services;
@using FurmaIdle.Storage;

@inject IJSRuntime JS;
@implements IDisposable

@inject NavigationManager Nav

@inject IGameStore Store
@inject ICreateGameService Start
@inject ICurrentGameService Game
@inject ITooltipService Tooltip
@inject ITickService Ticks
@inject IUnlockService Unlock
@inject IUiService Ui

@code {
    #region GameStart
    private bool _ready = false;
    public bool NeedsSave { get; set; }

    void OnGameChanged() => InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        // 1. Detecta o reset SÓ neste primeiro render
        var uri = Nav.Uri;
        var reseted = uri.Contains("reset=1", StringComparison.OrdinalIgnoreCase);

        if (reseted)
        {
            await Store.ClearAsync("main");
            Console.WriteLine("[BOOT] Reset solicitado: removido 'main'");
        }

        // 3. Fluxo normal de boot
        await Start.InitAsync();
        Console.WriteLine("[GP] Finalizado Load/Create");

        Game.MarkReady();
        Console.WriteLine("[GP] Jogo marcado como Pronto");

        Ticks.Start();
        Console.WriteLine("[GP] Ticks iniciados");

        Ui.SyncMenusFromGame(Game.CurrentGame);
        RecomputeReady();
        StateHasChanged();

        Console.WriteLine("[GP] Jogo iniciado");

        if (reseted)
        {
            Console.WriteLine("[BOOT] Reset terminado, url limpa");

            Nav.NavigateTo("/", forceLoad: false);
        }
    }

    protected override void OnInitialized()
    {
        Ui.BusyChanged += OnBusyChanged;
        Game.GameChanged += OnGameChanged;
        Ticks.RunningChanged += OnSignalsChanged;
    }

    private void OnSignalsChanged()
    {
        RecomputeReady();
        InvokeAsync(StateHasChanged);
    }

    private void RecomputeReady()
        => _ready = Game.IsReady && Ticks.IsRunning;
    #endregion

    #region Gerais
    public void RecomputeGame()
    {
        StateHasChanged();
        RecomputeReady();
        if (_ready)
        {
            Console.WriteLine("[GP] O jogo está funcionando");
        } 
        else
        {
            Console.WriteLine("[GP] O jogo não está funcionando");
        }
    }

    private void OnBusyChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Ui.BusyChanged -= OnBusyChanged;
        _ = Ticks.StopAsync();
        Game.GameChanged -= OnGameChanged;
    }
    #endregion
}

@if (!_ready)
{
    <div class="app-loading-screen">
        <div class="app-loading-card">
            <div class="app-loading-title">Exploradores de Furma</div>
            <div class="app-loading-subtitle">Carregando anotações da Guilda...</div>
            <div class="app-loading-spinner"></div>
        </div>
    </div>
}
else
{
    if (Ui.IsBusy)
    {
        <div class="app-loading-screen">
            <div class="app-loading-card">
                <div class="app-loading-title">Exploradores de Furma</div>
                <div class="app-loading-subtitle">@Ui.BusyMessage</div>
                <div class="app-loading-spinner"></div>
            </div>
        </div>
    }
    else
    {
        <div class="game-grid">
            <!-- Navegador -->
            <aside class="nav-menu">
                <NavMenu />
            </aside>

            <section class="text-box">
                <TextMenu />
            </section>

            <!-- Shop -->
            <section class="shop-menu">
                <ShopMenu />
            </section>

            <!-- Título -->
            <header class="title-box">
                <TitleBox />
            </header>

            <!-- Stage/Área -->
            <section class="stage-box">
                <StageBox />
            </section>

            <!-- Click -->
            <main class="click-area">
                <ClickArea />
            </main>

            <!-- Income -->
            <section class="income-box">
                <IncomeBox />
            </section>

            <!-- Contratos -->
            <section class="contracts-menu">
                <ContractsMenu />
            </section>

        </div>
        
    }
}

